{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runner-protocol-rollback@v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lineage_commit", "targets"],
  "properties": {
    "schema": {"const": "runner-protocol-rollback@v1"},
    "lineage_commit": {"const": "46fdd63983"},
    "targets": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "base64"],
        "properties": {
          "path": {"enum": ["agent-workflow.json", "issues/_policy/runner-service.json"]},
          "sha256": {"pattern": "^sha256:[0-9a-f]{64}$"},
          "base64": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
