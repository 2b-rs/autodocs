{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-capability-descriptor@v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "descriptor_id",
    "agent_id",
    "process_roles",
    "capability_class",
    "execution_routes",
    "rights",
    "data_handles",
    "tools",
    "token_budget_class",
    "context_budget_class",
    "cognitive_classes_served",
    "assurances",
    "capacity_status",
    "snapshot_reference"
  ],
  "properties": {
    "schema": { "const": "agent-capability-descriptor@v1" },
    "descriptor_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "process_roles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "capability_class": { "enum": ["sandboxed-grunt", "unprivileged", "privileged"] },
    "execution_routes": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["none", "runner", "direct"] },
      "uniqueItems": true
    },
    "rights": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "data_handles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "token_budget_class": { "enum": ["small", "medium", "large", "very-large"] },
    "context_budget_class": { "enum": ["small", "medium", "large", "very-large"] },
    "cognitive_classes_served": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["low", "medium", "high", "critical"] },
      "uniqueItems": true
    },
    "assurances": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "capacity_status": { "enum": ["available", "unavailable", "unknown"] },
    "snapshot_reference": { "type": "string", "minLength": 1 }
  }
}
