{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-match-result@v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "matcher_version",
    "profile_id",
    "profile_sha256",
    "descriptor_sha256",
    "status",
    "eligible_agent_ids",
    "rejections",
    "non_authority_notice"
  ],
  "properties": {
    "schema": { "const": "capability-match-result@v1" },
    "matcher_version": { "const": "capability-match@v1" },
    "profile_id": { "type": "string" },
    "profile_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "descriptor_sha256": { "type": "array" },
    "status": { "enum": ["single-eligible", "multiple-eligible", "none-eligible", "invalid-input"] },
    "eligible_agent_ids": { "type": "array", "items": { "type": "string" } },
    "rejections": { "type": "array" },
    "non_authority_notice": { "type": "string" }
  }
}
