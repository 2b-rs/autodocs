{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"agent-workflow-bootstrap@v1","type":"object","additionalProperties":false,"required":["schema","workflow_version","authority_epoch","authority_profile","write_phase","required_capability","runner_protocol","selector_digest","instruction_bundle"],"properties":{"schema":{"const":"agent-workflow-bootstrap@v1"},"workflow_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"authority_epoch":{"enum":["legacy-writable","legacy-frozen","issue-store-writable","issue-store-write-frozen","legacy-restored"]},"authority_profile":{"enum":["legacy-lists","issue-store"]},"write_phase":{"enum":["legacy-writable","frozen","issue-store-writable","write-frozen","legacy-restored"]},"required_capability":{"enum":["sandboxed-grunt","privileged"]},"runner_protocol":{"const":"runner-request@v1"},"selector_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"instruction_bundle":{"type":"string","pattern":"^docs/pipeline/agent-instructions/(legacy|current|future)/index\\.md$"}},"allOf":[{"if":{"properties":{"authority_profile":{"const":"legacy-lists"}}},"then":{"properties":{"authority_epoch":{"enum":["legacy-writable","legacy-frozen","legacy-restored"]}}}},{"if":{"properties":{"authority_profile":{"const":"issue-store"}}},"then":{"properties":{"authority_epoch":{"enum":["issue-store-writable","issue-store-write-frozen"]}}}}]}
