{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-requirement-profile@v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "task_id",
    "process_role",
    "capability_class",
    "execution_needs",
    "required_rights",
    "required_data_handles",
    "required_tools",
    "token_budget_class",
    "context_budget_class",
    "cognitive_demand",
    "required_assurances",
    "sources",
    "test_scope",
    "resource_bounds"
  ],
  "properties": {
    "schema": { "const": "task-requirement-profile@v1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(\\.[0-9]{2})?$" },
    "process_role": { "type": "string", "minLength": 1 },
    "capability_class": { "enum": ["sandboxed-grunt", "unprivileged", "privileged"] },
    "execution_needs": { "enum": ["none", "runner", "direct"] },
    "required_rights": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "required_data_handles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "required_tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "token_budget_class": { "enum": ["small", "medium", "large", "very-large"] },
    "context_budget_class": { "enum": ["small", "medium", "large", "very-large"] },
    "cognitive_demand": { "enum": ["low", "medium", "high", "critical"] },
    "required_assurances": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "derivation"],
        "properties": {
          "kind": { "enum": ["requirement", "decision", "architecture", "evidence", "assumption"] },
          "reference": { "type": "string", "minLength": 1 },
          "derivation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "test_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "derived_from", "command", "expected_evidence"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "derived_from": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "command": { "type": "string", "minLength": 1 },
        "expected_evidence": { "type": "string", "minLength": 1 }
      }
    },
    "resource_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cpu_seconds", "max_wall_seconds", "max_memory_mib", "expected_token_range"],
      "properties": {
        "max_cpu_seconds": { "type": "integer", "minimum": 0 },
        "max_wall_seconds": { "type": "integer", "minimum": 0 },
        "max_memory_mib": { "type": "integer", "minimum": 0 },
        "expected_token_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "capability_class": { "const": "sandboxed-grunt" } },
        "required": ["capability_class"]
      },
      "then": {
        "properties": { "execution_needs": { "enum": ["none", "runner"] } }
      }
    },
    {
      "if": {
        "properties": { "capability_class": { "enum": ["unprivileged", "privileged"] } },
        "required": ["capability_class"]
      },
      "then": {
        "properties": { "execution_needs": { "enum": ["none", "direct"] } }
      }
    },
    {
      "if": {
        "properties": { "process_role": { "const": "Integrator" } },
        "required": ["process_role"]
      },
      "then": {
        "properties": {
          "capability_class": { "const": "privileged" },
          "required_rights": {
            "allOf": [
              { "contains": { "const": "acceptance.review" } },
              { "contains": { "const": "integration.checkpoint" } }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "required_rights": { "contains": { "const": "acceptance.review" } }
        }
      },
      "then": { "properties": { "capability_class": { "const": "privileged" } } }
    },
    {
      "if": {
        "properties": {
          "required_rights": { "contains": { "const": "integration.checkpoint" } }
        }
      },
      "then": { "properties": { "capability_class": { "const": "privileged" } } }
    },
    {
      "if": {
        "properties": {
          "required_rights": { "contains": { "const": "feature.close" } }
        }
      },
      "then": { "properties": { "capability_class": { "const": "privileged" } } }
    }
  ]
}
