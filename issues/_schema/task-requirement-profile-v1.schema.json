{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-requirement-profile@v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "task_id",
    "process_role",
    "capability_class",
    "execution_needs",
    "required_rights",
    "required_data_handles",
    "required_tools",
    "token_budget_class",
    "context_budget_class",
    "cognitive_demand",
    "required_assurances",
    "sources",
    "test_scope",
    "resource_bounds"
  ],
  "properties": {
    "schema": { "const": "task-requirement-profile@v1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(\\.[0-9]{2})?$" },
    "process_role": { "type": "string", "minLength": 1 },
    "capability_class": { "enum": ["sandboxed-grunt", "unprivileged", "privileged"] },
    "execution_needs": { "enum": ["none", "runner", "direct"] },
    "required_rights": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "required_data_handles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "required_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "token_budget_class": { "enum": ["small", "medium", "large", "very-large"] },
    "context_budget_class": { "enum": ["small", "medium", "large", "very-large"] },
    "cognitive_demand": { "enum": ["low", "medium", "high", "critical"] },
    "required_assurances": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "sources": { "type": "array", "minItems": 1 },
    "test_scope": { "type": "object", "additionalProperties": false },
    "resource_bounds": { "type": "object", "additionalProperties": false }
  }
}
