{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internal/issues/_schema/issue-closure-v1.schema.json",
  "title": "issue-closure@v1",
  "description": "Immutable terminal closure record. Repository-level validation additionally verifies commit reachability and evidence locators.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "item_id", "disposition", "closed_at", "closed_by", "criteria", "commit_refs", "validation"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "item_id": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(\\.[0-9]{2})?)?$"},
    "disposition": {"type": "string", "enum": ["completed", "wontfix", "superseded", "duplicate", "cancelled", "archived-not-accepted"]},
    "closed_at": {"type": "string", "format": "date-time"},
    "closed_by": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-[0-9]{3,}$"},
          "status": {"type": "string", "enum": ["checked", "not-applicable", "withdrawn"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "commit_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "uniqueItems": true},
    "validation": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "result"], "properties": {"name": {"type": "string", "minLength": 1}, "result": {"type": "string", "enum": ["pass", "fail", "not-applicable"]}, "evidence": {"type": "string"}}}
    },
    "reason": {"type": "string", "minLength": 1},
    "decision_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "successor_item": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(\\.[0-9]{2})?)?$"}
  },
  "allOf": [
    {"if": {"properties": {"disposition": {"const": "wontfix"}}}, "then": {"required": ["reason"]}},
    {"if": {"properties": {"disposition": {"enum": ["superseded", "duplicate"]}}}, "then": {"required": ["decision_ref", "successor_item"]}},
    {"if": {"properties": {"disposition": {"enum": ["cancelled", "archived-not-accepted"]}}}, "then": {"required": ["reason", "decision_ref"]}}
  ]
}
