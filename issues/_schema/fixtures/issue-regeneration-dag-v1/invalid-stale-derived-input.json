{
  "schema": "issue-regeneration-dag@v1",
  "generation_id_rule": "sha256 over declared canonical input, schema, tool, and configuration digests; UUIDv7 belongs only in an external execution-run manifest.",
  "stages": [
    {
      "id": "validate-canonical",
      "argv": [
        "python3",
        "_src/tools/issuectl.py",
        "validate",
        "--canonical"
      ],
      "depends_on": [],
      "inputs": [
        {
          "glob": "issues/**/*.md",
          "kind": "canonical"
        },
        {
          "glob": "provenance/**/*.json",
          "kind": "canonical"
        },
        {
          "glob": "SANDBOX.md",
          "kind": "configuration"
        },
        {
          "glob": "AGENTS.md",
          "kind": "configuration"
        },
        {
          "glob": "PRIVILEGED.md",
          "kind": "configuration"
        },
        {
          "glob": "agent-workflow.json",
          "kind": "configuration"
        },
        {
          "glob": "data/missing-derived.json",
          "kind": "derived"
        }
      ],
      "outputs": [
        "output/issue-validation.json"
      ],
      "sole_writer": "validate-canonical",
      "required": true,
      "retention": "ephemeral",
      "privacy": "internal",
      "determinism": "semantic",
      "promotion_group": null,
      "cleanup": "replace run-local output only",
      "validator": "issuectl validate canonical"
    },
    {
      "id": "build-internal-catalog",
      "argv": [
        "python3",
        "_src/tools/issuectl.py",
        "render",
        "--catalog",
        "internal"
      ],
      "depends_on": [
        "validate-canonical"
      ],
      "inputs": [
        {
          "glob": "issues/**/*.md",
          "kind": "canonical"
        },
        {
          "glob": "provenance/**/*.json",
          "kind": "canonical"
        }
      ],
      "outputs": [
        "data/issue-catalog.internal.json"
      ],
      "sole_writer": "build-internal-catalog",
      "required": true,
      "retention": "committed",
      "privacy": "internal",
      "determinism": "byte",
      "promotion_group": "issue-publication",
      "cleanup": "atomic replace after validation",
      "validator": "schema and canonical digest check"
    },
    {
      "id": "build-public-projection",
      "argv": [
        "python3",
        "_src/tools/issuectl.py",
        "render",
        "--catalog",
        "public"
      ],
      "depends_on": [
        "build-internal-catalog"
      ],
      "inputs": [
        {
          "glob": "data/issue-catalog.internal.json",
          "kind": "derived"
        }
      ],
      "outputs": [
        "data/issue-catalog.public.json"
      ],
      "sole_writer": "build-public-projection",
      "required": true,
      "retention": "committed",
      "privacy": "public",
      "determinism": "byte",
      "promotion_group": "issue-publication",
      "cleanup": "omit restricted fields then atomic replace",
      "validator": "privacy projection validation"
    },
    {
      "id": "build-graphs",
      "argv": [
        "python3",
        "_src/tools/issuectl.py",
        "render",
        "--graphs"
      ],
      "depends_on": [
        "build-internal-catalog"
      ],
      "inputs": [
        {
          "glob": "data/issue-catalog.internal.json",
          "kind": "derived"
        }
      ],
      "outputs": [
        "data/issue-graph.json",
        "output/issue-graph.dot",
        "output/issue-graph.svg"
      ],
      "sole_writer": "build-graphs",
      "required": true,
      "retention": "committed",
      "privacy": "internal",
      "determinism": "semantic",
      "promotion_group": "issue-publication",
      "cleanup": "replace complete graph set atomically",
      "validator": "graph acyclicity and render validation"
    },
    {
      "id": "build-page-models",
      "argv": [
        "python3",
        "_src/tools/issuectl.py",
        "render",
        "--page-models"
      ],
      "depends_on": [
        "build-public-projection",
        "build-graphs"
      ],
      "inputs": [
        {
          "glob": "data/issue-catalog.public.json",
          "kind": "derived"
        },
        {
          "glob": "data/issue-graph.json",
          "kind": "derived"
        }
      ],
      "outputs": [
        "data/issue-pages.json",
        "data/issue-i18n-register.json"
      ],
      "sole_writer": "build-page-models",
      "required": true,
      "retention": "committed",
      "privacy": "public",
      "determinism": "byte",
      "promotion_group": "issue-publication",
      "cleanup": "atomic replace after schema validation",
      "validator": "page-model and i18n-register validation"
    },
    {
      "id": "render-html",
      "argv": [
        "python3",
        "_src/tools/generate.py",
        "--issues"
      ],
      "depends_on": [
        "build-page-models"
      ],
      "inputs": [
        {
          "glob": "data/issue-pages.json",
          "kind": "derived"
        },
        {
          "glob": "data/issue-i18n-register.json",
          "kind": "derived"
        }
      ],
      "outputs": [
        "en/issues/index.html",
        "de/issues/index.html",
        "fr/issues/index.html",
        "es/issues/index.html",
        "pt/issues/index.html",
        "ar/issues/index.html",
        "zh/issues/index.html"
      ],
      "sole_writer": "render-html",
      "required": true,
      "retention": "committed",
      "privacy": "public",
      "determinism": "semantic",
      "promotion_group": "issue-publication",
      "cleanup": "replace complete localized tree atomically",
      "validator": "client-rendered validation"
    },
    {
      "id": "render-reports",
      "argv": [
        "python3",
        "_src/tools/issuectl.py",
        "report"
      ],
      "depends_on": [
        "validate-canonical",
        "build-graphs"
      ],
      "inputs": [
        {
          "glob": "output/issue-validation.json",
          "kind": "derived"
        },
        {
          "glob": "data/issue-graph.json",
          "kind": "derived"
        }
      ],
      "outputs": [
        "output/issue-report.json",
        "output/issue-report.html"
      ],
      "sole_writer": "render-reports",
      "required": true,
      "retention": "ephemeral",
      "privacy": "internal",
      "determinism": "semantic",
      "promotion_group": null,
      "cleanup": "replace run-local report set; reports never feed stages",
      "validator": "report input freshness check"
    }
  ]
}
