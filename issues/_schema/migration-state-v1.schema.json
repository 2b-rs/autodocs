{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internal/issues/_schema/migration-state-v1.schema.json",
  "title": "migration-state@v1",
  "description": "Immutable legacy-source watermark and disposable shadow-import state. Schema validation is supplemented by the semantic rules in issue-migration-shadow-import.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "source", "importer", "watermarks", "candidate", "status"],
  "properties": {
    "schema": {"const": "migration-state@v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "source": {"$ref": "#/$defs/source"},
    "importer": {"$ref": "#/$defs/importer"},
    "watermarks": {"$ref": "#/$defs/watermarks"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "status": {"enum": ["created", "imported", "validated", "rejected", "interrupted", "promoted"]},
    "phase": {"enum": ["prepared", "compared", "rejected", "interrupted", "promoted"]},
    "counts": {"$ref": "#/$defs/counts"},
    "finding_summary": {"$ref": "#/$defs/finding_summary"},
    "history": {"$ref": "#/$defs/history"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "tree_digest", "files", "working_tree_clean"], "properties": {"commit": {"$ref": "#/$defs/commit"}, "tree": {"$ref": "#/$defs/commit"}, "tree_digest": {"$ref": "#/$defs/sha256"}, "files": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["TODO.md", "DONE.md", "claim-blobs"]}}, "working_tree_clean": {"type": "boolean"}}},
    "importer": {"type": "object", "additionalProperties": false, "required": ["commit", "digest", "schema_versions"], "properties": {"commit": {"$ref": "#/$defs/commit"}, "digest": {"$ref": "#/$defs/sha256"}, "schema_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}, "schema_digests": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}}}},
    "watermarks": {"type": "object", "additionalProperties": false, "required": ["baseline", "latest_source", "candidate"], "properties": {"baseline": {"$ref": "#/$defs/commit"}, "latest_source": {"$ref": "#/$defs/commit"}, "candidate": {"$ref": "#/$defs/commit"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["root", "issues_root", "reports_root", "tree", "tree_digest", "promotable"], "properties": {"root": {"type": "string", "pattern": "^_src/output/issue-migration/[a-z0-9][a-z0-9-]{7,63}/$"}, "issues_root": {"type": "string", "pattern": "^_src/output/issue-migration/[a-z0-9][a-z0-9-]{7,63}/issues/$"}, "reports_root": {"type": "string", "pattern": "^_src/output/issue-migration/[a-z0-9][a-z0-9-]{7,63}/reports/$"}, "tree": {"$ref": "#/$defs/commit"}, "identity": {"$ref": "#/$defs/sha256"}, "tree_digest": {"$ref": "#/$defs/sha256"}, "promotable": {"type": "boolean"}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["items", "closures", "written", "findings"], "properties": {"items": {"type": "integer", "minimum": 0}, "closures": {"type": "integer", "minimum": 0}, "written": {"type": "integer", "minimum": 0}, "findings": {"type": "integer", "minimum": 0}}},
    "finding_summary": {"type": "object", "additionalProperties": false, "required": ["info", "warning", "error", "blocking", "total"], "properties": {"info": {"type": "integer", "minimum": 0}, "warning": {"type": "integer", "minimum": 0}, "error": {"type": "integer", "minimum": 0}, "blocking": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}},
    "history": {"type": "object", "additionalProperties": false, "required": ["sequence", "previous_run_id", "previous_source_commit", "previous_state_digest"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "previous_run_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"}, "previous_source_commit": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]}, "previous_state_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["code", "severity", "message"], "properties": {"code": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "severity": {"enum": ["info", "warning", "error", "blocking"]}, "message": {"type": "string", "minLength": 1}}}
  }
}
