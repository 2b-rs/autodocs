{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internal/issues/_schema/issue-decision-v1.schema.json",
  "title": "issue-decision@v1",
  "description": "Immutable decision record for lifecycle escalations, authority actions, scope, approval, supersession, duplicate, cancellation, and archival outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "item_id", "kind", "status", "decided_at", "authority", "rationale"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "decision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "item_id": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(\\.[0-9]{2})?)?$"},
    "kind": {"type": "string", "enum": ["escalation", "approval", "scope", "architecture", "supersession", "duplicate", "cancellation", "archival", "handoff"]},
    "status": {"type": "string", "enum": ["proposed", "approved", "rejected", "recorded"]},
    "decided_at": {"type": "string", "format": "date-time"},
    "authority": {"type": "object", "additionalProperties": false, "required": ["kind", "identity"], "properties": {"kind": {"type": "string", "enum": ["human", "reviewer", "maintainer", "service"]}, "identity": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}}},
    "question": {"type": "string", "minLength": 1},
    "options": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "summary"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "summary": {"type": "string", "minLength": 1}, "consequences": {"type": "string"}}}},
    "selected_option": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "rationale": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "successor_item": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(\\.[0-9]{2})?)?$"},
    "related_decision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "escalation"}}}, "then": {"required": ["question", "options", "selected_option"]}},
    {"if": {"properties": {"kind": {"enum": ["supersession", "duplicate"]}}}, "then": {"required": ["successor_item"]}},
    {"if": {"properties": {"kind": {"const": "archival"}}}, "then": {"required": ["question"]}}
  ]
}
