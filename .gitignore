.DS_Store

# Generated runtime artifacts
output/
*.log
*.out

# Office lock files (LibreOffice/Word leave these next to open documents)
~$*

# Temporary runner scripts
run-*.sh
!runner-host/run-loop.sh
node_modules/
_src/spec/pdf-cache/
run.sh
fs-test-manual.sh

# Task 0037-46.01 runner queue/dispatcher runtime root — never tracked.
# Drafts, published requests, leases, results, logs, and cancellation flags
# under .runner/ are runtime state, not source; the dispatcher itself lives
# under _src/tools/ and _src/runner/ (tracked).
.runner/

# Python-Bytecode (nie einchecken)
__pycache__/
*.pyc
.venv-qa/
