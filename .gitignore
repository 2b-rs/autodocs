.DS_Store

# Generated runtime artifacts
output/
*.log
*.out

# Office lock files (LibreOffice/Word leave these next to open documents)
~$*

# Temporary runner scripts
run-*.sh
!runner-host/run-loop.sh
node_modules/
_src/spec/pdf-cache/
run.sh
fs-test-manual.sh

# Task 0037-46.01 runner queue/dispatcher runtime root — never tracked.
# Drafts, published requests, leases, results, logs, and cancellation flags
# under .runner/ are runtime state, not source; the dispatcher itself lives
# under _src/tools/ and _src/runner/ (tracked).
.runner/

# Python-Bytecode (nie einchecken)
__pycache__/
*.pyc
.venv-qa/

# Runtime receipts of the local demonstration server (_src/serve.py).
# Canonical spec records, curation-queue, and published HTML stay untouched.
_src/spec/feedback-queue/

# SSH commit signing
allowed_signers

# Static version records for Provenienz-Browser (generated on build / CI)
versions/data/

# Internal issue store, planning, and agent task files (never push to remote)
issues/
TODO-*
DONE-*
tools/todo-graph*
tools/backlog-evolution*
docs/pipeline/issue-derived-artifacts-v1.json

