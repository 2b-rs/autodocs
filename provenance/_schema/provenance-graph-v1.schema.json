{
  "$id": "https://internal/provenance/_schema/provenance-graph-v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema",
    "authority",
    "events",
    "nodes",
    "edges",
    "findings",
    "digests",
    "generation_id"
  ],
  "properties": {
    "schema": {"const": "provenance-graph@v1"},
    "authority": {"const": "generated-view"},
    "events": {"type": "array"},
    "nodes": {"type": "array"},
    "edges": {"type": "array"},
    "findings": {"type": "array"},
    "digests": {"type": "object"},
    "generation_id": {"type": "string"}
  }
}
