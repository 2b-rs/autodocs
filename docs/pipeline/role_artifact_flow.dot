digraph ArtifactFlowPipeline {
    // Switch to Sugiyama layer-based layout to cleanly route & eliminate crossings organically
    layout=dot;
    rankdir=LR;
    splines=true;
    
    // Generous, uniform spacing enforcing the 'gleichmäßige Längenspektrum' in horizontal axis
    nodesep=0.6;
    ranksep=1.5;
    
    node [shape=none, fontname="Helvetica Neue,Helvetica,Arial,sans-serif"];
    edge [fontname="Helvetica Neue,Helvetica,Arial,sans-serif"];

    ReqEng [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td><font point-size="48">👤</font></td><td bgcolor="#dae8fc" border="2" color="#6c8ebf" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Requirements<br/>Engineer</b></font></td></tr></table>>];
    Arch [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td><font point-size="48">👤</font></td><td bgcolor="#dae8fc" border="2" color="#6c8ebf" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Architect</b></font></td></tr></table>>];
    Prog [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td><font point-size="48">👤</font></td><td bgcolor="#dae8fc" border="2" color="#6c8ebf" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Programmer</b></font></td></tr></table>>];
    Test [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td><font point-size="48">👤</font></td><td bgcolor="#dae8fc" border="2" color="#6c8ebf" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Tester</b></font></td></tr></table>>];
    Int [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td><font point-size="48">👤</font></td><td bgcolor="#dae8fc" border="2" color="#6c8ebf" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Integrator</b></font></td></tr></table>>];
    QAM [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td><font point-size="48">👤</font></td><td bgcolor="#dae8fc" border="2" color="#6c8ebf" style="ROUNDED" cellpadding="16"><font point-size="32"><b>QA-Manager</b></font></td></tr></table>>];
    PL [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td><font point-size="48">👤</font></td><td bgcolor="#dae8fc" border="2" color="#6c8ebf" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Project Lead</b></font></td></tr></table>>];
    Disp [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td><font point-size="48">👤</font></td><td bgcolor="#dae8fc" border="2" color="#6c8ebf" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Dispatcher</b></font></td></tr></table>>];
    Sec [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td><font point-size="48">👤</font></td><td bgcolor="#dae8fc" border="2" color="#6c8ebf" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Security<br/>Engineer</b></font></td></tr></table>>];
    Opt [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td><font point-size="48">👤</font></td><td bgcolor="#dae8fc" border="2" color="#6c8ebf" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Process<br/>Optimizer</b></font></td></tr></table>>];
    Run [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td><font point-size="48">🤖</font></td><td bgcolor="#dae8fc" border="2" color="#6c8ebf" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Runner</b></font></td></tr></table>>];
    // Docs
    REQ [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Requirements<br/>(REQ-...)</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    DEC [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Decision Records<br/>(DEC-...)</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    TASKS [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Task Breakdown<br/>(TASK-...)</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    CODE [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Implementation Code<br/>(Feature Branch)</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    UNIT [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Unit Test Evidence</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    TEST [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Independent Test Evidence</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    VERDICT [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Integration Checkpoint<br/>&amp; Verdict</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    MERGE [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Integrated Baseline<br/>(main)</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    ESC [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Human Decision Req.<br/>(DECISION NEEDED)</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    QA [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>QA Process<br/>Deviation Report</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    SEC [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Threat Model &amp;<br/>Abuse Test Findings</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    OPT [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Optimization Metrics<br/>&amp; Evidence</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];
    ART [label=<<table border="0" cellborder="0" cellspacing="12"><tr><td bgcolor="#fff2cc" border="2" color="#d6b656" style="ROUNDED" cellpadding="16"><font point-size="32"><b>Sandboxed Artifact Output</b></font></td><td><font point-size="48">📄</font></td></tr></table>>];

    // Edges: Production (Role -> Artifact) 
    // They push the pipeline left-to-right
    edge [color="#2b78e4", style="solid", penwidth=4.0, arrowhead="normal"]; 
    ReqEng -> REQ;
    Arch -> DEC;
    Arch -> TASKS;
    Prog -> CODE;
    Prog -> UNIT;
    Test -> TEST;
    Int -> VERDICT;
    Int -> MERGE;
    PL -> ESC;
    QAM -> QA;
    Sec -> SEC;
    Opt -> OPT;
    Run -> ART;

    // Edges: Consumption (Artifact -> Role)
    // In 'dot', these will flow left-to-right natively, weaving the nodes into alternating layers.
    edge [color="#888888", style="dashed", penwidth=3.0, arrowhead="open"]; 
    REQ -> Arch;
    REQ -> Test;
    DEC -> Prog;
    DEC -> Test;
    DEC -> Sec;
    TASKS -> Disp;
    TASKS -> PL;
    CODE -> Int;
    UNIT -> Int;
    UNIT -> QAM;
    TEST -> Int;
    TEST -> QAM;
    TEST -> PL;
    VERDICT -> PL;
    VERDICT -> Disp;
    MERGE -> Arch;
    MERGE -> QAM;
    MERGE -> Opt;
    ESC -> ReqEng;
    ESC -> Arch;
    ESC -> QAM;
    QA -> PL;
    QA -> Opt;
    SEC -> PL;
    SEC -> Arch;
    OPT -> PL;
    OPT -> QAM;
    ART -> Prog;
    ART -> Test;
}
