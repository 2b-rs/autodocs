{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodocs.local/schemas/worktree-topology-plan.schema.json",
  "title": "Worktree Topology Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization_version",
    "digest_algorithm",
    "content_digest",
    "feature_id",
    "baseline_ref",
    "topology_revision",
    "architect_identity",
    "authority_ref",
    "created_at",
    "status",
    "supersedes",
    "nodes",
    "edges",
    "overlap_rules",
    "checkpoints",
    "validation_profile",
    "staleness_policy",
    "activation",
    "recovery"
  ],
  "properties": {
    "schema_version": { "const": "worktree-topology-plan@v1" },
    "canonicalization_version": { "const": "json-sort-utf8-no-floats@v1" },
    "digest_algorithm": { "const": "sha256" },
    "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "feature_id": { "type": "string", "pattern": "^[0-9]{4}$" },
    "baseline_ref": { "$ref": "#/$defs/gitRef" },
    "topology_revision": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "architect_identity": { "$ref": "#/$defs/identity" },
    "authority_ref": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["candidate", "trial", "active", "superseded", "withdrawn"] },
    "supersedes": {
      "oneOf": [
        { "const": "none" },
        { "$ref": "#/$defs/planIdentity" }
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "overlap_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/overlap" }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "validation_profile": { "$ref": "#/$defs/validationProfile" },
    "staleness_policy": { "$ref": "#/$defs/staleness" },
    "activation": { "$ref": "#/$defs/activation" },
    "recovery": { "$ref": "#/$defs/recovery" }
  },
  "$defs": {
    "gitRef": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "identity": {
      "type": "string",
      "pattern": "^(agent|authority):[A-Za-z0-9][A-Za-z0-9._-]*(?::[A-Za-z0-9][A-Za-z0-9._-]*){1,}$"
    },
    "workUnit": { "type": "string", "pattern": "^(feature|task|subtask):[0-9]{4}(?:-[0-9]{2}(?:\\.[0-9]{2})?)?$" },
    "pathRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "path"],
      "properties": {
        "match": { "enum": ["exact", "prefix"] },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit", "required_state", "compatibility_ref"],
      "properties": {
        "work_unit": { "$ref": "#/$defs/workUnit" },
        "required_state": { "enum": ["implementation-terminal", "current-acceptance"] },
        "compatibility_ref": {
          "oneOf": [{ "const": "none" }, { "$ref": "#/$defs/gitRef" }]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id", "work_unit", "branch", "base_branch", "worktree_path",
        "owner_role", "capability_class", "write_scope", "read_scope",
        "predecessor_constraints", "concurrency_group", "phase", "provisioner",
        "lifecycle", "recovery_reference", "is_main_worktree"
      ],
      "properties": {
        "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "work_unit": { "$ref": "#/$defs/workUnit" },
        "branch": { "type": "string", "minLength": 1 },
        "base_branch": { "type": "string", "minLength": 1 },
        "worktree_path": { "type": "string", "pattern": "^/" },
        "owner_role": { "type": "string", "minLength": 1 },
        "capability_class": { "enum": ["sandboxed-grunt", "unprivileged", "privileged"] },
        "write_scope": { "type": "array", "items": { "$ref": "#/$defs/pathRule" } },
        "read_scope": { "type": "array", "items": { "$ref": "#/$defs/pathRule" } },
        "predecessor_constraints": { "type": "array", "items": { "$ref": "#/$defs/predecessor" } },
        "concurrency_group": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "provisioner": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["planned", "active", "released", "retained"] },
        "recovery_reference": { "type": "string", "minLength": 1 },
        "is_main_worktree": { "type": "boolean" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "condition", "evidence_required"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["base", "prerequisite-content", "claim-carry", "review", "integration-target"] },
        "condition": { "type": "string", "minLength": 1 },
        "evidence_required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "overlap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "class", "paths", "order", "authority", "evidence_required"],
      "properties": {
        "left": { "type": "string", "minLength": 1 },
        "right": { "type": "string", "minLength": 1 },
        "class": { "enum": ["concurrent-exclusive", "ordered-predecessor", "claim-carry", "reconciliation"] },
        "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pathRule" } },
        "order": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "evidence_required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit", "mandatory", "rationale", "acceptance_closure_algorithm"],
      "properties": {
        "work_unit": { "$ref": "#/$defs/workUnit" },
        "mandatory": { "const": true },
        "rationale": { "type": "string", "minLength": 1 },
        "acceptance_closure_algorithm": { "type": "string", "minLength": 1 }
      }
    },
    "validationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "required_stages", "failure_policy"],
      "properties": {
        "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "profile_version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "required_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "failure_policy": { "const": "fail-closed" }
      }
    },
    "staleness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking_structural_fields", "refreshable_operational_inputs", "invalid_conditions"],
      "properties": {
        "blocking_structural_fields": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/" } },
        "refreshable_operational_inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "invalid_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "affected_gates", "self_application_feature", "migration_required", "grandfathering"],
      "properties": {
        "mode": { "enum": ["dormant", "trial", "active"] },
        "affected_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "self_application_feature": { "type": "string", "pattern": "^[0-9]{4}$" },
        "migration_required": { "type": "boolean" },
        "grandfathering": { "const": "forbidden" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_condition", "last_valid_plan", "restore_authority", "preserve"],
      "properties": {
        "stop_condition": { "type": "string", "minLength": 1 },
        "last_valid_plan": { "type": "string", "minLength": 1 },
        "restore_authority": { "type": "string", "minLength": 1 },
        "preserve": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "planIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "compatibility"],
      "properties": {
        "ref": { "$ref": "#/$defs/gitRef" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "compatibility": { "enum": ["compatible", "incompatible"] }
      }
    }
  }
}
