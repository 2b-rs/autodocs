{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_ASR_00011","versions":[{"version_id":"AUTOSAR/CP/record/TPS_ASR_00011@rel:R19-11#6622ece2","canonical_id":"AUTOSAR/CP/record/TPS_ASR_00011","release":"R19-11","content":"AUTOSAR XML Namespace The AUTOSAR XML namespace for all AUTOSAR XML elements and attributes is http://autosar.org/schema/r<major>.<minor>. The namespace is kept across multiple releases of the AUTOSAR XML Schema as long as backward compatibility is kept. <major> and <minor> are the major and minor version numbers of the AUTOSAR release that starts a sequence of backwards compatible AUTOSAR XML Schema.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_ARXMLSerializationRules.pdf"},"recorded_at":"2026-10-01T10:12:23+00:00","text_key":"bfc6fa7347cb"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_ASR_00011","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"ASR","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-2ebf5dac312ac081","doc":"AUTOSAR_TPS_ARXMLSerializationRules","p":13,"rel":[],"role":"heuristic","conf":0.8,"rt":"ARCHITECTURAL_CONTEXT","m":"gemini-3.8-flash","why":"Illustrates schema releases and versioning.","n":2,"cap":"Figure 2.1: Releases of AUTOSAR standards that are contained in the AUTOSAR XML Schema","sha":"2ebf5dac312ac0817124156426b3c0df9a75393c51ef823e09a227c8238eef3c","nser":2,"src":"figure"},{"id":"FIG-38186d45f7b846a5","doc":"AUTOSAR_CP_TR_ReleaseOverview","p":10,"rel":[],"role":"heuristic","conf":0.75