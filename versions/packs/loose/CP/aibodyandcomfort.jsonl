{"id":"SNIP_CLASSIC_AIBODYANDCOMFORT_SECTION_4_6_11_Headlamp_Leveling_Manager","kind":"snippet","module":"aibodyandcomfort","cluster":null,"platform":"CP","doc":"AIBodyAndComfort","page":54,"releases":["4.3.1","R19-11","R20-11","R21-11","R22-11"],"text_release":"R22-11","sha256":"20878361b6fb830f383158fb2734af76be410d57d3692317c4020ef6a6b5047a","rv":[{"r":"4.3.1","t":0,"m":"section","p":54},{"r":"R19-11","t":0,"m":"section","p":54},{"r":"R20-11","t":0,"m":"section","p":54},{"r":"R21-11","t":0,"m":"section","p":54},{"r":"R22-11","t":0,"m":"section","p":54}],"rk":["7eacf64ca344"],"rt":["4.6.11 Headlamp-Leveling Manager\nThe Headlamp-Leveling Manager controls the levelling of the front beams. It‘s not necessary to distinguish leveling value for left and right headlight. The requests and commands for leveling are supposed to be of type percentage (as well as information on car’s height inclination."]}
