{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_4_1_2_3_DET","src":"manifest","doc":"ErrorDescription","page":10,"text":"4.1.2.3 DET\nThe DET (Default Error Tracer) provides access to the DEM and RTE(SW-C) over\nintegrator specific code. The occurrence of a runtime error (signaled by calling\nDet_ReportRuntimeError API) or transient fault (signaled by calling the\nDet_ReportTransientFault API) triggers the execution of a corresponding error\nhandler which may be implemented as callout within the Det by an integrator of a\nparticular ECU and may only include the storage of the corresponding error event to\na memory, a call to the module Dem or the execution of short and reasonable\nactions.","caption":"4.1.2.3 DET","sha":null,"series":[{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_4_1_2_3_DET","releases":["4.3.1"],"page":9,"hash":"6f11fef8cf625582","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_4_1_2_3_DET","releases":["R19-11"],"page":9,"hash":"b074d73780ce1580","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_4_1_2_3_DET","releases":["R20-11"],"page":9,"hash":"e3bd722b9bde9e02","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_4_1_2_3_DET","releases":["R21-11"],"page":10,"hash":"c669a033621d58ff","caption":""}],"releases":["R19-11","R20-11","R21-11","4.3.1"],"kind":"snippet","platform":"classic","targets":[{"role":"constitutive","conf":0.95,"rt":"API_IMPLEMENTATION","m":"gemini-3.8-flash","why":"EXPLICIT_REFERENCE (deterministic citation)","rel":["R19-11","R20-11","R21-11","4.3.1"],"id":"SWS_Det_01001"},{"role":"constitutive","conf":0.95,"rt":"API_IMPLEMENTATION","m":"gemini-3.8-flash","why":"EXPLICIT_REFERENCE (deterministic citation)","rel":["R19-11","R20-11","R21-11","4.3.1"],"id":"SWS_Det_01003"},{"role":"heuristic","conf":0.85,"rt":"","m":"gemini-3.8-flash","why":"Det_ReportRuntimeError API definition","rel":[],"id":"SWS_CP_DIAG_00021"},{"role":"heuristic","conf":0.85,"rt":"","m":"gemini-3.8-flash","why":"Det_ReportTransientFault API definition","rel":[],"id":"SWS_CP_DIAG_00022"},{"role":"heuristic","conf":0.8,"rt":"","m":"gemini-3.8-flash","why":"Det_ReportTransientFault callout invocation","rel":[],"id":"SWS_Det_00502"},{"role":"heuristic","conf":0.75,"rt":"","m":"gemini-3.8-flash","why":"Transient fault propagation via callout","rel":[],"id":"RS_ARTICP_04146"},{"role":"heuristic","conf":0.75,"rt":"","m":"gemini-3.8-flash","why":"Transient fault propagation via callout","rel":[],"id":"RS_Arti_04146"},{"role":"heuristic","conf":0.75,"rt":"","m":"gemini-3.8-flash","why":"DetReportTransientFaultCallout definition","rel":[],"id":"SWS_Det_00187"}],"ok":true,"schema":"versions-explorer@1"}