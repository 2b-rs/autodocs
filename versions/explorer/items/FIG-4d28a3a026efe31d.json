d_<p _<o (AppDataEl) : RTE-Lese-API für Port <p und Datenelement","full":false,"src":"figure_texts","model":"gemini-3.8-flash (via agy)","recipe":"figure-series@1","at":"","of":"FIG-4d28a3a026efe31d","rel":[]}}