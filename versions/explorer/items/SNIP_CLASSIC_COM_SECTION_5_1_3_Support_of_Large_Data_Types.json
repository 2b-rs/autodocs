{"id":"SNIP_CLASSIC_COM_SECTION_5_1_3_Support_of_Large_Data_Types","src":"manifest","doc":"AUTOSAR_SRS_COM","page":14,"text":"5.1.3 Support of Large Data Types\nAUTOSAR COM and LargeDataCOM shall support signals larger than the N-PDUs of the underlying busses. For these large signals also a dynamic length shall be supported. The requirements of this chapter define the support of these data types.","caption":"5.1.3 Support of Large Data Types","sha":null,"series":[{"id":"SNIP_CLASSIC_COM_SECTION_5_1_3_Support_of_Large_Data_Types","releases":["4.2.2"],"page":14,"hash":"daf439efc98abcc9","caption":"","screenshot_path":"_src/spec/snippets/assets/f02a2c81ba31/page_14.webp"}],"releases":["4.2.2"],"screenshot_path":"_src/spec/snippets/assets/f02a2c81ba31/page_14.webp","trel":"4.2.2","tstat":"section","drop":"4.3.1","kind":"snippet","platform":"classic","targets":[{"role":"heuristic","conf":0.8,"rt":"ARCHITECTURAL_CONTEXT","m":"gemini-3.8-flash","why":"Dynamic length signals support","rel":[],"id":"RS_SYST_00029"},{"role":"heuristic","conf":0.75,"rt":"ARCHITECTURAL_CONTEXT","m":"gemini-3.8-flash","why":"Dynamic length IPdus support","rel":[],"id":"RS_SYST_00030"},{"role":"heuristic","conf":0.7,"rt":"ARCHITECTURAL_CONTEXT","m":"gemini-3.8-flash","why":"Support large data configuration","rel":[],"id":"RS_SYST_00049"}],"ok":true,"schema":"versions-explorer@1"}