{"id":"FIG-20f6b404fe883e3f","src":"figure","doc":"AUTOSAR_SWS_FlexRayNetworkManagement","page":133,"text":"Node 1 Node 2 Node 3 Node 4 Node 5","caption":"Figure 10: 1 Example of five Node Network The FlexRay Schedule allots 5 slots in the static segment and 6 (mini)slots in the dynamic segment as shown in Figure 10-2 (Seite 134). To keep the example simple the nodes are assigned static numerically equivalent to the node numbers, e.g., Node 1 is sending in static Slot 1, Node2 is sending in static slot 2 and so on.","sha":"20f6b404fe883e3f4b0433a4e2e00237e13e4b25e289457fe0221d31f92625bc","series":[{"id":"FIG-20f6b404fe883e3f","releases":["R21-11"],"sha":"20f6b404fe883e3f4b0433a4e2e00237e13e4b25e289457fe0221d31f92625bc"}],"releases":["R21-11"],"occurrences":[{"release":"R21-11","doc":"AUTOSAR_SWS_FlexRayNetworkManagement","page":133,"pdf":"R21-11/AUTOSAR/CLASSIC/AUTOSAR_SWS_FlexRayNetworkManagement.pdf"}],"kind":"figure","platform":"classic","targets":[{"role":"heuristic","conf":0.85,"rt":"","m":"gemini-3.8-flash","why":"FlexRay NM local node identifier","rel":[],"id":"SWS_FrNm_00245"},{"role":"heuristic","conf":0.8,"rt":"","m":"gemini-3.8-flash","why":"FlexRay NM node identifier service","rel":[],"id":"SWS_FrNm_00244"}],"ok":true,"schema":"versions-explorer@1"}