{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_4_5_2_2_Application_Software_Component","src":"manifest","doc":"ErrorDescription","page":68,"text":"6.4.5.2.2 Application Software Component\nDetection\nIf necessary for the design of an error handling strategy, the SWC can\nbe designed in two different ways:\n it polls the job status with the GetErrorStatus operation on the client\nport connected to the NVM\n it provides a server runnables attached to a NvMNotifyJobFinished\nserver port which shall be invoked by the NVM.\nSee sections\n 13.3.1.3 Port Interface\n 13.3.2 Ports and Port Interface for Notifications\nof Autosar_SWS_NVRAMManager.pdf","caption":"6.4.5.2.2 Application Software Component","sha":null,"series":[{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_4_5_2_2_Application_Software_Component","releases":["4.0.3"],"page":79,"hash":"545eed96a4f79a69","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_4_5_2_2_Application_Software_Component","releases":["4.1.3"],"page":80,"hash":"f617bafc75af913d","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_4_5_2_2_Application_Software_Component","releases":["4.2.2"],"page":80,"hash":"55ec8dd736378a3e","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_4_5_2_2_Application_Software_Component","releases":["4.3.1","R19-11"],"page":79,"hash":"0cedd83f53c09011","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_4_5_2_2_Application_Software_Component","releases":["R20-11"],"page":79,"hash":"4317c6bab46e37d8","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_4_5_2_2_Application_Software_Component","releases":["R21-11"],"page":68,"hash":"0cedd83f53c09011","caption":""}],"releases":["R19-11","R20-11","R21-11","4.0.3","4.1.3","4.2.2","4.3.1"],"kind":"snippet","platform":"classic","targets":[{"role":"heuristic","conf":0.85,"rt":"","m":"gemini-3.8-flash","why":"NvMNotifyJobFinished port interface notification","rel":[],"id":"SWS_NvM_00735"},{"role":"heuristic","conf":0.75,"rt":"",