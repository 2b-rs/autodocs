{"id":"SNIP_CLASSIC_COM_SECTION_6_1_3_Support_of_Large_Data_Types","src":"manifest","doc":"AUTOSAR_SRS_COM","page":14,"text":"6.1.3 Support of Large Data Types\nAUTOSAR COM and LargeDataCOM shall support signals larger than the N-PDUs\nof the underlying busses. For these large signals also a dynamic length shall be\nsupported. The requirements of this chapter define the support of these data types.","caption":"6.1.3 Support of Large Data Types","sha":null,"series":[{"id":"SNIP_CLASSIC_COM_SECTION_6_1_3_Support_of_Large_Data_Types","releases":["4.3.1"],"page":14,"hash":"f4c9f9a1b25cee0f","caption":""},{"id":"SNIP_CLASSIC_COM_SECTION_6_1_3_Support_of_Large_Data_Types","releases":["R19-11"],"page":14,"hash":"fd7bbec5729eaea0","caption":""},{"id":"SNIP_CLASSIC_COM_SECTION_6_1_3_Support_of_Large_Data_Types","releases":["R20-11"],"page":14,"hash":"c0ae337ffc877e82","caption":""},{"id":"SNIP_CLASSIC_COM_SECTION_6_1_3_Support_of_Large_Data_Types","releases":["R21-11"],"page":13,"hash":"2f276dca3f99c174","caption":""},{"id":"SNIP_CLASSIC_COM_SECTION_6_1_3_Support_of_Large_Data_Types","releases":["R22-11"],"page":14,"hash":"fd7bbec5729eaea0","caption":""}],"releases":["R19-11","R20-11","R21-11","R22-11","4.3.1"],"kind":"snippet","platform":"classic","targets":[{"role":"heuristic","conf":0.85,"rt":"","m":"gemini-3.8-flash","why":"Support for dynamic length signals","rel":[],"id":"RS_SYST_00029"},{"role":"heuristic","conf":0.8,"rt":"","m":"gemini-3.8-flash","why":"Fixed size and dynamic size signals","rel":[],"id":"RS_BRF_01568"}],"ok":true,"schema":"versions-explorer@1"}