{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_2_9_2_2_EEPROM_driver","src":"manifest","doc":"ErrorDescription","page":64,"text":"6.2.9.2.2 EEPROM driver\nDetection\nReported by the EEPROM controller (see EEPROM controller above).\nReaction\n [SWS_Eep_00068] The job is aborted.\n [SWS_Eep_00068] The module state is set to MEMIF_IDLE, ready\nto accept new jobs.\nReport\n The error is reported to the DEM with the error code\nEEP_E_COMPARE_FAILED.\nDepending on the EEPROM Driver configuration:\n [SWS_Eep_00068] The error shall be polled by the EEPROM\nAbstraction with the function Eep_GetJobResult (job result set to\nMEMIF_JOB_FAILED).\n [SWS_Eep_00068] The error shall be reported to the EEPROM\nAbstraction by the callback function Fee_JobErrorNotification.\nRecovery\nN/A","caption":"6.2.9.2.2 EEPROM driver","sha":null,"series":[{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_2_9_2_2_EEPROM_driver","releases":["4.0.3"],"page":65,"hash":"a73374d7cdb0848d","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_2_9_2_2_EEPROM_driver","releases":["4.1.3"],"page":65,"hash":"7fa416dba48dc932","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_2_9_2_2_EEPROM_driver","releases":["4.2.2"],"page":65,"hash":"3ded32e27f67a9db","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_2_9_2_2_EEPROM_driver","releases":["4.3.1"],"page":64,"hash":"a31d57b7e4c03f59","caption":""},{"id":"SNIP_CLASSIC_ERRORDESCRIPTION_SECTION_6_2_9_2_2_EEPROM_driver","releases":["R20-11"],"page":64,"hash":"6ac6a50dfc7727d0","caption":""}],"releases":["R20-11","4.0.3","4.1.3","4.2.2","4.3.1"],"kind":"snippet","platform":"classic","targets":[{"role":"constitutive","conf":0.95,"rt":"EXPLICIT_REFERENCE","m":"","why":"Direktzitat [SWS_Eep_00068] im Text von ErrorDescription.","rel":["4.3.1"],"id":"SWS_Eep_00068"},{"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"reports EEP_E_COMPARE_FAILED and MEMIF_JOB_FAILED","rel":[],"id":"SWS_Eep_00207"},{"role":"constitutiv