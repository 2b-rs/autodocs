{"id":"SNIP_CLASSIC_LINIF_SECTION_7_4_2_Go_to_sleep_process","src":"manifest","doc":"SWS_LINInterface","page":48,"text":"7.4.2 Go to sleep process\nThe transition into sleep mode significantly differs between master and slave nodes.\nThe LIN master node sends a go-to-sleep command when requested by upper layer to\nset all slave nodes on the bus to sleep mode.\nThe LIN slave node enters sleep mode either by reception of a go-to-sleep command\nor by detection of bus inactivity.","caption":"7.4.2 Go to sleep process","sha":null,"series":[{"id":"SNIP_CLASSIC_LINIF_SECTION_7_4_2_Go_to_sleep_process","releases":["R23-11"],"page":46,"hash":"1403f823b7de19b3","caption":"","screenshot_path":"_src/spec/snippets/assets/9055a89a9167/page_46.webp"},{"id":"SNIP_CLASSIC_LINIF_SECTION_7_4_2_Go_to_sleep_process","releases":["R24-11"],"page":52,"hash":"8a00db28c4187fbd","caption":"","screenshot_path":"_src/spec/snippets/assets/c79c531ec3fa/page_52.webp"},{"id":"SNIP_CLASSIC_LINIF_SECTION_7_4_2_Go_to_sleep_process","releases":["R25-11"],"page":48,"hash":"57f9fd34eb1553ad","caption":"","screenshot_path":"_src/spec/snippets/assets/abc58140e344/page_48.webp"}],"releases":["R23-11","R24-11","R25-11"],"screenshot_path":"_src/spec/snippets/assets/abc58140e344/page_48.webp","trel":"R25-11","tstat":"section","kind":"snippet","platform":"classic","targets":[{"role":"heuristic","conf":0.75,"rt":"","m":"gemini-3.8-flash","why":"LIN slave sleep mode transition on MRF","rel":[],"id":"SWS_LinIf_00750"},{"role":"heuristic","conf":0.7,"rt":"","m":"gemini-3.8-flash","why":"Driver service for master sleep transition","rel":[],"id":"SWS_Lin_00166"}],"ok":true,"schema":"versions-explorer@1"}