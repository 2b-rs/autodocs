{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02304","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SYST_02304@rel:R20-11#e88c2fe8","canonical_id":"AUTOSAR/CP/record/TPS_SYST_02304","release":"R20-11","content":"Conversion of discrete parts of a CompuMethod on signal level in SenderReceiverToSignalMapping If a SystemSignal defines a Com- puMethod of category TEXTTABLE , SCALE_LINEAR_AND_TEXTTABLE , and BIT- FIELD_TEXTTABLE , a conversion of the texttable part of the CompuMethod of the AutosarDataType of the sending DataPrototype to the SystemSignal as well as from the SystemSignal to the CompuMethod associated with the Autosar- DataType of the receiving DataPrototype may be necessary. For this purpose, meta-class SenderReceiverToSignalMapping aggregates the meta-class TextTableMapping in the roles senderToSignalTextTableMapping and signalToReceiverTextTableMapping .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:47+00:00","text_key":"840116365c23"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02304","is_dropped":false,"first_active_release":"R20-11","last_active_release":"R20-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R20-11"],"presence_only":[],"unchecked":["R18-10","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"SYST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R20-11","last":"R20-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-cb41f0673cc7c815","doc":"AUTOSAR_TPS_SystemTemplate","p":151,"rel":[],"role":"heuristic","conf":0.9,"rt":"","m":"gemini-3.8-flash","why":"SenderReceiverToSignalMapping text table mapping.","n":2,"cap":"","sha":null,"nser":0,"src":"matrix"},{"id":"FIG-0595d47668c44614