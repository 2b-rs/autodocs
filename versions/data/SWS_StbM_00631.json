{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_StbM_00631","versions":[{"version_id":"AUTOSAR/CP/record/SWS_StbM_00631@rel:R25-11#3fe0e5f8","canonical_id":"AUTOSAR/CP/record/SWS_StbM_00631","release":"R25-11","content":"User Data Length and Bytes when getting User Data All StbM APIs that are returning User Data (e.g., StbM_GetCurrentTime ) for a given Time Base shall • set the userDataLength element of the returned User Data parameter to the value of the userDataLength of the StbM internal User Data structure of a Time Base • set all three User Data bytes of the returned User Data parameter to the values of the User Data bytes of the StbM internal User Data structure of a Time Base.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_SWS_SynchronizedTimeBaseManager.pdf"},"recorded_at":"2026-10-15T00:03:28+00:00","text_key":"eda77a275e3c"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_StbM_00631","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R25-11"],"presence_only":[],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"StbM","cluster":"tsync","page":"","doc_type":"SWS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[],"snippets":[],"cited_in":[],"cited_total":0},"upstream_trace":{"source":"classic-upstream/v1","releases":{"R25-11":[{"id":"RS_TS_00015","doc":"AUTOSAR_FO_RS_TimeSync.pdf","doc_release":"R25-11","url":"https://www.autosar.org/fileadmin/standards/R25-11/FO/AUTOSAR_FO_RS_TimeSync.pdf#nameddest=RS_TS_00015"}]}}}