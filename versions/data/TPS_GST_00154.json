{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00154","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00154@rel:R19-11#280dbb6a","canonical_id":"AUTOSAR/CP/record/TPS_GST_00154","release":"R19-11","content":"Specialization of Relations There are two kinds of specialization: • redefines redefine replaces the abstract relationship entirely • subsets subset contributes to the abstract relation such that it can be derived by building the union of all subsets. The specialization is shown in diagrams at the relation end in curly brackets. Note that relations of upper multiplicity equal 1 can only be “redefined” but not “subsetted”. On the other hand, relations with upper multiplicity greater than 1 can only be “subsetted” but not “redefined”.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"280dbb6acace895dbf6458fd6b7f06c09c869019b82648cf5681a882605a52a5","removed":["151 of 497  AUTOSAR CONFIDENTIAL  Document ID 202: AUTOSAR_TPS_GenericStructureTemplate Generic Structure Template AUTOSAR CP R19-11"],"replaced":["U+0093→“","U+0094→”"]},"text_key":"348ccbe6dc6e"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00154","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"GST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-c143043a17e4f039","doc":"AUTOSAR_FO_TPS_GenericStructureTemplate","p":184,"rel":[],"r