{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02264","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SYST_02264@rel:R19-11#4f34b7f5","canonical_id":"AUTOSAR/CP/record/TPS_SYST_02264","release":"R19-11","content":"Usage of DltLogChannel In each DltConfig the Physi- calChannel s that are used to transport the log and trace messages are configured by the DltLogChannel elements. Each DltLogChannel points to one PduTriggering in the role txPduTriggering to describe the Dlt Pdu that is transmitted by the DltLogChannel . The rxPduTrig- gering role is used to describe the Dlt Pdu that is received by the DltLogChannel . The DltLogChannel defines the applicationId and contextId that are used to identify the source of the log and trace message.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:27+00:00","text_key":"f263040c87b5","rejoin":{"rule":"text-rejoin@1","e":[[50,2,""],[62,1,""],[320,2,""]]}},{"version_id":"AUTOSAR/CP/record/TPS_SYST_02264@rel:R20-11#4f34b7f5","canonical_id":"AUTOSAR/CP/record/TPS_SYST_02264","release":"R20-11","content":"Usage of DltLogChannel In each DltConfig the Physi- calChannel s that are used to transport the log and trace messages are configured by the DltLogChannel elements. Each DltLogChannel points to one PduTriggering in the role txPduTriggering to describe the Dlt Pdu that is transmitted by the DltLogChannel . The rxPduTrig- gering role is used to describe the Dlt Pdu that is received by the DltLogChannel . The DltLogChannel defines the applicationId and contextId that are used to identify the source of the log and trace message.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:47+00:00","text_key":"f263040c87b5","rejoin":{"rule":"text-rejoin@1","e":[[50,2,""],[62,1,""],[320,2,""]]}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02264","is_dropped":false,"first_active_re