{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00313","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00313@rel:R19-11#65692652","canonical_id":"AUTOSAR/CP/record/TPS_GST_00313","release":"R19-11","content":"Types of Paragraph There are two different types of paragraphs in AUTOSAR. They differ only in the elements, which they may contain: • the overview paragraph ( LOverviewParagraph ) is used as a compact descrip- tive paragraph desc . It therefore cannot embed Identifiables which might be rendered as structure (such as Xdoc etc.). • the regular paragraph ( LParagraph ) (used as p) additionally provides elements which might be rendered as structures such as meta data of external files, docu- ment and standards.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00313","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"GST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1},"evidence":{"figures":[{"id":"FIG-a2e8be9f340c52ab","doc":"AUTOSAR_FO_TPS_GenericStructureTemplate","p":304,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"EXPLICIT_REFERENCE (deterministic citation)","n":5,"cap":"Figure 9.2: documentation block overview","sha":"a2e8be9f340c52abcbbf1002227670f0f6c15aab1859086fb63f153260b24281","nser":3,"src":"figure"},{"id":"FIG-1c34c2b817f0880f","doc":"AUTOSAR_TPS_GenericStructureTemplate","p":262,"rel":[],"role":"heur