e ensured. td PerErrc ::kEncryptionFailed td rollback_semantics Returned if the decryption of stored data fails. td PerErrc ::kDataTypeMismatch td rollback_semantics Returned if the data type of stored value does not match the templated type. td PerErrc ::kAuthenticationFailed td rollback_semantics Returned if checking the MAC of stored data fails.","meta":{"trigger_kind":"baseline_sync"},"recorded_at":"2026-09-30T16:43:34+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/SWS_PER_00332","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"function","name":"GetValue","module":"PER","cluster":"","page":"classes/cl_ara_per_KeyValueStorage_e55123.html","doc_type":"SWS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1},"evidence":{"figures":[{"id":"FIG-b045d30e3c97fa76","doc":"AUTOSAR_AP_EXP_SWArchitecture","p":90,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"GetValue return overload in KeyValueStorage","n":16,"cap":"Figure 9.36: Interfaces for key-value-based data storage","sha":"b045d30e3c97fa76804aee0624930cbac3f6a04b3d15be2ecbb043d7043e46b6","nser":5,"src":"figure"}],"snippets":[{"id":"SNIP_per_AUTOSAR_AP_SWS_P_P106_296","doc":"AUTOSAR_AP_SWS_Persistency","p":106,"rel":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"role":"constitutive","conf":0.95,"rt":"API_IMPLEMENTATION","m":"gemini-3.8-flash","why":"EXPLICIT_REFERENCE (deterministic citation)","n":10,"x":"c (RS_PER_00017, RS_AP_00119, RS_AP_00120, RS_AP_00121, RS_AP_00127, RS_AP_00128, RS_AP_00129, RS_AP_00132, RS_AP_00135, RS_AP_00139) 8.2.5.7 KeyValueStorage::GetValue [SWS_PER_00332] Definition of A…","src":"snippet"},{"id":"SNIP_per_AUTOSAR_AP_SWS_P_P