{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00166","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00166@rel:R19-11#f5e7c78a","canonical_id":"AUTOSAR/CP/record/TPS_GST_00166","release":"R19-11","content":"Model Transformation for Primitives A meta class of primitive is converted to the following elements. 2 This approach is implemented in the schema generator. 1. another primitive with the same name enhanced by “_simple”. For xml, this primi- tive results in a simple type in the generated schema and specifies the implemen- tation details, such as patterns and facets. This meta-class is used for attributes tagged with xml.attribute=true but also as primitive type for attributes tagged with xml.roleElement=false , xml.roleWrapperElement=false , xml.typeElement=false , xml.typeWrapperElement=false . 2. a meta-class with the same name. As all other meta-classes, this meta- class inherits from atpObject . Thus UML-attributes in the meta-model are finally implemented as aggregation of this meta-class unless tagged with xml.attribute=true .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"f5e7c78aee4e038e896bea7cbfb2315f129d6851499b1140556a3b64198dfcc5","removed":["171 of 497  AUTOSAR CONFIDENTIAL  Document ID 202: AUTOSAR_TPS_GenericStructureTemplate Generic Structure Template AUTOSAR CP R19-11"],"replaced":["U+0093→“","U+0094→”"]},"text_key":"15486f53c22b"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00166","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"