{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00258","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00258@rel:R19-11#2af23238","canonical_id":"AUTOSAR/CP/record/TPS_GST_00258","release":"R19-11","content":"Binding VariationPoint s early A concrete software system may bind a variation point at an earlier binding time if this is technically feasible, and within contractual limits 10 . We define the additional restriction Variation Point Binding Times later than System Design Time are part of the contract. According to this restriction, the RTE Generator is not allowed to resolve the variability in the application header file even if the variability is already chosen in the input of the RTE. If the binding time is systemDesignTime , then the variability is not considered part of the contract phase, and it shall be bound properly during systemDesignTime before the contract.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00258","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"GST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-1b233aafbb284f26","doc":"AUTOSAR_TR_Methodology","p":300,"rel":[],"role":"heuristic","conf":0.85,"rt":"","m":"gemini-3.8-flash","why":"SystemDesignTime variability binding","n":2,"cap":"Figure 3.45: Select Design Time Variant","sha":"1b233aafbb284f266c8eef1c1ddec761f1404c3b0c1