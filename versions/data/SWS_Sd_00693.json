{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00693","versions":[{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00693","release":"R19-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00693","release":"R20-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"version_id":"AUTOSAR/CP/record/SWS_Sd_00693@rel:R21-11#45bc768a","canonical_id":"AUTOSAR/CP/record/SWS_Sd_00693","release":"R21-11","content":"The Counter field in the Type 2 Entry format is used to differentiate different Subscribe Eventgroups to otherwise identical Eventgroups (i.e. same Service ID, same Instance ID, same Eventgroup ID, and same Major Version). The Counter field shall be reflected by the Server to the Subscribe Eventgroup Ack and Nack entries. If identical Consumed Eventgroups are configured with different Endpoints, then the SD shall use the Counter to differentiate the different Subscriptions. The value of the Counter can be determined by the implementation.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_ServiceDiscovery.pdf"},"recorded_at":"2026-10-01T10:12:53+00:00"},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00693","release":"R22-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00693","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00693","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00693","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00693","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R25-11","dropped