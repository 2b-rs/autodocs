{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00204","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00204@rel:R19-11#4ea40208","canonical_id":"AUTOSAR/CP/record/TPS_GST_00204","release":"R19-11","content":"Handling of non variant associations The reason for making VariationPoint optional in {ReferenceClass}RefConditional is that the as- sociation may be variant, but does not have to be variant. Hence, if the association is used in a context where there is no variability – the association is always there – then there is no need to add a variation point to the model (on M1 level). This helps to reduce the complexity of the resulting model, and trims the resulting XML representation.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"4ea4020859c4f23167511adda9e3e24d4d2130c75ce633cd8d2041a5eb4b93f1","removed":[],"replaced":["U+0096→–"]},"text_key":"d528b35cd8a3"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00204","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"GST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-328a9c3468835f49","doc":"AUTOSAR_FO_TPS_GenericStructureTemplate","p":225,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"EXPLICIT_REFERENCE (deterministic citation)","n":5,"cap":"Figure 7.4: attribute value pattern","sha":"328a9c3468835f4936c18a4c1004fd