{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_SomeIpTp_00020","versions":[{"version_id":"AUTOSAR/CP/record/SWS_SomeIpTp_00020@rel:R21-11#c6a6aedd","canonical_id":"AUTOSAR/CP/record/SWS_SomeIpTp_00020","release":"R21-11","content":"The SOME/IP TP module shall debounce subsequent calls of the API PduR_ SomeIpTpTransmit() for the same PDU ID,using the parameter SomeIpTpNPduSep- arationTime. It defines the time span between the call of SomeIpTp_TxConfirmation(), and the sub- sequent call of the API PduR_SomeIpTpTransmit(). If SomeIpTpTxBurstSize is config- ured to a value > 1 the SOME/IP TP module shall debounce for the same PDU ID only every SomeIpTpTxBurstSize segments.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_SOMEIPTransportProtocol.pdf"},"recorded_at":"2026-10-01T10:12:50+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_SomeIpTp_00020","is_dropped":true,"first_active_release":"R21-11","last_active_release":"R21-11","dropped_in":["R22-11","R25-11"],"first_dropped_release":"R22-11","absent_before":["R18-10","R19-11","R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"SomeIpTp","cluster":"","page":"","doc_type":"SWS","ai":false,"first":"R21-11","last":"R21-11","changed":[],"distinct":1},"evidence":{"figures":[{"id":"FIG-00e7266603f29fb5","doc":"AUTOSAR_TPS_SystemTemplate","p":398,"rel":[],"role":"heuristic","conf":0.85,"rt":"","m":"gemini-3.8-flash","why":"SOME/IP TP burst size and separation time","n":4,"cap":"Figure 6.58: SOME/IP Segmenter","sha":"00e7266603f29fb561ee208ecadaa82190773b17ec7251ad1aca761723e60cfa","nser":5,"src":"figure"}],"snippets":[]}}