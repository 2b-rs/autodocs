{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_E2EXf_00029","versions":[{"version_id":"AUTOSAR/CP/record/SWS_E2EXf_00029@rel:R22-11#a07b9d3c","canonical_id":"AUTOSAR/CP/record/SWS_E2EXf_00029","release":"R22-11","content":"The function E2EXf_Inv_<transformerId> shall invoke E2E_ PXXMapStatusToSM(), passing to that function the return value of E2E_PXXCheck and the profile's check Status (variable Status of state object of type E2E_PXXCheck StateType, see [SWS_E2EXf_00125]), to obtain the profile-independent check status. For P1/P2 mapping functions, there is an additional call parameter profileBehavior: • if configuration parameter profileBehavior is R4_2, then E2E_PXXMapStatusTo SM() shall be invoked with the call parameter profileBehavior = 1 • if configuration parameter profileBehavior is PRE_R4_2, then E2E_PXXMapSta- tusToSM() shall be invoked with call parameter profileBehavior = 0","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_E2ETransformer.pdf"},"recorded_at":"2026-10-01T10:13:22+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_E2EXf_00029","is_dropped":true,"first_active_release":"R22-11","last_active_release":"R22-11","dropped_in":["R25-11"],"first_dropped_release":"R25-11","absent_before":["R18-10","R19-11","R20-11","R21-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"E2EXf","cluster":"","page":"","doc_type":"SWS","ai":false,"first":"R22-11","last":"R22-11","changed":[],"distinct":1},"evidence":{"figures":[{"id":"FIG-28993355fab4da16","doc":"AUTOSAR_SWS_E2ETransformer","p":27,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"EXPLICIT_REFERENCE (deterministic citation)","n":15,"cap":"Figure 7: 4: E2EXf_Inv_<transformerId> function overview","sha":"28993355fab4da164524f28c6283885d154e16471e777aa8311f08f360c75f7d","nser":1,"src":"figure"},{"id":"FIG-3955657946afd0f1","doc