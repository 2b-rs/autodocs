{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_PduR_00881","versions":[{"version_id":"AUTOSAR/CP/record/SWS_PduR_00881@rel:R21-11#151afa8c","canonical_id":"AUTOSAR/CP/record/SWS_PduR_00881","release":"R21-11","content":"For inter-partition routing paths, the call to the following func- tions shall only execute code that is assigned to the same ECUC partition: • PduR_<SrcLo>RxIndication , • PduR_<DstLo>TriggerTransmit , • PduR_<DstLo>TxConfirmation . PduR shall not call the <DstLo>_Transmit in the call context of PduR_<SrcLo> RxIndication . PduR shall call <DstLo>_Transmit in the ECUC partition context of the <DstLo> module (in fact of the ECUC partition context defined via the EcucPdu DefaultPartitionRef or the EcucPduDedicatedPartitionRef of the PduR- DestPduRef ).","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_PDURouter.pdf"},"recorded_at":"2026-10-01T10:12:56+00:00","text_key":"5e446d4b5ccd"},{"canonical_id":"AUTOSAR/CP/record/SWS_PduR_00881","release":"R22-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_PduR_00881","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_PduR_00881","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_PduR_00881","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_PduR_00881","is_dropped":false,"first_active_release":"R21-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R21-11"],"presence_only":["R22-11","R23-11","R24-