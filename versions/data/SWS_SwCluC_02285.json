{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_SwCluC_02285","versions":[{"version_id":"AUTOSAR/CP/record/SWS_SwCluC_02285@rel:R25-11#73afb22f","canonical_id":"AUTOSAR/CP/record/SWS_SwCluC_02285","release":"R25-11","content":"Semantics of SwCluCOsProxyMaxNumberOfCallee For each SwCluCOsProxyOsTask , the Os Low Proxy shall put a SwCluCBMan- ifProvideResourceEntry into the binary manifest. If the proxy task’s SwCluCOsProxyOsTaskDispatcher has SwCluCOsProxy- MaxNumberOfCallee set to a value bigger than 1, the provide entry shall be placed in the SwCluCBManifProvideResourceEntryGroup defined in [SWS_SwCluC_02284] and the SwCluCBManifMaxNumberOfNotifierSets shall be set to the value of SwCluCOsProxyMaxNumberOfCallee .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_SWS_SoftwareClusterConnection.pdf"},"recorded_at":"2026-10-15T00:03:25+00:00","text_key":"e17a22669c5b","rejoin":{"rule":"text-rejoin@1","e":[[114,2,""],[232,2,""]]}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_SwCluC_02285","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R25-11"],"presence_only":[],"unchecked":["R18-10","R19-11"]},"element":{"kind":"requirement","name":"SWS_SwCluC_02285","module":"SwCluC","cluster":"system","page":"classic/modules/swcluc.html","doc_type":"SWS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-4ea6877336f56bfe","doc":"AUTOSAR_CP_SWS_SoftwareClusterConnection","p":364,"rel":[],"role":"heuristic","conf":0.75,"rt":"PARAMETER_CONSTRAINT","m":"gemini-3.8-flash","why":"Dispatcher semantics for SwCluCOsProxyMaxNumberOfCallee","n":6,"cap":"Figure 10.21: Os Proxy Task Dispatcher Parameter","sha":"4e