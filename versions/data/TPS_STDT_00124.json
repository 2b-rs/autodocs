{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_STDT_00124","versions":[{"version_id":"AUTOSAR/CP/record/TPS_STDT_00124@rel:R19-11#7125b1d7","canonical_id":"AUTOSAR/CP/record/TPS_STDT_00124","release":"R19-11","content":"Purpose of SpecElementScope For all AUTOSAR specifica- tion elements and custom functionality a Data Exchange Point describes if a referenced specification element is relevant for the Data Exchange Point. If inScope ==true, then the specification element is relevant. (e.g. a requirement needs to be fullfilled, a con- straint is enabled, an attribute shall exist, ...). If inScope ==false, then the specification element is not relevant. (e.g. a requirement does not apply, a constraint is disabled, it is not relevant if an attribute exists, ...)","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_StandardizationTemplate.pdf"},"recorded_at":"2026-10-01T10:12:16+00:00","text_key":"ac2e88eb61f4"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_STDT_00124","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"STDT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-5118a7711cf2b8fa","doc":"AUTOSAR_FO_TPS_StandardizationTemplate","p":91,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"SpecElementScope purpose and inScope attribute","n":7,"cap":"","sha":null,"nser":0,"src":"matrix"},{"id":"FIG-a9ad6919986bcb08","doc":"AUTOSAR_TPS_StandardizationTemplate","p":105,"rel":[],"role":"constitutive","conf":0.95