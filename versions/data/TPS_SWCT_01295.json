{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01295","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SWCT_01295@rel:R19-11#740fb1ac","canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01295","release":"R19-11","content":"SwRecordLayout The SwRecordLayout describes how data is serialized in the memory of an ECU. This information is important with respect to the following aspects: • to inform a measurement and calibration system how the data is serialized in the memory of an ECU • to make sure that the software development results in the intended data struc- tures • to identify the proper interpolation routines Via the SwDataDefProps a record-layout can be associated to a data entity. If the very same serialization approach is used for multiple ApplicationDataType s all of these may refer to the same SwRecordLayout even if the size of the data is different.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SoftwareComponentTemplate.pdf"},"recorded_at":"2026-10-01T10:12:25+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"740fb1acc8ddf846c076bc876a0428a09bcd09dd4422ec1ce30ca1963d1c6b65","removed":["435 of 1124  AUTOSAR CONFIDENTIAL  Document ID 62: AUTOSAR_TPS_SoftwareComponentTemplate Software Component Template AUTOSAR CP R19-11"]},"text_key":"0df7104639dc"},{"version_id":"AUTOSAR/CP/record/TPS_SWCT_01295@rel:R20-11#24a047af","canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01295","release":"R20-11","content":"SwRecordLayout The SwRecordLayout describes how data is serialized in the memory of an ECU. This information is important with respect to the following aspects: • to inform a measurement and calibration system how the data is serialized in the memory of an ECU • to make sure that the software development results in the intended data struc- tures • to identify the proper interpolation routines Via the SwDataDefProps a record-layout can be associated to a data entity. If the very same serialization approach is used for multiple ApplicationDataType s all of these may refer to the same SwRecordLayout even if the size of the data is different.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SoftwareComponentTemplate.pdf"},"recorded_at":"2026-10-01T10:12:45+00:00","text_key":"0df7104639dc"},{"version_id":"AUTOSAR/CP/record/TPS_SWCT_01295@rel:R25-11#b24dddfc","canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01295","release":"R25-11","content":"SwRecordLayout The SwRecordLayout describes how data is serialized in the memory of an ECU. This information is important with respect to the following aspects: • to inform a measurement and calibration system how the data is serialized in the memory of an ECU • to make sure that the software development results in the intended data struc- tures • to identify the proper interpolation routines Via the SwDataDefProps , a record-layout can be associated to a data entity. If the very same serialization approach is used for multiple ApplicationDataType s all of these may refer to the same SwRecordLayout even if the size of the data is different.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_TPS_SoftwareComponentTemplate.pdf"},"recorded_at":"2026-10-01T09:59:17+00:00","text_key":"0df7104639dc"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01295","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11","R20-11","R25-11"],"presence_only":[],"unchecked":["R18-10","R21-11","R22-11","R23-11","R24-11"]},"element":{"kind":"requirement","name":"","module":"SWCT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R25-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-4d166b550b687a5a","doc":"AUTOSAR_TPS_SoftwareComponentTempl