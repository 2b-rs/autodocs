{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02255","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SYST_02255@rel:R19-11#d7c3e02d","canonical_id":"AUTOSAR/CP/record/TPS_SYST_02255","release":"R19-11","content":"Frame . frameLength usage for FlexrayFrame s and Can- Frame s The frameLength for a FlexrayFrame shall be equal or larger than the combined length of all Pdu s that are mapped to the frame. The frameLength for a CanFrame is used to describe the minimum length of a re- ceived L-PDU to be accepted by a data length check. Therefore, it is possible to configure a frameLength which is smaller than the mapped Pdu to this frame. If data length check is not needed the frameLength of a CanFrame may be left unde- fined. The reason for that is that if the CanFrame . frameLength is larger than the Pdu . length of the mapped Pdu and data length check is used, a received Pdu will always be discarded due to a failing minimum length check.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:27+00:00"},{"version_id":"AUTOSAR/CP/record/TPS_SYST_02255@rel:R20-11#d7c3e02d","canonical_id":"AUTOSAR/CP/record/TPS_SYST_02255","release":"R20-11","content":"Frame . frameLength usage for FlexrayFrame s and Can- Frame s The frameLength for a FlexrayFrame shall be equal or larger than the combined length of all Pdu s that are mapped to the frame. The frameLength for a CanFrame is used to describe the minimum length of a re- ceived L-PDU to be accepted by a data length check. Therefore, it is possible to configure a frameLength which is smaller than the mapped Pdu to this frame. If data length check is not needed the frameLength of a CanFrame may be left unde- fined. The reason for that is that if the CanFrame . frameLength is larger than the Pdu . length of the mapped Pdu and data length check is used, a received Pdu will always be discarded due to a failing minimum length check.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:47+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02255","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R20-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11","R20-11"],"presence_only":[],"unchecked":["R18-10","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"SYST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R20-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"SNIP_CLASSIC_CAN_FIGURE_Figure_6_29","doc":"SystemTemplate","p":350,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"EXPLICIT_REFERENCE (deterministic citation)","n":4,"cap":"Figure 6.29","sha":null,"nser":1,"src":"manifest"},{"id":"SNIP_CLASSIC_CAN_FIGURE_Figure_6_33","doc":"TPS_SystemTemplate","p":476,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"EXPLICIT_REFERENCE (deterministic citation)","n":4,"cap":"Figure 6.33","sha":null,"nser":2,"src":"manifest"},{"id":"FIG-1d8640a581fa970e","doc":"AUTOSAR_SystemTemplate","p":77,"rel":[],"role":"heuristic","conf":0.9,"rt":"","m":"gemini-3.8-flash","why":"CanFrame and Frame frameLength attributes","n":2,"cap":"Figure 22: The general Frame attributes. (CANFrames)","sha":"1d8640a581fa970ef8d60d1f2e2e51e9c924c8627d9113950adb2d0d732f9dfb","nser":1,"src":"figure"},{"id":"FIG-aeea76cef054497f","doc":"AUTOSAR_SystemTemplate","p":66,"rel":[],"role":"heuristic","conf":0.85,"rt":"","m":"gemini-3.8-flash","why":"Frame.frameLength usage and attributes","n":3,"cap":"Figure 20: Frame definition in the metamodel (FrameInstance)","sha":"aeea76cef054497f150e94d5afaf2c44c999e4052145cedb5317f4e1f2569fa