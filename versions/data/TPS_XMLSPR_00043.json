{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00043","versions":[{"version_id":"AUTOSAR/CP/record/TPS_XMLSPR_00043@rel:R19-11#cdeaf5c0","canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00043","release":"R19-11","content":"XML Configuration of references without stereotype For references we basically distinguish the following two cases: 1. Upper multiplicity of reference = 1 • Xml.RoleWrapperElement = false • xml.roleElememt = true • xml.typeWrapperElement = false • xml.typeElement = false 2. Upper Multiplicity of reference > 1 • Xml.RoleWrapperElement = true • xml.roleElememt = true • xml.typeWrapperElement = false • xml.typeElement = false Furthermore 'xml.name' of properties representing the navigable association end of references is set to the default 'xml.name' appended by \"-REF\" (the default 'xml.name' is defined in chapter 3.6). The 'xml.namePlural' is set to the default 'xml.name' ap- pended by \"-REFS\".","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_XMLSchemaProductionRules.pdf"},"recorded_at":"2026-10-01T10:12:16+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"cdeaf5c04bb838813ca0e3da0132a868d56d00745c797b9ea84a6ce6ddf2602b","removed":["37 of 90  AUTOSAR CONFIDENTIAL  Document ID 122: AUTOSAR_TPS_XMLSchemaProductionRules AUTOSAR XML Schema Production Rules AUTOSAR CP R19-11"]},"text_key":"264333b648e2"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00043","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"XMLSPR","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed