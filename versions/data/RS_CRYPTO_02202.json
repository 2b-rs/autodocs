{"ok":true,"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02202","versions":[{"version_id":"AUTOSAR/AP/record/RS_CRYPTO_02202@rel:R25-11#1e196632","canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02202","release":"R25-11","content":"The Crypto Stack shall provide interfaces to use asymmet- ric encryption and decryption primitives Status: DRAFT Description: The Crypto Stack shall support encrypting and decrypting data using an asymmetric algorithm. Rationale: While encryption/decryption of bulk data (long messages) should be done using symmetric-key algorithms for efficiency reasons, the Crypto Stack supports also asymmetric encryption/decryption primitives required by special use cases that apply asymmetric encryption/deception on messages of short length and to facilitate implementing standards that include hybrid encryption/decryption schemes. Dependencies: – Use Case: – Supporting Material: –","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_AP_RS_Cryptography.pdf"},"recorded_at":"2026-09-30T16:47:59+00:00","text_key":"38a4d4dc5122","rejoin":{"rule":"text-rejoin@1","e":[[56,2,""]]}}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02202","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"CRYPTO","cluster":"","page":"","doc_type":"RS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"AP"},"evidence":{"figures":[{"id":"FIG-161b70dc5f5c38de","doc":"AUTOSAR_FO_TR_Features","p":27,"rel":[],"role":"heuristic","conf":0.85,"rt":"ARCHITECTURAL_CONTEXT","m":"gemini-3.8-flash","why":"Asymmetric encryption and decryption primitives","n":3,"cap":"Figure 4.16: Feature FO_TR_FEAT_00210","sha":"161b70dc5f5c38dea9