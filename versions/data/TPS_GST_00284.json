{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00284","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00284@rel:R19-11#52d287aa","canonical_id":"AUTOSAR/CP/record/TPS_GST_00284","release":"R19-11","content":"Semantics of approvalStatus The attribute approvalSta- tus of an EvaluatedVariantSet further details the status of the evaluated variant. The following values are standardized: 1. APPROVED An “approved” variant is known to work. 2. REJECTED An “rejected” variant is known not to work. Note that all other values are use case specific. Hence EvaluatedVariantSet with approvalStatus other than APPROVED or REJECTED is not defined by the standard and therefore shall be ignored when evaluating a system.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"52d287aa5265907919ee709f0bc378f79f54b513490064d05af92be285a6d879","removed":["241 of 497  AUTOSAR CONFIDENTIAL  Document ID 202: AUTOSAR_TPS_GenericStructureTemplate Generic Structure Template AUTOSAR CP R19-11"],"replaced":["U+0093→“","U+0094→”"]},"text_key":"014a82f427d5","rejoin":{"rule":"text-rejoin@1","e":[[53,2,""]]}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00284","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"GST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-a6bb54a52d9798f2","doc":"AUTOSAR_TR_Methodology","p":189,"rel":[],"role":