{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_ASR_00013","versions":[{"version_id":"AUTOSAR/CP/record/TPS_ASR_00013@rel:R19-11#3beb191b","canonical_id":"AUTOSAR/CP/record/TPS_ASR_00013","release":"R19-11","content":"Pattern for AUTOSAR XML Schema location hint URI The AUTOSAR XML Schema location hint URI in the AUTOSAR XML description shall be the file name of a XML Schema document provided by AUTOSAR. This file name follows the pattern: AUTOSAR_{number}.xsd {number} corresponds to the specific AUTOSAR release the given AUTOSAR XML Schema belongs to. In particular no path shall be part of the AUTOSAR XML Schema location hint URI .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_ARXMLSerializationRules.pdf"},"recorded_at":"2026-10-01T10:12:23+00:00","text_key":"347f37d267dd"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_ASR_00013","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"ASR","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-2ebf5dac312ac081","doc":"AUTOSAR_TPS_ARXMLSerializationRules","p":13,"rel":[],"role":"heuristic","conf":0.9,"rt":"","m":"gemini-3.8-flash","why":"Pattern XML Schema location hint URI","n":1,"cap":"Figure 2.1: Releases of AUTOSAR standards that are contained in the AUTOSAR XML Schema","sha":"2ebf5dac312ac0817124156426b3c0df9a75393c51ef823e09a227c8238eef3c","nser":2,"src":"figure"},{"id":"FIG-5ffedbac21aea893","doc":"AUTOSAR_AP_TPS_MachineConfiguration","p":10,"rel":[],"role":"heuristic","conf":0.7,"rt"