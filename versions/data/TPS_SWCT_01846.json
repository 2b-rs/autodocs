{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01846","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SWCT_01846@rel:R25-11#d3f0c7c7","canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01846","release":"R25-11","content":"Use InstantiationDataDefProps to facilitate the defini- tion of access to calibration parameters As the definition of a calibration param- eter may involve the definition of several axes, the necessity to provide this amount of information might become cumbersome and (to some extent) redundant and dif- ficult to maintain if the same calibration parameter is accessed from within several RunnableEntity s. In other words: in this case it would be necessary to repeat the more or less complex set of information for each RunnableEntity . To avoid this unnecessary level of complexity for the definition of access to calibration parameters, it is possible to define the access to the calibration parameter on the level of InstantiationDataDefProps which have been defined to facilitate this kind of re-use.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_TPS_SoftwareComponentTemplate.pdf"},"recorded_at":"2026-10-01T09:59:17+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"d3f0c7c7ebd785f4a501c22dd112dd6581f51e4a911f2da75c3ebef498f87ca1","removed":["369 of 1277 Document ID 62: AUTOSAR_CP_TPS_SoftwareComponentTemplate Software Component Template AUTOSAR CP R25-11"]},"text_key":"7540dbab6aca"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01846","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R25-11"],"presence_only":[],"unchecked":["R18-10","R21-11","R22-11","R23-11","R24-11"]},"element":{"kind":"requirement","name":"","module":"SWCT","cluster":"","page":"","do