{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05061","versions":[{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05061","release":"R19-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05061","release":"R20-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05061","release":"R21-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"version_id":"AUTOSAR/CP/record/SWS_FrIf_05061@rel:R22-11#abeb4f0d","canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05061","release":"R22-11","content":"The Communication Operation PREPARE_LPDU enables hard- ware optimization purposes. Its purpose is to enable certain FlexRay CC hardware resources (e.g. a CC's message buffer) to be prepared (configured) for the transmis- sion/reception of a certain L-PDU. This Communication Operation enables the FlexRay Driver to optimize the usage of hardware resources if available at appropriate point of times. However, it is the respon- sibility of the FlexRay Driver to decide and validate ressource allocation optimizations based on the PREPARE_LPDU Communication Operations. Practically the usage of this Communication Operation will introduce some runtime-overhead even if the Flex Ray Driver does not use the opportunity for reconfiguration.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_FlexRayInterface.pdf"},"recorded_at":"2026-10-01T10:13:26+00:00"},{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05061","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05061","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05061","release":"R25-11","text_captured":false,"meta":{"t