{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01489","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SWCT_01489@rel:R19-11#38f73eb4","canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01489","release":"R19-11","content":"Standardized values of SwRecordLayoutV . swRecordLay- outVProp SwRecordLayoutV . swRecordLayoutVProp describes the type of val- ues to be stored. The standardized values for SwRecordLayoutV . swRecordLay- outVProp are listed in Table 5.111.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SoftwareComponentTemplate.pdf"},"recorded_at":"2026-10-01T10:12:25+00:00"},{"version_id":"AUTOSAR/CP/record/TPS_SWCT_01489@rel:R20-11#7f61e59d","canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01489","release":"R20-11","content":"Standardized values of SwRecordLayoutV . swRecordLay- outVProp SwRecordLayoutV . swRecordLayoutVProp describes the type of val- ues to be stored. The standardized values for SwRecordLayoutV . swRecordLay- outVProp are listed in Table 5.112.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SoftwareComponentTemplate.pdf"},"recorded_at":"2026-10-01T10:12:45+00:00"},{"version_id":"AUTOSAR/CP/record/TPS_SWCT_01489@rel:R25-11#38a52e64","canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01489","release":"R25-11","content":"Description of standardized values of SwRecordLayoutV . swRecordLayoutVProp Property Description VALUE The value of the axis for the current iterator point. This is e.g. the particular point on an input-axis, but also the particular character in a string. COUNT The amount of values of the axis. LEFTDIFF The difference to the previous axis point. RIGHTDIFF The difference to the next axis point. DIST The distance value of this axis in case of a fixed axis with distance specification. SHIFT The shift value of this axis in case of a fixed axis with shift/offset. OFFSET The offset value of this axis in case of a fixed axis with shift/offset. FILL Fill with the hex value specified as contents of swRecordLayoutVFixValue . RESERVED Position shall be ignored by MCD tools. IDENTIFIER An “identifier” is deposited at the position. FIXLEFTDIFF Difference between this and a fixed left-hand value specified in swRecordLayoutVFixValue . FIXRIGHTDIFF Difference between this and a fixed right-hand value specified in swRecordLayoutVFixValue .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_TPS_SoftwareComponentTemplate.pdf"},"recorded_at":"2026-10-01T09:59:17+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01489","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R18-10"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"SWCT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R25-11","changed":["R20-11","R25-11"],"distinct":3},"evidence":{"figures":[{"id":"FIG-98bbe11302518628","doc":"AUTOSAR_CP_TPS_SoftwareComponentTemplate","p":424,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"EXPLICIT_REFERENCE (deterministic citation)","n":4,"cap":"Figure 5.62: Values for swRecordLayoutVProp for individual axis","sha":"98bbe11302518628531c80faa9d8dbf714673fc49515b9175b9af1aa3c3ba920","nser":1,"src":"figure"},{"id":"FIG-c81bad9a0d3ac312","doc":"AUTOSAR_TPS_SoftwareComponentTemplate","p":439,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"EXPLICIT_REFERENCE (deterministic citation)","n":7,"cap":"Figure 5.57: Values for swRecordLayoutVProp for fixed axis","sha":"c81bad9a0d3ac312c53e0837e52d1b78523f82c017fdfba607f2d38d12c55451","nser":5,"src":"figure"},{"id":"FIG-ff1533a210ab4645","doc":"AUTOSAR_TR_GeneralBlueprintsSupplement","p":12,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"EXPLICIT_REFERENCE (deterministic citatio