{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01836","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SWCT_01836@rel:R25-11#7a9076bb","canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01836","release":"R25-11","content":"Attributes of CompositeRuleBasedValueSpecification Meta-class CompositeRuleBasedValueSpecification can be used to fulfill two distinct use cases: • Definition of a rule-based value specification for an array of composite data type based on the aggregation of CompositeValueSpecification in the role ar- gument . 23 Of course, this capability is restricted to ApplicationArrayDataType . On the level of Imple- mentationDataType , ValueSpecification s that reflect the structure of the respective Imple- mentationDataType are used. • Definition of a rule-based value specification for an array of Compound Prim- itive Data Type based on the aggregation of CompositeRuleBasedVal- ueArgument in the role compoundPrimitiveArgument .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_TPS_SoftwareComponentTemplate.pdf"},"recorded_at":"2026-10-01T09:59:17+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"7a9076bbbe7b4d969e6dd5517e9038533ff3b576f255552b00b3aecf296bce9d","removed":["471 of 1277 Document ID 62: AUTOSAR_CP_TPS_SoftwareComponentTemplate Software Component Template AUTOSAR CP R25-11"]},"text_key":"b07233f45fd9"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SWCT_01836","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R25-11"],"presence_only":[],"unchecked":["R18-10","R21-11","R22-11","R23-11","R24-11"]},"element":{"kind":"requirement","name":"","module":"SWCT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distin