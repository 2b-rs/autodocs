{"ok":true,"canonical_id":"AUTOSAR/CP/record/RS_TIMEX_00020","versions":[{"version_id":"AUTOSAR/CP/record/RS_TIMEX_00020@rel:R19-11#d5943d8c","canonical_id":"AUTOSAR/CP/record/RS_TIMEX_00020","release":"R19-11","content":"Support for events indicating variable accesses Type: valid Description: The Timing Extension shall provide means to reference the point-in-time when executable entities, namely runnable entities, access variables. Rationale: In some cases it is necessary to reference the point-in-time when executable entities access variable data and being capable to impose timing constraints on these timing description events. For example, in the VFB timing view an age constraint is imposed on the point-in-time a variable data prototype is received. But there may be several executable entities accessing such variable data, but some of those executable entities may have different age timing constraints. In order to avoid that such runnable entities are mapped to a task with a higher activation frequency than required, it would be good to annotate the specific variable access. Use Case: None Dependencies: [RS_TIMEX_00001] Supporting Material: None","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_RS_TimingExtensions.pdf"},"recorded_at":"2026-10-01T10:12:12+00:00","text_key":"9096b3547a3f"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/RS_TIMEX_00020","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"TIMEX","cluster":"","page":"","doc_type":"RS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures"