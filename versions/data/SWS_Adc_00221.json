{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_Adc_00221","versions":[{"canonical_id":"AUTOSAR/CP/record/SWS_Adc_00221","release":"R19-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Adc_00221","release":"R20-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Adc_00221","release":"R21-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"version_id":"AUTOSAR/CP/record/SWS_Adc_00221@rel:R22-11#689855bd","canonical_id":"AUTOSAR/CP/record/SWS_Adc_00221","release":"R22-11","content":"The function Adc_GetGroupStatus shall return ADC_IDLE: • If Adc_GetGroupStatus is called before the conversion of the requested group has been started • For groups with trigger source software: If Adc_GetGroupStatus is called after the conversion was stopped with Adc_StopGroupConversion • In continuous group conversion mode with linear streaming access mode: If Adc_ GetGroupStatus is called after calling Adc_GetStreamLastPointer (group was in state ADC_STREAM_COMPLETED while calling Adc_GetStreamLastPointer). • In continuous group conversion mode with linear streaming access mode: If Adc_ GetGroupStatus is called after calling Adc_ReadGroup (group was in state ADC_ STREAM_COMPLETED while calling Adc_ReadGroup). • In one-shot SW conversion mode: If Adc_GetGroupStatus is called after calling Adc_GetStreamLastPointer. • In one-shot SW conversion mode: If Adc_GetGroupStatus is called after calling Adc_ReadGroup. • For groups with trigger source hardware: If Adc_GetGroupStatus is called after calling Adc_DisableHardwareTrigger • For groups with trigger source hardware and linear streaming access mode: If Adc_GetGroupStatus is called after calling Adc_GetStreamLastPointer (group was in state ADC_STREAM_COMPLETED while calling Adc_GetStreamLast Pointer). • For groups with trigger source hardware and linear streaming access mode: If Adc_GetGroupStatus is called after calling Adc_ReadGroup (group was in state ADC_STREAM_COMPLETED while calling Adc_ReadGroup).","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_ADCDriver.pdf"},"recorded_at":"2026-10-01T10:13:30+00:00"},{"canonical_id":"AUTOSAR/CP/record/SWS_Adc_00221","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Adc_00221","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Adc_00221","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_Adc_00221","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R22-11"],"presence_only":["R19-11","R20-11","R21-11","R23-11","R24-11","R25-11"],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"Adc","cluster":"mcal","page":"","doc_type":"SWS","ai":false,"first":"R19-11","last":"R25-11","changed":[],"distinct":1},"evidence":{"figures":[{"id":"FIG-cfd1087cdadb01e6","doc":"AUTOSAR_SWS_ADC_Driver","p":38,"rel":[],"role":"heuristic","conf":0.9,"rt":"","m":"gemini-3.8-flash","why":"Return ADC_IDLE in stop/streaming modes","n":11,"cap":"Figure 12: State Diagram Conversion, SW Trigger, Streaming Access","sha":"cfd1087cdadb01e6ba09312411b757149e83c115b0273d9e43477e8d5f43bd71","nser":2,"src":"figure"},{"id":"FIG-049a2ea3cf6145fc","doc":"AUTOSAR_SWS_ADCDriver","p":44,"rel":[],"role":"heuristic","conf":0.85,"rt":"","m":"gemini-3.8-flash","why":"ADC_IDLE status transitions","n":10,"cap":"Figure 12: St