{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SYST_01101","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SYST_01101@rel:R19-11#cc3d63f5","canonical_id":"AUTOSAR/CP/record/TPS_SYST_01101","release":"R19-11","content":"TP routing using transport protocol modules In case that transport protocol modules are involved in the routing operation the incoming NPDU s need to be: • forwarded to corresponding inbound TP module and reassembled into an SDU (represented as IPdu ) • the SDU needs to be forwarded to the PduR • the PduR routes the SDU to the outgoing TP module • the outbound TP module segments the SDU into NPDU s which are then sent on the target bus.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:27+00:00","text_key":"90ee59ed1452"},{"version_id":"AUTOSAR/CP/record/TPS_SYST_01101@rel:R20-11#cc3d63f5","canonical_id":"AUTOSAR/CP/record/TPS_SYST_01101","release":"R20-11","content":"TP routing using transport protocol modules In case that transport protocol modules are involved in the routing operation the incoming NPDU s need to be: • forwarded to corresponding inbound TP module and reassembled into an SDU (represented as IPdu ) • the SDU needs to be forwarded to the PduR • the PduR routes the SDU to the outgoing TP module • the outbound TP module segments the SDU into NPDU s which are then sent on the target bus.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:47+00:00","text_key":"90ee59ed1452"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SYST_01101","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R20-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11","R20-11"],"presence_only":[],"unchecked":["R18-10","R21-