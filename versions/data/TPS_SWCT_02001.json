{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SWCT_02001","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SWCT_02001@rel:R19-11#32c2445d","canonical_id":"AUTOSAR/CP/record/TPS_SWCT_02001","release":"R19-11","content":"Values of SwAxisCont with the category COM_AXIS , RES_- AXIS are for display only In case of ApplicationValueSpecification s of category MAP , CUBOID , CUBE_4 , CUBE_5 , and CURVE it is possible that the SwAx- isCont of axes can be omitted if the axis is of category COM_AXIS or RES_AXIS . If SwAxisCont values exists in such cases for the axes these are for display purpose only because the related DataPrototype of the MAP , CUBOID , CUBE_4 , CUBE_- 5 , or CURVE does not hold the values of such axes. These are properties of the DataPrototype of the COM_AXIS or RES_AXIS .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SoftwareComponentTemplate.pdf"},"recorded_at":"2026-10-01T10:12:25+00:00","text_key":"d875afb1dcac"},{"version_id":"AUTOSAR/CP/record/TPS_SWCT_02001@rel:R20-11#32c2445d","canonical_id":"AUTOSAR/CP/record/TPS_SWCT_02001","release":"R20-11","content":"Values of SwAxisCont with the category COM_AXIS , RES_- AXIS are for display only In case of ApplicationValueSpecification s of category MAP , CUBOID , CUBE_4 , CUBE_5 , and CURVE it is possible that the SwAx- isCont of axes can be omitted if the axis is of category COM_AXIS or RES_AXIS . If SwAxisCont values exists in such cases for the axes these are for display purpose only because the related DataPrototype of the MAP , CUBOID , CUBE_4 , CUBE_- 5 , or CURVE does not hold the values of such axes. These are properties of the DataPrototype of the COM_AXIS or RES_AXIS .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SoftwareComponentTemplate.pdf"},"recorded_at":"2026-10-01T10:12:45+00:00","text_key":"d875afb1dcac"},{"version_id":"AUTOSAR/CP/record/TPS_SWCT_02001@rel:R25-11#f9c181dc","canonical_id":"AUTOSAR/CP/record/TPS_SWCT_02001","release":"R25-11","content":"Values of SwAxisCont with the category COM_AXIS , RES_ AXIS are for display only If an ApplicationValueSpecification sets attribute category to one of • CURVE • MAP • CUBOID • CUBE_4 • CUBE_5 it is possible that the SwAxisCont of axes can be omitted if the axis is of category COM_AXIS or RES_AXIS . If SwAxisCont values exists in such cases for the axes these are for display purpose only because the related DataPrototype of the MAP , CUBOID , CUBE_4 , CUBE_- 5 , or CURVE does not hold the values of such axes. These are properties of the DataPrototype of the COM_AXIS or RES_AXIS .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_TPS_SoftwareComponentTemplate.pdf"},"recorded_at":"2026-10-01T09:59:17+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"f9c181dc9e08b16a6e3e6ddccab2524524c31ad32c1a20d5aa34f5835c7d7374","removed":["453 of 1277 Document ID 62: AUTOSAR_CP_TPS_SoftwareComponentTemplate Software Component Template AUTOSAR CP R25-11"]},"text_key":"414dc874262d"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SWCT_02001","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11","R20-11","R25-11"],"presence_only":[],"unchecked":["R18-10","R21-11","R22-11","R23-11","R24-11"]},"element":{"kind":"requirement","name":"","module":"SWCT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R25-11","changed":["R25-11"],"distinct":2,"universe":"CP"},"evidence":{"figures":[{"id":"SNIP_CLASSIC_CAN_FIGURE_Figure_5_77","doc":"SoftwareComponentTemplate","p":471,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"values of SwAxisCont COM_AXIS display only","n":1,"cap":"Figure 5.77","sha":null,"nser":1,"src":"manifest"},{"id":"FIG-d59