{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_SecOC_00196","versions":[{"version_id":"AUTOSAR/CP/record/SWS_SecOC_00196@rel:R25-11#23a2ad5a","canonical_id":"AUTOSAR/CP/record/SWS_SecOC_00196","release":"R25-11","content":"Transmission Overflow Strategy Queue In case the SecOCTransmissionOverflowStrategy is set to QUEUE and SecOC is currently busy with the same Authentic I-PDU, the SecOC module shall additionally accept the Authentic I-PDU and queue it for a subsequent processing after previous processed Secured I-PDUs are finalized. In case the limit which is given by Sec- OCTransmissionQueueSize is reached any further transmission shall be rejected, SECOC_E_TX_QUEUE_OVERFLOW shall be reported to the DET module and the func- tion shall return with E_NOT_OK .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_SWS_SecureOnboardCommunication.pdf"},"recorded_at":"2026-10-15T00:03:11+00:00","text_key":"d8734e7a1add","rejoin":{"rule":"text-rejoin@1","e":[[356,2,""],[511,2,""]]}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_SecOC_00196","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R25-11"],"presence_only":[],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"SecOC","cluster":"security","page":"","doc_type":"SWS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[],"snippets":[],"cited_in":[],"cited_total":0},"upstream_trace":{"source":"classic-upstream/v1","releases":{"R25-11":[{"id":"SRS_SecOC_00021","doc":"AUTOSAR_FO_RS_SecureOnboardCommunication.pdf","doc_release":"R25-11","url":"https://www.autosar.org/fileadmin/standards/R25-11/FO/AUTOSAR_FO_RS_SecureOnboardCo