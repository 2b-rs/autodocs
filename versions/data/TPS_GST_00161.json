{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00161","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00161@rel:R19-11#285d6de2","canonical_id":"AUTOSAR/CP/record/TPS_GST_00161","release":"R19-11","content":"Definition of an instance ref Each instance ref is defined with respect to a base which is a classifier. What the instance ref does is specify a particular navigation leading from the root of any M0 instance of the base to an inner instance in the tree. One instance ref, i.e. one navigation, works for any M0 instance of the base. The navigation is specified via a series of context elements , which are features, and a target which is also a feature.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00161","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"GST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-4a8605b2880a902b","doc":"AUTOSAR_FO_TPS_GenericStructureTemplate","p":193,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"Instance ref definition and navigation","n":9,"cap":"Figure 5.8: Abstract instance Refs","sha":"4a8605b2880a902bff18932dd3485861ea3ff5339eee2f002a653776e0e35fdf","nser":3,"src":"figure"},{"id":"FIG-8ab59f3b0f1d4f0b","doc":"AUTOSAR_TPS_GenericStructureTemplate","p":117,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","wh