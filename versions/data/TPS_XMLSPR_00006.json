{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00006","versions":[{"version_id":"AUTOSAR/CP/record/TPS_XMLSPR_00006@rel:R19-11#ec2431ea","canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00006","release":"R19-11","content":"XML Schema production rule: reference to XML prede- fined data type Applies to class with stereotype primitive Precondition tagged value 'xml.xsd.type=...' or 'xml.mds.type=...' defined Target pattern: ... type=\"<%=typeXmlNsPrefix%>:<%=xmlXsdType%>\" ... Description: Each class with the stereotype primitive is represented by the xsd:simpleType that is defined by the tagged value 'xml.xsd.type' or 'xml.mds.type', unless a custom xsd:simpleType is defined by the tagged value 'xml.xsd.customType'. In the latter case rule XXX is applied. If xml.xsd.type is used, then the type is defined in the W3C xml schema and the typeXmlNsPrefix corresponds to \"xsd\". If xml.mds.type is used, then the type is defined in the namespace of the generated XML schema (\"AR\"). UML example: See Figure 5.8. XML schema example: The predefined W3C XML schema data type string is used to represent the primitive class String. XML instance example: <... type= \"xsd:string\" ...>","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_XMLSchemaProductionRules.pdf"},"recorded_at":"2026-10-01T10:12:16+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00006","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"XMLSPR","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1},"evidence":{"figures":[{"