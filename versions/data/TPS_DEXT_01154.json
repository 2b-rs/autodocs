{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_DEXT_01154","versions":[{"version_id":"AUTOSAR/CP/record/TPS_DEXT_01154@rel:R21-11#d330c2f7","canonical_id":"AUTOSAR/CP/record/TPS_DEXT_01154","release":"R21-11","content":"Semantics of meta-class DiagnosticAuthRole Meta-class DiagnosticAuthRole provides support for role-based authentication authentication. In particular, it supports the existence of different roles and the assignment of different rights (e.g. access a given DiagnosticDataIdentifier ) to any of these roles. The rights are defined in the form of a bitfield that is associated with a given role. In other words, the implementation of this roles and rights concept is that a bitfield is associated with a textual label (that describes the role).","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_DiagnosticExtractTemplate.pdf"},"recorded_at":"2026-10-01T10:13:09+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_DEXT_01154","is_dropped":false,"first_active_release":"R21-11","last_active_release":"R21-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R21-11"],"presence_only":[],"unchecked":["R18-10","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"DEXT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R21-11","last":"R21-11","changed":[],"distinct":1},"evidence":{"figures":[{"id":"FIG-637d11026e74e788","doc":"AUTOSAR_CP_TPS_DiagnosticExtractTemplate","p":76,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"DiagnosticAuthRole metaclass and bitfield rights","n":3,"cap":"Figure 5.4: Example “roles and rights” matrix","sha":"637d11026e74e788b5c7112c0fc9d281c608d1c47d0b7a62b545296f6f69c2ff","nser":5,"src":"figure"}],"snippets":[]}}