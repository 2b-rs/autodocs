{"ok":true,"canonical_id":"AUTOSAR/AP/record/RS_Main_00120","versions":[{"version_id":"AUTOSAR/AP/record/RS_Main_00120@rel:R20-11#23e34c23","canonical_id":"AUTOSAR/AP/record/RS_Main_00120","release":"R20-11","content":"AUTOSAR shall provide means to assure interoperability of AUTOSAR implementations (ICC1 level) on application level (RTE) and bus level Type: Valid Description: AUTOSAR shall provide specified test cases and t he essential test methodology to ensure interoperability on application (RTE side) and bus level for BSW on ICC1 level (Black Box Test). These specified test cases and its related methodology shall be developed to test implementations of AUTOSAR basic soft ware. Main Requirements Rationale: Acceptance tests are strongly needed to provide evidence that a product complies with the AUTOSAR specification i.e. to ensure a certain behavior of the regarded elements at the interfaces to application and communication busses. Use Ca se: Integration of the infrastructure SW into a specific ECU, bring it into the E/E - architecture without backlashes on the system. Example from real world: Integration of BSW stack (ICC1 level) to applications and the ECU infrastructure without difficulti es. Support test of any ICC implementations (from ICC1 to ICC3). Reuse of the same test specification even when the ICC3 specification details change Applies to: TC Dependencies: -- Supporting Material: -- Tested Items: --","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_RS_Main.pdf"},"recorded_at":"2026-09-30T23:27:08+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"23e34c2396670557d76fb151910e075c1356386992e05fdc3e8a6547806355b9","removed":["AUTOSAR FO R20 - 11 23 of 54 Document ID 54 : AUTOSAR_RS_Main"]},"text_key":"72de92027735"}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/RS_Main_00120","is_dropped":true,"first_active_release":"R20-11","last_active_release":"R20-11","dropped_in":["R21-11","R22-11","R23-11","R24-11","R25-11"],"first_dr