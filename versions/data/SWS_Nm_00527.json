{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_Nm_00527","versions":[{"version_id":"AUTOSAR/CP/record/SWS_Nm_00527@rel:R22-11#c834beb0","canonical_id":"AUTOSAR/CP/record/SWS_Nm_00527","release":"R22-11","content":"If NmSynchronizedPncShutdownEnabled is set to TRUE, PNC shutdown handling has been activated (refer to [SWS_Nm_00523]) and Nm_- PncBitVectorTxConfirmation is called with E_OK, then the Nm module shall consider those PNC IDs, stored as pending request for a synchronized PNC shut- down of the given NM-channel, as completed which were indicated by the given PNC bit vector (PNC bit set '1') and remove them from storage. Additionally, if NmPn- ShutdownMessageRetransmissionDuration is configured, then the Nm module shall cancel the retransmission timer for PN shutdown messages of the affected NM- channel.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_NetworkManagementInterface.pdf"},"recorded_at":"2026-10-01T10:13:32+00:00","text_key":"0d986b3ee401"},{"canonical_id":"AUTOSAR/CP/record/SWS_Nm_00527","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Nm_00527","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_Nm_00527","is_dropped":false,"first_active_release":"R22-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R22-11"],"presence_only":["R24-11","R25-11"],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"Nm","cluster":"","page":"","doc_type":"SWS","ai":false,"first":"R22-11","last":"R25-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-f0f0ac444b349aa7","