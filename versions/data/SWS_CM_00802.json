{"ok":true,"canonical_id":"AUTOSAR/AP/record/SWS_CM_00802","versions":[{"version_id":"AUTOSAR/AP/record/SWS_CM_00802@rel:R25-11#e10108da","canonical_id":"AUTOSAR/AP/record/SWS_CM_00802","release":"R25-11","content":"[SWS_CM_00802] Behavior of ara::com when unsubscribing from a trigger\n⌈\nAfter calling Unsubscribe() by ara::com at the proxy side, there shall be no active\nsubscription to the trigger and therefore no trigger shall be delivered to the application\n(i.e. no TriggerReceiveHandler shall be called). Calling Unsubscribe() shall\nset to zero the counter of received triggers returned by GetNewTriggers().\n⌋","meta":{"trigger_kind":"pdf_ingest_ap","rule":"ap-pdf-ingest@1","source_pdf":"AUTOSAR_AP_SWS_CommunicationManagement.pdf","source_page":434},"recorded_at":"2026-10-14T00:00:00+00:00","text_key":"0cde45690154","rejoin":{"rule":"text-rejoin@1","e":[[155,1," "],[246,1," "],[323,1," "]]}}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/SWS_CM_00802","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R25-11"],"presence_only":[],"unchecked":[]},"element":{"kind":"requirement","name":"","module":"CM","cluster":"","page":"","doc_type":"SWS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"AP"},"evidence":{"figures":[{"id":"FIG-fb6c208960db1b54","doc":"AUTOSAR_AP_EXP_SWArchitecture","p":52,"rel":[],"role":"heuristic","conf":0.6,"rt":"API_IMPLEMENTATION","m":"gemini-3.8-flash","why":"Trigger subscription cancellation behavior","n":4,"cap":"Figure 9.9: Interfaces for triggering state changes","sha":"fb6c208960db1b542e9a6063fd3846680372a66c1c365061e9e76e75b4476876","nser":3,"src":"figure"}],"snippets":[],"cited_in":[],"cited_total":0}}