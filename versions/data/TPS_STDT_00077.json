{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_STDT_00077","versions":[{"version_id":"AUTOSAR/CP/record/TPS_STDT_00077@rel:R19-11#39acfcb2","canonical_id":"AUTOSAR/CP/record/TPS_STDT_00077","release":"R19-11","content":"Blueprinting KeywordSet KeywordSet can be blueprinted. The following derivation rules apply: • No keywords may be removed from or added to the KeywordSet • The shortName of Keyword shall not be changed or extended • [TPS_STDT_00085] applies except that longName of Keyword shall not be changed, but it is allowed to add representations in further languages. • The abbrName shall not be changed or extended(AbbrName) • The classification of a Keyword shall not be changed but it is allowed to provide additional classification .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_StandardizationTemplate.pdf"},"recorded_at":"2026-10-01T10:12:16+00:00","text_key":"84a99daf771f"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_STDT_00077","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"STDT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-9701b1aaaa765b7d","doc":"AUTOSAR_EXP_AIUserGuide","p":34,"rel":[],"role":"heuristic","conf":0.85,"rt":"ARCHITECTURAL_CONTEXT","m":"gemini-3.8-flash","why":"Blueprinting KeywordSet and its derivation rules","n":3,"cap":"Figure 31: Class diagram for Keyword and KeywordSet","sha":"9701b1aaaa765b7dffecc1f2f9e6494382c00c40402fe8c55bb31fb124221cb9","nser":5,"src":"figure"},{"id":"FIG-bbcb8ff1de38217