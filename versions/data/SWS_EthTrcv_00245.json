{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_EthTrcv_00245","versions":[{"version_id":"AUTOSAR/CP/record/SWS_EthTrcv_00245@rel:R25-11#3f5da5ee","canonical_id":"AUTOSAR/CP/record/SWS_EthTrcv_00245","release":"R25-11","content":"Initialize PHYs with MACsec support, where MACsec func- tionality is disabled If EthTrcv_Init is called, then the EthTrcv driver shall consider the following points for initialization of the Ethernet hardware (PHY), where the corresponding EthTrcv- Config has EthTrcvMacSecEnabled is set to FALSE: • ignore all MACsec related configurations (e.g. EthTrcvMacSecBypassEther- Type s) • ensure to put the Ethernet hardware (PHY) to a state, where all Ethernet frames are handled without processing of MACsec functionality.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_SWS_EthernetTransceiverDriver.pdf"},"recorded_at":"2026-10-15T00:03:18+00:00","text_key":"134abea8ed30","rejoin":{"rule":"text-rejoin@1","e":[[54,2,""],[247,2,""],[377,1,""]]}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_EthTrcv_00245","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R25-11"],"presence_only":[],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"EthTrcv","cluster":"ethernet","page":"","doc_type":"SWS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[],"snippets":[],"cited_in":[],"cited_total":0},"upstream_trace":{"source":"classic-upstream/v1","releases":{"R25-11":[{"id":"FO_RS_MACsec_00002","doc":"AUTOSAR_FO_RS_MACsec.pdf","doc_release":"R25-11","url":"https://www.autosar.org/fileadmin/standards/R25-11/FO/AUTOSAR_FO_RS_MACsec.pdf#nameddest=FO_RS_MACsec_00002"}