{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_StbM_00528","versions":[{"version_id":"AUTOSAR/CP/record/SWS_StbM_00528@rel:R21-11#102db1bd","canonical_id":"AUTOSAR/CP/record/SWS_StbM_00528","release":"R21-11","content":"For Time Bases 16 to 31 each invocation of StbM_BusSetGlobalTime() shall update the Rx Time Tuple [TG Rx ; TV Rx ] as follows (refer to Figure 6 ) : 1. Retrieve the current Virtual Local Tim e value as TV sync 2. Calcu la te the time interval T FRD = TV Rx - TV sync based on the Local Virtual Time value of the Rx Time Tuple (TV Rx ) as provided by input parameter localTimePtr 3. Apply the current rate value of the Offset Time Base r = (r roc – 1) to the t ime interval T FRD 4. Add th e rate corrected interval r*T FRD to the Global Time of the Rx Time Tuple (TG Rx ) as provided by input parameter globalTimePtr The resulting Time Tuple [TG Rx + r*T FRD ; TV sync ] is denoted as Updated Rx Time Tuple [TG URx ; TV URx ] of the Offset Time Base.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_SynchronizedTimeBaseManager.pdf"},"recorded_at":"2026-10-01T10:13:10+00:00","text_key":"389c6ac82dc6"},{"canonical_id":"AUTOSAR/CP/record/SWS_StbM_00528","release":"R22-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_StbM_00528","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_StbM_00528","is_dropped":true,"first_active_release":"R21-11","last_active_release":"R23-11","dropped_in":["R24-11","R25-11"],"first_dropped_release":"R24-11","absent_before":["R19-11","R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R21-11"],"presence_only":["R22-11","R23-11"],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"StbM","cluster":