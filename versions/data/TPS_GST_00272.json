{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00272","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00272@rel:R19-11#7c2f74bb","canonical_id":"AUTOSAR/CP/record/TPS_GST_00272","release":"R19-11","content":"Semantics of BlueprintDerivationTime To support blueprints, the tag vh.latestBindingTime may have the value BluePrintDerivation- Time . Such a variation point may only be present in a blueprint and may not be copied to a system configuration. In this case, a variation point cannot have a swSysCond nor postbuildVariant- Condition (as defined by [constr_2558] in [2]) because the information contained in these fields cannot be processed at BluePrintDerivationTime . Similarly, the value an AttributeValueVariationPoint has no meaning in this case. Therefore it shall not be evaluated and the value shall be undefined .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00","text_key":"bc10819bff2d"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00272","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"GST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-13886479edc5d613","doc":"AUTOSAR_TPS_ManifestSpecification","p":101,"rel":[],"role":"heuristic","conf":0.8,"rt":"","m":"gemini-3.8-flash","why":"BlueprintDerivationTime latestBindingTime tag","n":5,"cap":"Figure 3.10: Modeling of ApplicationError on the AUTOSAR adaptive platform","sha":"13886479edc5d61399cb