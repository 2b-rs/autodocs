{"ok":true,"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02309","versions":[{"version_id":"AUTOSAR/AP/record/RS_CRYPTO_02309@rel:R25-11#8a8bd7a7","canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02309","release":"R25-11","content":"The Crypto Stack API shall support the run-time config- urable usage style Status: DRAFT Description: A consumer application should have a possibility to select concrete cryptographic primitives and find out all their properties at run-time. Rationale: In some use cases an application may not know in advance which concrete primitive it will use for data processing. For example this information can stay available after some “handshake” protocol execution only. Also the possibility to observe properties of currently used object or context is very useful for the application debugging. Dependencies: – Use Case: – Supporting Material: –","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_AP_RS_Cryptography.pdf"},"recorded_at":"2026-09-30T16:47:59+00:00","text_key":"9c13b0611914"}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02309","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"CRYPTO","cluster":"","page":"","doc_type":"RS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"AP"},"evidence":{"figures":[],"snippets":[{"id":"SNIP_crypto_AUTOSAR_AP_SWS_C_P103_181","doc":"AUTOSAR_AP_SWS_Cryptography","p":103,"rel":[],"role":"constitutive","conf":1.0,"rt":"","m":"gemini-3.8-flash","why":"Cites RS_CRYPTO_02309.","n":2,"x":"⌋ (RS_CRYPTO_02309) [SWS_CRYPT_20400] {DRAFT} Definition of API class ara::crypto::cryp::Crypto Context ⌈","src":"snippet"},{"id":"SNIP_crypto_AUTOSAR_AP_SWS_C