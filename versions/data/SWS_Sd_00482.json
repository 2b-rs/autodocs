{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00482","versions":[{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00482","release":"R19-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00482","release":"R20-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"version_id":"AUTOSAR/CP/record/SWS_Sd_00482@rel:R21-11#c60352cc","canonical_id":"AUTOSAR/CP/record/SWS_Sd_00482","release":"R21-11","content":"This chapter describes the interaction with the Socket Adaptor on how Service Discovery messages are received: 1. When the SocketAdaptor receives a Service Discovery message, the API Sd_Rx Indication() is called. 2. Using the indicated RxPduId, the associated SoConId for this SD Instance has to be determined. 3. Call API SoAd_GetRemoteAddr() with this SoConId. 4. Store address and message for further processing. 5. Reset the SoCon back to Wildcard using SoAd_ReleaseRemoteAddr() 6. The entries shall be processed exactly in the order they arrived. Please also refer to the sequence \"CLIENT/SERVER: Sd_RxIndication\" shown in Chapter 9.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_ServiceDiscovery.pdf"},"recorded_at":"2026-10-01T10:12:53+00:00"},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00482","release":"R22-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00482","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00482","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00482","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_0