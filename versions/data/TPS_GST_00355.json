{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00355","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00355@rel:R19-11#74e0455a","canonical_id":"AUTOSAR/CP/record/TPS_GST_00355","release":"R19-11","content":"Specialization of FormulaExpression These specializations represent three kinds of extensions: • The applicable operands are specified as associations in the subclasses (see [TPS_GST_00001] for more details). The valid reference in the grammar be- low are taken from the role names in the meta model. Maintaining the references as formal associations allows to retrieve dependencies even without parsing the formula expressions. • Additional functions are represented by the specialization and documented in the context of the same (see [TPS_GST_00293] for more details). It is not possible to extend the language by further operators. • The particular application constrains the expected result. E.g. in Attribute- ValueVariationPoint , the result is given by the type of the variant attribute. Another example is swSyscond which expects a boolean result.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00355","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"GST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"SNIP_CLASSIC_GENERICSTRUCTURETEMPLATE_FIGURE_Figure_4_6","doc":"GenericStructureTemplate","p":84,"rel