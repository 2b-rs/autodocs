{"ok":true,"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02002","versions":[{"version_id":"AUTOSAR/AP/record/RS_CRYPTO_02002@rel:R25-11#4a0df1ab","canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02002","release":"R25-11","content":"The Crypto Stack shall conceal asymmetric private keys from the users Status: DRAFT Description: There shall be no interfaces for the users to directly extract asymmetric private key values. Keys shall be addressed via identifiers by the users, preventing the key values disclosure. Rationale: If asymmetric private key values are available in the application at runtime it increases the risk of key compromise. If asymmetric private key values are stored in the application, centralized key management (e.g. renewal) is hard. Dependencies: – Use Case: Keys are stored in HSMs and never exposed in plain text. Supporting Material: –","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_AP_RS_Cryptography.pdf"},"recorded_at":"2026-09-30T16:47:59+00:00","text_key":"01cdcd99c679"}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02002","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"CRYPTO","cluster":"","page":"","doc_type":"RS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"AP"},"evidence":{"figures":[{"id":"FIG-569d6192adcb89c1","doc":"AUTOSAR_AP_TR_SystemTests","p":164,"rel":[],"role":"heuristic","conf":0.75,"rt":"","m":"gemini-3.8-flash","why":"Concealing asymmetric private keys from users","n":4,"cap":"Figure 15.3: Sequence diagram of STS_CRYPTO_00004.","sha":"569d6192adcb89c12369a602a66ba5e050d297b2cf111d9c11008b3ecacd9d18","nser":2,"src":"figure"},{"id":"SNIP_ADAPTIVE_CRYPT