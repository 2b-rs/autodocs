{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_STDT_00065","versions":[{"version_id":"AUTOSAR/CP/record/TPS_STDT_00065@rel:R19-11#666e549d","canonical_id":"AUTOSAR/CP/record/TPS_STDT_00065","release":"R19-11","content":"Nested Blueprint Can be Used as Blueprint of its own If spe- cialization of AtpBlueprint aggregates specialization of AtpBlueprint , then the such aggregated specialization of AtpBlueprint acts as a blueprint on its own and can be derived beyond the context of objects derived from the aggregating special- ization of AtpBlueprint . This definition allows to create blueprints which are not specializations of ARElement . In other words, If a blueprint contains blueprints, the \"inner\" blueprints can be derived independent from derived objects of the \"outer\" blueprint.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_StandardizationTemplate.pdf"},"recorded_at":"2026-10-01T10:12:16+00:00","text_key":"637a87b14098","rejoin":{"rule":"text-rejoin@1","e":[[59,2,""],[305,2,""]]}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_STDT_00065","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"STDT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-d541ccf781ab8ab7","doc":"AUTOSAR_TPS_StandardizationTemplate","p":38,"rel":[],"role":"heuristic","conf":0.8,"rt":"ARCHITECTURAL_CONTEXT","m":"gemini-3.8-flash","why":"Metamodel of AtpBlueprint and mappings","n":4,"cap":"Figure 3.2: Abstract Blueprint Structure","sha":"d541ccf781ab8ab7a90