_Com_02083 At any send request of a signal with ComTransferProperty TRIGGERED assigned to an I-PDU with ComTxModeMode DIRECT or MIXED , the AUTOSAR COM module shall immediately (within the next main function at the latest) initiate ComTxModeNum- berOfRepetitions plus one transmissions of the assigned I-PDU.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_SWS_COM.pdf"},"recorded_at":"2026-09-30T16:45:23+00:00"},{"version_id":"AUTOSAR/CP/record/SWS_Com_00129@rel:R25-11#dfa286ed","canonical_id":"AUTOSAR/CP/record/SWS_Com_00129","release":"R25-11","content":"Upstream requirements: SRS_BSW_00336 The AUTOSAR COM module’s function Com_DeInit shall stop all started I-PDU groups.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_SWS_COM.pdf"},"recorded_at":"2026-10-01T09:59:18+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_Com_00129","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R18-10"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R25-11"],"presence_only":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"unchecked":[]},"element":{"kind":"requirement","name":"","module":"Com","cluster":"com","page":"","doc_type":"SWS","ai":false,"first":"R19-11","last":"R25-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[],"snippets":[],"cited_in":[],"cited_total":0},"upstream_trace":{"source":"classic-upstream/v1","releases":{"R19-11":[{"id":"SRS_BSW_00336","doc":"AUTOSAR_SRS_BSWGeneral.pdf","doc_release":"R19-11","url":"https://www.autosar.org/fileadmin/standards/R19-11/CP/AUTOSAR_SRS_BSWGeneral.pdf#page=34"}],"R20-11":[{"id":"SRS_BSW_00336","doc":"AUTOSAR_SRS_BSWGeneral.pdf","doc_release":"R20-11","url":"https://www.autosar.org/fileadmin/standards/R20-11/CP/AUTOSAR_SRS_BSWGeneral.pdf#page=34"}],"R21-11":[