{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_STDT_00069","versions":[{"version_id":"AUTOSAR/CP/record/TPS_STDT_00069@rel:R19-11#19ea260c","canonical_id":"AUTOSAR/CP/record/TPS_STDT_00069","release":"R19-11","content":"Attributes of Keyword The meta-class Keyword is derived from Identifiable . The attributes of Identifiable shall be applied for Keyword as follows. shortName represents the unique name of the keyword. In the example above it would be “Cmft”. Note that this is used only for identifying the keyword. The contributed name part is taken from abbrName . longName represents the long form of the keyword, typically its an unabbreviated technical term. In the example above it would be “Comfort”. desc represents the definition of the keyword in terms of a verbal description allow- ing to identify whether the keyword applies for a specific case. In the example above the description would be “This keyword is used to express something as comfortable or convenient”. introduction represents a verbal description of a use case. This can be used for additional explanations or examples.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_StandardizationTemplate.pdf"},"recorded_at":"2026-10-01T10:12:16+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"19ea260c3d9bdb39ae13955842233534ed1ed3a394304f3853266108433d6386","removed":[],"replaced":["U+0093→“","U+0094→”"]},"text_key":"507c4269af0a"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_STDT_00069","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"STDT","cluster":"","page":"","doc_type":"TP