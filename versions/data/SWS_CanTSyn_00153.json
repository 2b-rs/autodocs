{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00153","versions":[{"version_id":"AUTOSAR/CP/record/SWS_CanTSyn_00153@rel:R21-11#6a751206","canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00153","release":"R21-11","content":"⌊ DRAFT g If • HW timestamping is enabled and • CanTSyn is using for internal time measurement a different time source as the StbM for Virtual Local Time, CanTSyn shall after successful capture of the egress timestamp (refer to [SWS_CanTSyn_00150]): 1. establish a protection against interruptions 2. read T currentTime_CAN via CanIf_GetCurrentTime , 3. read T1 VLT via StbM_GetCurrentVirtualLocalTime , 4. release the protection against interruptions and 5. calculate T4 = T0 SYNC_ns + (T1 VLT - T0 VLT ) - (T currentTime_CAN - T1 CAN )","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_TimeSyncOverCAN.pdf"},"recorded_at":"2026-10-01T10:13:12+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"6a7512063dd478c445abac7f812217168337acca7a6a44c4fd4a7d9ca2803f28","removed":["36 of 92 Document ID 674: AUTOSAR_SWS_TimeSyncOverCAN Specification of Time Synchronization over CAN AUTOSAR CP R21-11"]},"text_key":"33c831d0f09f"},{"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00153","release":"R22-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00153","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00153","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00153","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00153","is_dropped":false,"first_active_release":"R21-11","last_active_release":"R25-11","dropped_in":