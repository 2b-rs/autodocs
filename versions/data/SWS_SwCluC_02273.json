{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_SwCluC_02273","versions":[{"version_id":"AUTOSAR/CP/record/SWS_SwCluC_02273@rel:R21-11#0c8208e2","canonical_id":"AUTOSAR/CP/record/SWS_SwCluC_02273","release":"R21-11","content":"The Os Low Proxy shall create one RunnableEntity per configured SwCluCOsProxyOsTaskDispatcher container in the partition specific Service Software Component according [SWS_SwCluC_02272]. The EcucPartition is determined by the parameter SwCluCOsProxyEcucParti- tionRef , if configured or alternatively by the EcucPartition to which the related OsTask belongs. The attributes of the RunnableEntity shall be set as following: • minimumStartInterval is set to the parameter value SwCluCOsProxyMin- imumStartInterval • symbol is set to the name of the task dispatcher's C-function used for implemen- tation of [SWS_SwCluC_02270] • canBeInvokedConcurrently is set to false","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_SoftwareClusterConnection.pdf"},"recorded_at":"2026-10-01T10:13:11+00:00"},{"canonical_id":"AUTOSAR/CP/record/SWS_SwCluC_02273","release":"R22-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_SwCluC_02273","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_SwCluC_02273","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_SwCluC_02273","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_SwCluC_02273","is_dropped":false,"first_active_release":"R21-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-