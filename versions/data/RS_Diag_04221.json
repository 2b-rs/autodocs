{"ok":true,"canonical_id":"AUTOSAR/AP/record/RS_Diag_04221","versions":[{"version_id":"AUTOSAR/AP/record/RS_Diag_04221@rel:R25-11#59eddbfc","canonical_id":"AUTOSAR/AP/record/RS_Diag_04221","release":"R25-11","content":"In-Use-Monitor Performance Ratio indicates how often the OBD system monitors particular components, compared to the amount of the vehicle operation Description: The diagnostic in AUTOSARs shall provide a means to indicates how often the OBD system monitors particular components, compared to the amount of the vehicle operation.This is done through In-Use-Monitor Performance Ratio (IUMPR). It is defined as the number of times a fault could have been found (=numerator), divided by the number of times the vehicle operation conditions have been fulfilled (=denominator) as defined in the respective OBD regulations. Rationale: Supporting OBD use cases Use Case: Calculation of IUMPR for legal regulation AppliesTo: CP Dependencies: – Supporting Material: –","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_FO_RS_Diagnostics.pdf"},"recorded_at":"2026-09-30T16:47:59+00:00","text_key":"fe033602e5d1"}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/RS_Diag_04221","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"Diag","cluster":"","page":"","doc_type":"RS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"FO"},"evidence":{"figures":[{"id":"SNIP_CLASSIC_DEM_FIGURE_Figure_4_72","doc":"TPS_DiagnosticExtractTemplate","p":229,"rel":[],"role":"heuristic","conf":0.85,"rt":"EXPLAINS_RATIONALE","m":"gemini-3.8-flash","why":"IUMPR ratio calculation definition","n":5,"cap":"Figure 4.72","sha":null,"nser":1,"sr