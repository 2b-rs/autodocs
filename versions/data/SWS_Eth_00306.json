{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_Eth_00306","versions":[{"version_id":"AUTOSAR/CP/record/SWS_Eth_00306@rel:R22-11#5975a0e9","canonical_id":"AUTOSAR/CP/record/SWS_Eth_00306","release":"R22-11","content":"{DRAFT} SW queue shall be iterated and their credits account be updated in the following way and order: • Credits are only accumulated for SW queues which have at least one message queued inside them. Empty SW queues do not accumulate credits and their credits counter shall be set to 0. • Iterate through all SW queues, starting at the highest priority SW queue and descending, and add the amount of credits accumulated since the last Eth_MainFunction() call. The amount of credits accumulated is given by EthCtrl- ConfigEgressQueueCreditBasedShaperIdleSlope. • If a SW queue reaches EthCtrlConfigQueueCreditBasedShaperMaxCredit then the credit accumulation shall stop at that point and the next SW queue in the row is handled.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_EthernetDriver.pdf"},"recorded_at":"2026-10-01T10:13:28+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"5975a0e96ca46d1183bee47651b5f8f870721fad4caf2848af8e5003da835f2d","removed":["26 of 117 Document ID 430: AUTOSAR_SWS_EthernetDriver Specification of Ethernet Driver AUTOSAR CP R22-11"]},"text_key":"1a33599b1855"},{"canonical_id":"AUTOSAR/CP/record/SWS_Eth_00306","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Eth_00306","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_Eth_00306","is_dropped":true,"first_active_release":"R22-11","last_active_release":"R24-11","dropped_in":["R25-11"],"first_dropped_release":"R25-11","absent_before":["R19-11","R20-11","R21-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R