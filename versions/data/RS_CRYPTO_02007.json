{"ok":true,"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02007","versions":[{"version_id":"AUTOSAR/AP/record/RS_CRYPTO_02007@rel:R25-11#5340ca99","canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02007","release":"R25-11","content":"The Crypto Stack shall provide means for secure handling of “secret seeds” Status: DRAFT Description: The Crypto stack shall provide interfaces for saving, loading, importing and exporting of secret seeds. Rationale: The “secret seed” can represent some key material that cannot be directly loaded to a key input of some transformation, but it is used for derivation of concrete “slave” keys. Also the secret seed can be used for loading to a “non-key” input (like salt / nonce / initialization vector) of some cryptographic transformation, but specific application can need to keep it in secret too. For such secret objects the Crypto Stack shall support protection measures similar to the keys. Disclosure of the secret seeds can lead to compromising of whole crypto protocol. Dependencies: – Use Case: – Supporting Material: –","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_AP_RS_Cryptography.pdf"},"recorded_at":"2026-09-30T16:47:59+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02007","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"CRYPTO","cluster":"","page":"","doc_type":"RS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1},"evidence":{"figures":[{"id":"SNIP_ADAPTIVE_CRYPTO_FIGURE_Figure_9_61","doc":"EXP_SWArchitecture","p":108,"rel":[],"role":"heuristic","conf":0.7,"rt":"","m":"gemini-3.8-flash","why":"Handling and derivation from secret seeds","n":6,"cap":"Figure 9.61","