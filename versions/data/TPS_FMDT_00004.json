{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_FMDT_00004","versions":[{"version_id":"AUTOSAR/CP/record/TPS_FMDT_00004@rel:R19-11#d2d0b0ef","canonical_id":"AUTOSAR/CP/record/TPS_FMDT_00004","release":"R19-11","content":"Definition of Feature Model A Feature Model describes the available features of a product line and their in- terrelations / interdependencies. In other words, a Feature Model describes a Product Line Model in the problem domain. For example, a car may have either a gasoline or a diesel engine, so the fea- tures Gasoline and Diesel are alternatives. A seven-seat configuration of a car might require air conditioning, so the feature Seven Seats requires the feature Air Conditioning . A Feature Model is usually paired with a Product Line Model.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_FeatureModelExchangeFormat.pdf"},"recorded_at":"2026-10-01T10:12:12+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"d2d0b0efb814184f5879983e8c7c9d0aa8cd540a682dc888c9c731d3ad4858e6","removed":["16 of 85  AUTOSAR CONFIDENTIAL  Document ID 606: AUTOSAR_TPS_FeatureModelExchangeFormat AUTOSAR Feature Model Exchange Format AUTOSAR CP R19-11"]},"text_key":"96fa2cc3ec9b"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_FMDT_00004","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"FMDT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-1bcc2bd3f28b2e6a","doc":"AUTOSAR_TPS_FeatureModelExchangeFormat","p":11,"rel":[],"role":"const