{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_SoAd_00637","versions":[{"canonical_id":"AUTOSAR/CP/record/SWS_SoAd_00637","release":"R19-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_SoAd_00637","release":"R20-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"version_id":"AUTOSAR/CP/record/SWS_SoAd_00637@rel:R21-11#1785ff2f","canonical_id":"AUTOSAR/CP/record/SWS_SoAd_00637","release":"R21-11","content":"SoAd shall perform the following actions within SoAd_Main- Function () to close a socket connection: 1. Terminate active TP sessions (if any) and notify the upper layer about the termi- nation 2. Disable further transmission or reception for this socket connection, i.e. new transmit requests shall be rejected with E_NOT_OK and received messages shall simply be discarded. 3. Close related TcpIp sockets 4. Change the state of the socket connection to SOAD_SOCON_OFFLINE if clos- ing of the socket connection results from a SoAd_CloseSoCon () request or to SOAD_SOCON_RECONNECT otherwise.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_SocketAdaptor.pdf"},"recorded_at":"2026-10-01T10:12:50+00:00"},{"canonical_id":"AUTOSAR/CP/record/SWS_SoAd_00637","release":"R22-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_SoAd_00637","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_SoAd_00637","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_SoAd_00637","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_SoAd_00637","is_dropped":false,"first_ac