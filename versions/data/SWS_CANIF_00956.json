{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_CANIF_00956","versions":[{"version_id":"AUTOSAR/CP/record/SWS_CANIF_00956@rel:R22-11#56388558","canonical_id":"AUTOSAR/CP/record/SWS_CANIF_00956","release":"R22-11","content":"In case more than one CanIfRxPduCfg matches a received frame according to the rules set up by [SWS_CANIF_00951] and [SWS_CANIF_00952], a matched parameter of CanIfRxPduXLParams shall always be preferred over an unavailable configuration parameter. The matching shall then be executed in the following sequence: 1. SDU Type 2. Acceptance Field 3. VCID 4. Priority ID A match in a preceding element of this list shall always be preferred over a match in a following element, i.e. the look-up shall be executed based on an ordered list based on this sequence.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_CANInterface.pdf"},"recorded_at":"2026-10-01T10:13:20+00:00"},{"canonical_id":"AUTOSAR/CP/record/SWS_CANIF_00956","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_CANIF_00956","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_CANIF_00956","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_CANIF_00956","is_dropped":false,"first_active_release":"R22-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R22-11"],"presence_only":["R23-11","R24-11","R25-11"],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"CANIF","cluster":"can","page":"","doc_type":"SWS","ai":false,"first":"R22-11","last":"