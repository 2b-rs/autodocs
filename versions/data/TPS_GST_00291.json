{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00291","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00291@rel:R19-11#e03b147a","canonical_id":"AUTOSAR/CP/record/TPS_GST_00291","release":"R19-11","content":"UML-tags for Configuration of XML schema production UML- Tags with the name xml. * relate to the XML serialization of AUTOSAR models. They basically do not influence the semantics of an M1 model, but ensure that the XML serialization can be controlled by the meta model. They also provide means to tweak the schema such that backwards compatibility of the schema can be ensured while the meta model evolves. For more details how to apply these tags and about the impact of these tags, refer to chapter \"4 Configuration of XML schema production\" in [3].","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:14+00:00","text_key":"398fe8553543"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00291","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"GST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-581edd1d18fc500f","doc":"AUTOSAR_InteroperabilityAuthoringTools","p":25,"rel":[],"role":"heuristic","conf":0.8,"rt":"","m":"gemini-3.8-flash","why":"UML-tags configuration for XML schema production","n":3,"cap":"","sha":null,"nser":0,"src":"matrix"},{"id":"FIG-5ffedbac21aea893","doc":"AUTOSAR_AP_TPS_MachineConfiguration","p":10,"rel":[],"role":"heuristic","conf":0.8,"rt"