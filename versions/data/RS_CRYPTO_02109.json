{"ok":true,"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02109","versions":[{"version_id":"AUTOSAR/AP/record/RS_CRYPTO_02109@rel:R25-11#eab4f980","canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02109","release":"R25-11","content":"The Crypto Stack shall support interfaces for a unified Machine-wide storage and retrieval of different crypto objects Status: DRAFT Description: A wide range of hardware (e.g. HSM/TPM/SHE based) and/or software based (e.g. encrypted files) can be supported for secure storage and retrieval of different crypto objects (e.g. keys, certificates, digests, etc.). Therefore, a unified Machine-wide access to all these different storage providers abstracts physical details about storage handling and reduces complexity of cooperative usage of different crypto objects by applications. Rationale: A few trusted applications can have a need to use some keys (or other crypto objects) cooperatively while applications’ access rights to the crypto object slots needs to be controlled. A logically centralized crypto object storage handling can facilitate these scenarios conveniently.. Dependencies: – Use Case: – Supporting Material: –","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_AP_RS_Cryptography.pdf"},"recorded_at":"2026-09-30T16:47:59+00:00","text_key":"c2f0c72b45e3"}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02109","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"CRYPTO","cluster":"","page":"","doc_type":"RS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"AP"},"evidence":{"figures":[{"id":"FIG-1645707e16e96c7a","doc":"AUTOSAR_AP_SWS_Cryptography","p":38,"rel":[],"role":