{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_E2EXf_00213","versions":[{"version_id":"AUTOSAR/CP/record/SWS_E2EXf_00213@rel:R25-11#24aaf0ca","canonical_id":"AUTOSAR/CP/record/SWS_E2EXf_00213","release":"R25-11","content":"Reporting e2eCounterError or timeout The diagnostic event for counter error (e2eCounterError) or timeout error (e2eTimeoutError) shall be triggered based on the following logic: • The DEM event with most entries of that failure in WindowSize shall be reported. – E2E_P_REPEATED and E2E_P_WRONGSEQUENCE increment entries for counter error. – E2E_P_NONEWDATA increment entries for timeout error. • In case of an equal number of message counter and timeout failures a timeout DTC shall be reported.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_SWS_E2ETransformer.pdf"},"recorded_at":"2026-10-15T00:03:10+00:00","text_key":"f49250b5b179"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_E2EXf_00213","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R25-11"],"presence_only":[],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"E2EXf","cluster":"com","page":"","doc_type":"SWS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[],"snippets":[],"cited_in":[],"cited_total":0},"upstream_trace":{"source":"classic-upstream/v1","releases":{"R25-11":[{"id":"RS_E2E_08538","record":true}]}}}