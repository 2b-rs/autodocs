{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02294","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SYST_02294@rel:R20-11#a67376d3","canonical_id":"AUTOSAR/CP/record/TPS_SYST_02294","release":"R20-11","content":"Serialization of ServiceInterface s using ComBased- Transformer If the ComBasedTransformer is used to serialize the members of a ServiceInterface , then • the SenderReceiverToSignalGroupMapping is used to map the Vari- ableDataPrototype that represents an Event or Field Notifier to a SystemSignalGroup . Please note that the datatype of an Event is a Struc- ture as described above. Each primitive member of this Structure is mapped by the SenderRecRecordElementMapping to a SystemSignal in the System- SignalGroup . The SystemSignalGroup is mapped as ISignalGroup into an ISignalIPdu that is transported over the network. • the serialization of Method s, Field Setter s, Field Getter s by the Com- BasedTransformer is not supported.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:48+00:00","text_key":"0b9c3597b7ac"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02294","is_dropped":false,"first_active_release":"R20-11","last_active_release":"R20-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R20-11"],"presence_only":[],"unchecked":["R18-10","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"SYST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R20-11","last":"R20-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"SNIP_ADAPTIVE_PLATFORM_FIGURE_Figure_9_13_MANIFESTSPECIFICATION","doc":"TPS_ManifestSpecification","p":482,"rel":[],"role":"heuristic","conf":0.9,"rt":"","m":"gemini-3.8-flash","why":"Serialization of Se