{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00756","versions":[{"version_id":"AUTOSAR/CP/record/SWS_Sd_00756@rel:R21-11#f29e6f08","canonical_id":"AUTOSAR/CP/record/SWS_Sd_00756","release":"R21-11","content":"The ports shall be used for the events and notification events as well. • When using UDP the server uses the announced port as source port. • With TCP the client shall check the status of the socket connection by calling SoAd_GetSoConMode(). Calling this API has to provide SOAD_SOCON_ON- LINE state for at the dedicated socket connection. In addition, if a secure port was selected, an security association needs to be estab- lished before sending the subscription. Otherwise events and notification events can neither be sent secure ports nor received.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_ServiceDiscovery.pdf"},"recorded_at":"2026-10-01T10:12:53+00:00","text_key":"16ee74a119a5"},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00756","release":"R22-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00756","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00756","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00756","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00756","is_dropped":false,"first_active_release":"R21-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R21-11"],"presence_only":["R22-11","R23-11","R24-11","R25-11