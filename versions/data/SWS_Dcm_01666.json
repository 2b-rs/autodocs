{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_Dcm_01666","versions":[{"version_id":"AUTOSAR/CP/record/SWS_Dcm_01666@rel:R23-11#13c75d39","canonical_id":"AUTOSAR/CP/record/SWS_Dcm_01666","release":"R23-11","content":"[SWS_Dcm_01666]\nConcurrent tester present support ⌈The Dcm shall handle\nand process the Concurrent TesterPresent according to ISO14229-1 [1].⌋(RS_-\nDiag_04249)\nIn addition to ISO14229-1 [1] the Dcm limits the processing for received Concurrent\nTesterPresent messages to the connection from where the request to enter a non-\ndefault session was received. This avoids that a tester that did not request the non-\ndefault session can influence the protocol and timing behavior of another tester.","meta":{"source_pdf":"SWS_DiagnosticCommunicationManager.pdf","source_page":58,"trigger_kind":"snippet_ingest"},"recorded_at":"2026-10-04T00:00:00+00:00"},{"canonical_id":"AUTOSAR/CP/record/SWS_Dcm_01666","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Dcm_01666","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_Dcm_01666","is_dropped":false,"first_active_release":"R23-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R23-11"],"presence_only":["R24-11","R25-11"],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"Dcm","cluster":"diagnostics","page":"","doc_type":"SWS","ai":false,"first":"R23-11","last":"R25-11","changed":[],"distinct":1},"evidence":{"figures":[],"snippets":[{"id":"SNIP_CLASSIC_DCM_SECTION_7_4_4_3_Concurrent_TesterPresent_keep_alive_logic","doc":"SWS_DiagnosticCommunicationManager","p":58