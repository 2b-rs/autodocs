{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00148","versions":[{"version_id":"AUTOSAR/CP/record/SWS_CanTSyn_00148@rel:R21-11#494fd6ff","canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00148","release":"R21-11","content":"⌊ DRAFT g If • HW timestamping is enabled and • CanTSyn is using for internal time measurement a different time source as the StbM for Virtual Local Time, CanTSyn shall after successful capture of T4 (refer to [SWS_CanTSyn_00145]): 1. establish a protection against interruptions 2. retrieve current time from CAN controller HW value via CanIf_GetCurrent- Time as T3 CAN , 3. capture the current Virtual Local Time via StbM_GetCurrentVirtualLocal- Time from StbM as T3 VLT 4. release the protection against interruptions 5. calculate T2 VLT = T3 VLT - (T3 CAN - T2 CAN ), 6. calculate TL Sync = (T0 + T4) + (T3 CAN - T2 CAN )","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_TimeSyncOverCAN.pdf"},"recorded_at":"2026-10-01T10:13:12+00:00","text_key":"88a0f348ed39"},{"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00148","release":"R22-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00148","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00148","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00148","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_CanTSyn_00148","is_dropped":false,"first_active_release":"R21-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"la