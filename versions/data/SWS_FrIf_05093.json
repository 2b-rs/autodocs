{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05093","versions":[{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05093","release":"R19-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05093","release":"R20-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05093","release":"R21-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"version_id":"AUTOSAR/CP/record/SWS_FrIf_05093@rel:R22-11#e8ef24a4","canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05093","release":"R22-11","content":"In case the parameter 'FrIfAllowDynamicLSduLength' (see Fr If06049) is set to true for the associated frame triggering, the FrIf module passes the actual used L-PDU length to the driver (Fr_TransmitTxLPdu()), taking into account the following parameters for each PDU: - the position of the PDU within the L-PDU - the position of the update-bit information (if configured) If FrIfImmediate equals TRUE, the actual length of the respective PDU shall be as passed via FrIf_Transmit(). If FrIfImmediate equals FALSE, the actual length of the respective PDU shall be as passed via <UL_TriggerTransmit>()","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_FlexRayInterface.pdf"},"recorded_at":"2026-10-01T10:13:26+00:00","text_key":"b12c36d836d0"},{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05093","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05093","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_FrIf_05093","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_Fr