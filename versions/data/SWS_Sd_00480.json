{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00480","versions":[{"version_id":"AUTOSAR/CP/record/SWS_Sd_00480@rel:R21-11#f0e97a26","canonical_id":"AUTOSAR/CP/record/SWS_Sd_00480","release":"R21-11","content":"This chapter describes the interaction with the Socket Adaptor module to send Service Discovery messages: 1. Precondition: Service Discovery message is assembled 2. In case the message shall be sent via unicast: - Call the Socket Adaptor's API SoAd_SetRemoteAddr 3. In case the message shall be sent via multicast: - Call the API SoAd_SetRemoteAddr to set the destination 4. Call SoAd_IfTransmit() to send the message on the bus Please also refer to the sequence \"CLIENT/SERVER: TransmitSdMessage\" shown in Chapter 9.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_ServiceDiscovery.pdf"},"recorded_at":"2026-10-01T10:12:53+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_Sd_00480","is_dropped":true,"first_active_release":"R21-11","last_active_release":"R21-11","dropped_in":["R22-11","R25-11"],"first_dropped_release":"R22-11","absent_before":["R18-10","R19-11","R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"Sd","cluster":"","page":"","doc_type":"SWS","ai":false,"first":"R21-11","last":"R21-11","changed":[],"distinct":1},"evidence":{"figures":[{"id":"FIG-790b6f794efcd246","doc":"AUTOSAR_SWS_ServiceDiscovery","p":94,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"Sd transmission sequence calling SoAd APIs","n":2,"cap":"Figure 9.7: Sequence CLIENT/SERVER: TransmitSdMessage","sha":"790b6f794efcd2464620b46efbbaded695a28b1c0cb994747ac223d2707aa92b","nser":1,"src":"figure"},{"id":"FIG-ff4bf4fcdbea177f","doc":"AUTOSAR_SWS_ServiceDiscovery","p":113,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"TransmitSdMessage sequence with SoAd interaction",