{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_SomeIpTp_00009","versions":[{"version_id":"AUTOSAR/CP/record/SWS_SomeIpTp_00009@rel:R21-11#99d9c078","canonical_id":"AUTOSAR/CP/record/SWS_SomeIpTp_00009","release":"R21-11","content":"If the provided SDU fits into one single PDU, the provided SOME/IP header shall be used with no modification. If the provided SDU does not fit into one single SOME/IP PDU, the SOME/IP TP module shall set the TP-Flag of the Message Type to '1' for every SOME/IP segment which is going to be sent on the bus via the PduR. All the other bits contained in the Message Type field shall stay untouched.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_SOMEIPTransportProtocol.pdf"},"recorded_at":"2026-10-01T10:12:50+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_SomeIpTp_00009","is_dropped":true,"first_active_release":"R21-11","last_active_release":"R21-11","dropped_in":["R22-11","R25-11"],"first_dropped_release":"R22-11","absent_before":["R18-10","R19-11","R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"SomeIpTp","cluster":"","page":"","doc_type":"SWS","ai":false,"first":"R21-11","last":"R21-11","changed":[],"distinct":1},"evidence":{"figures":[{"id":"FIG-97b6c7f00c2b3c25","doc":"AUTOSAR_FO_PRS_SOMEIPProtocol","p":50,"rel":[],"role":"heuristic","conf":0.9,"rt":"","m":"gemini-3.8-flash","why":"SOME/IP-TP TP-Flag setting in Message Type","n":3,"cap":"Figure 4.18: Example: Overview of relevant SOME/IP TP headers","sha":"97b6c7f00c2b3c25955e6e28e34ca108a8ae96d9488d39a450bbfccf5e1c9bd5","nser":1,"src":"figure"},{"id":"FIG-9d1444d7ebccf1e8","doc":"AUTOSAR_CP_SWS_SOMEIPTransportProtocol","p":14,"rel":[],"role":"heuristic","conf":0.9,"rt":"","m":"gemini-3.8-flash","why":"TP-Flag in Message Type field for SOME/IP TP","n":4,"cap":"Figure 7.2: SOME/IP TP header","sha":"9d1444d7ebccf1e82cb4375a99cb4