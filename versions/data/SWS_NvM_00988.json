{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_NvM_00988","versions":[{"version_id":"AUTOSAR/CP/record/SWS_NvM_00988@rel:R25-11#e04ef90b","canonical_id":"AUTOSAR/CP/record/SWS_NvM_00988","release":"R25-11","content":"The write verification failed. Diagnostic Event (Error Name) NVM_E_VERIFY_FAILED Description If, after a successfully finished write, the verification for the written data fails. Failed condition Fail condition: NVM_E_VERIFY_FAILED is reported by the NvM module if, after a successful write, the write verification indicates failure and the configured number of retries has expired. Passed condition Pass condition: when requirement SWS_NvM_00867 does not apply, meaning that the write verification indicates success, the latest for the last retry attempt.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_SWS_NVRAMManager.pdf"},"recorded_at":"2026-10-15T00:03:19+00:00","text_key":"9fd85fc3b627"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_NvM_00988","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R25-11"],"presence_only":[],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"NvM","cluster":"memory","page":"","doc_type":"SWS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[],"snippets":[],"cited_in":[],"cited_total":0},"upstream_trace":{"source":"classic-upstream/v1","releases":{"R25-11":[{"id":"SRS_BSW_00458","doc":"AUTOSAR_CP_RS_BSWGeneral.pdf","doc_release":"R25-11","url":"https://www.autosar.org/fileadmin/standards/R25-11/CP/AUTOSAR_CP_RS_BSWGeneral.pdf#nameddest=SRS_BSW_00458"}]}}}