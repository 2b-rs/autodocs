{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00417","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00417@rel:R19-11#4616ebbb","canonical_id":"AUTOSAR/CP/record/TPS_GST_00417","release":"R19-11","content":"Merging of splitable elements from partial models The following rules apply for the merging of splitable elements from partial models: – If the upper multiplicity of a splitable property in the variant-rich model is > 1, then M1 elements with the same identity according to [TPS_GST_00047] are merged. M1 Elements with different identity or without identity are not merged, i.e. they are just copied to the output collection. – If the upper multiplicity of a splitable property in the varaint-rich model is 1, then M1 elements with different identity lead to a multiplicity conflict. M1 elements with the same identity according to [TPS_GST_00047] or without identity are merged. After binding the variation, the multiplicities shall match the multiplicities of the pure meta model.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"4616ebbbabbc301b5d763371e9ded60ea211816d981d7f8d3b2525aba4d2e3d2","removed":["269 of 497  AUTOSAR CONFIDENTIAL  Document ID 202: AUTOSAR_TPS_GenericStructureTemplate Generic Structure Template AUTOSAR CP R19-11"],"replaced":["U+0096→–"]},"text_key":"a837853fcda0"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00417","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"GST","cluster":"",