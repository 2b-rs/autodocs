{"ok":true,"canonical_id":"AUTOSAR/AP/record/SWS_PER_00049","versions":[{"version_id":"AUTOSAR/AP/record/SWS_PER_00049@rel:R25-11#2fe64153","canonical_id":"AUTOSAR/AP/record/SWS_PER_00049","release":"R25-11","content":"function SyncToStorage [SWS_PER_00049] Upstream: RS_PER_00002 , RS_AP_00119 , RS_AP_00120 , RS_AP_00127 , RS_AP_00128 , RS_AP_00129 , RS_AP_00135 , RS_AP_00139 , RS_AP_00159 ara::core::Result &lt; void &gt; SyncToStorage () noexcept; Flushes changed key-value pairs of the Key-Value Storage to the physical storage. SyncToStorage may be delayed by an ongoing call from another thread to RemoveAllKeys, DiscardPendingChanges, SetValue, RemoveKey, RecoverKey, or ResetKey. Header-Datei #include \"ara/per/key_value_storage.h\" class mono Scope class ara::per::KeyValueStorage class mono Exception-Sicherheit exception safe class mono Thread-Sicherheit thread-safe PerErrc ::kIllegalWrite rollback_semantics class mono Rückgabewert th Typ th Beschreibung td ara::core::Result &lt; void &gt; td A Result of void. In case of an error, it contains any of the errors defined below, or a vendor specific error. Fehler th Fehlercode th Beschreibung td Access td Returned if the Key-Value Storage is configured as read- only, or if it is configured as write-only-once and the key already exists. td PerErrc ::kPhysicalStorageFailure td no_rollback_semantics Returned if access to the physical storage fails. td PerErrc ::kIntegrityCorrupted td rollback_semantics Returned if stored data cannot be written because the structural integrity is corrupted. td PerErrc ::kEncryptionFailed td rollback_semantics Returned if the encryption of stored data fails. td PerErrc ::kOutOfStorageSpace td no_rollback_semantics Returned if the available physical storage space is insufficient for the added/changed values. td PerErrc ::kQuotaExceeded td rollback_semantics Returned if the added/changed values would exceed the configured maximumAllowedSize of the Key-Value Storage. td PerErrc ::kAuthenticationFailed td rollback_semantics Returned if calculating the MAC of stored data fails.","meta":{"trigger_kind":"baseline_sync"},"recorded_at":"2026-09-30T16:43:34+00:00","text_key":"489a1e771bdb"}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/SWS_PER_00049","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"function","name":"SyncToStorage","module":"PER","cluster":"","page":"classes/cl_ara_per_KeyValueStorage_e55123.html","doc_type":"SWS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"AP"},"evidence":{"figures":[{"id":"FIG-a7fb203ed1bcd70a","doc":"AUTOSAR_EXP_SWArchitecture","p":157,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"SyncToStorage flushes changes to physical storage","n":6,"cap":"","sha":null,"nser":0,"src":"matrix"},{"id":"FIG-ac91624831463dd9","doc":"AUTOSAR_AP_SWS_UpdateAndConfigurationManagement","p":18,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"SyncToStorage method of KeyValueStorage","n":16,"cap":"","sha":null,"nser":0,"src":"matrix"},{"id":"FIG-b045d30e3c97fa76","doc":"AUTOSAR_AP_EXP_SWArchitecture","p":90,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"SyncToStorage API in KeyValueStorage","n":16,"cap":"","sha":null,"nser":0,"src":"matrix"},{"id":"FIG-67a0c9934f8b513a","doc":"AUTOSAR_AP_EXP_SWArchitecture","p":55,"rel":[],"role":"heuristic","conf":0.9,"rt":"","m":"gemini-3.8-flash","why":"KeyValueStorage SyncToStorage method","n":14,"cap":"","sha":null,"nser":0,"src":"matrix"},{"id":"FIG-77e485cbe4c2b9bb","doc":"AUTOSAR_AP_EXP_SWArchitecture","p":230,"rel":[],"role":"heuristic","conf":0.9,"rt":"","m":"gemini-3.8-flash","why":