{"ok":true,"canonical_id":"AUTOSAR/AP/record/RS_CM_00006","versions":[{"version_id":"AUTOSAR/AP/record/RS_CM_00006@rel:R25-11#03fbbafe","canonical_id":"AUTOSAR/AP/record/RS_CM_00006","release":"R25-11","content":"Support of IEEE1722 Stream ACF Message handling Status: DRAFT Description: ACF messages of an IEEE1722 stream with subtype set to NTSCF or TSCF shall be available via signal / service translation for an application. Rationale: ACF Encapsulated bus frames (e.g. CAN, LIN) need to be processed by signal / service translation to provide data as event to the application. AP ECUs need to be able to monitor bus frames. Dependencies: RS_CM_00004 ▽ △ Use Case: An AP application of a high performance ECU receive events via S2S which are transported as ACF encapsulated bus frames (e.g. CAN, LIN) within an zonal automotive network Supporting Material: [4, IEEE1722]","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_AP_RS_CommunicationManagement.pdf"},"recorded_at":"2026-09-30T16:47:59+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"03fbbafe9d471b4d99153f79e736edeafb2e1903ca0ecdd6d11a61b193aeff45","removed":["12 of 36 Document ID 716: AUTOSAR_AP_RS_CommunicationManagement Requirements on Communication Management AUTOSAR AP R25-11"]},"text_key":"6ce8fa077636"}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/RS_CM_00006","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"CM","cluster":"","page":"","doc_type":"RS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"AP"},"evidence":{"figures":[{"id":"FIG-835f7d6c3d290fa2","doc":"AUTOSAR_AP_TPS_ManifestSpecification","p":463,"rel":[],"role":"constitut