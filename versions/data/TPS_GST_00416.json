{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00416","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00416@rel:R19-11#dfd34bf9","canonical_id":"AUTOSAR/CP/record/TPS_GST_00416","release":"R19-11","content":"Rules for the definition of a splitkey at M2 level The splitkey of a splitable property shall consist of the following parts: • The attribute(s) which define(s) the identity of the aggregated or associated type, in particular: – shortName , if the aggregated type is a Referrable , – shortLabel , ident.shortName , definition , or other special at- tributes, if the identity of the aggregated type is based on special attributes, – role name of the association, if the splitable property is a reference to an- other element, – role name of the splitable property (name of instance reference) plus the role names of all sub-references, if the splitable property is an instance reference to another element • variationPoint.shortLabel , if the splitable property is stereotyped with atpVariation • The role name of the splitable property, if the aggregated type does not have attributes which define the identity.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"dfd34bf9a95689baea03bc710f61c7fc9ebe3f5698dc862113d64a419773d4b3","removed":["267 of 497  AUTOSAR CONFIDENTIAL  Document ID 202: AUTOSAR_TPS_GenericStructureTemplate Generic Structure Template AUTOSAR CP R19-11"],"replaced":["U+0096→–"]},"text_key":"62f56bcb4571","rejoin":{"rule":"text-rejoin@1","e":[[347,2,""],[508,2,""]]}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00416","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","te