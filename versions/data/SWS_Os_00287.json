{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_Os_00287","versions":[{"canonical_id":"AUTOSAR/CP/record/SWS_Os_00287","release":"R19-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Os_00287","release":"R20-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"version_id":"AUTOSAR/CP/record/SWS_Os_00287@rel:R21-11#f868eeaa","canonical_id":"AUTOSAR/CP/record/SWS_Os_00287","release":"R21-11","content":"If the parameters in a call of TerminateApplication are valid and the above criteria are met TerminateApplication shall terminate <Applica- tion> (i.e. to kill all Task s, disable the interrupt sources of those ISR s which belong to the OS-Application and free all other OS resources associated with the applica- tion) AND shall activate the configured OsRestartTask of <Application> if <Restart Option> equals RESTART . If no OsRestartTask is configured, no restart shall hap- pen. If the <Application> is restarted, its state is set to APPLICATION_RESTARTING otherwise to APPLICATION_TERMINATED . If the caller belongs to <Application> Ter- minateApplication shall not return, otherwise it shall return E_OK .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_OS.pdf"},"recorded_at":"2026-10-01T10:12:54+00:00","text_key":"f28533438600"},{"canonical_id":"AUTOSAR/CP/record/SWS_Os_00287","release":"R22-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Os_00287","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_Os_00287","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"version_id":"AUTOSAR/CP/record/SWS_Os_00287@rel:R25-11#21d46515","canonical_id":"AUTOSAR/CP/record/SWS_Os_00287","release":"R25-11","content":"Upstream requirements: SRS_Os_11022 If the parameters in a call of TerminateApplication are valid and the above cri- teria are met TerminateApplication shall terminate <Application> (i.e. to kill all Task s, disable the interrupt sources of those ISR s which belong to the OS-Application and free all other OS resources associated with the application). The <Application> state is set to APPLICATION_TERMINATED . If the caller belongs to <Application> TerminateApplication shall not return, otherwise it shall return E_OK .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_CP_SWS_OS.pdf"},"recorded_at":"2026-10-01T09:59:19+00:00","text_key":"c99da8a0b08d"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_Os_00287","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R21-11","R25-11"],"presence_only":["R19-11","R20-11","R22-11","R23-11","R24-11"],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"Os","cluster":"system","page":"","doc_type":"SWS","ai":false,"first":"R19-11","last":"R25-11","changed":["R25-11"],"distinct":2,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-35e66df38f78d52c","doc":"AUTOSAR_SWS_OS","p":59,"rel":[],"role":"heuristic","conf":0.9,"rt":"","m":"gemini-3.8-flash","why":"TerminateApplication sets APPLICATION_TERMINATED state","n":4,"cap":"Figure 7.13: States of OS-Applications","sha":"35e66df38f78d52cd8d4803286a528aeb122a7a615b443e9dbcb62e3ea622f8e","nser":7,"src":"figure"},{"id":"FIG-3fb6ef215106fad6","doc":"AUTOSAR_EXP_ApplicationLevelErrorHandling","p":61,"rel":[],"role":"heuristic","conf":0.9,"rt":"","m":"gemini-3.8-flash","why":"TerminateApplication transitions application to APPLICATION_TERMINATED","n":6,"cap":"Figure 2: OS-Application State Machine","sha":"3fb6ef215106fad62497e57047ce60fb83b2ae5f1d92a9bad7121dfd45ce132d","nser":4,"src":"figure"},{"id":"FIG-84f869a9baf42ac1","doc":"AUTOSAR_EXP_ApplicationLevelErrorHandling","p":75,"rel":[],"role":"heuristic","conf":0.8,"rt":"","m":"gemini-3.8-flash","why":"TerminateApplication behavior and cleanup","n":7,"cap":"Figure 4: Sequence diagram showing the interactions when terminating or restarting a partition.","sha":"84f869a9baf42ac14a2d53d09ede91f298f79763d0669741bc042bc6c605899b","nser":3,"src":"figure"}],"snippets":[{"id":"SNIP_CLASSIC_OS_SECTION_2_ISR_application_specific_error_hook_belongs_This_is_an_OS_Application_level_variant","doc":"SWS_OS","p":62,"rel":[],"role":"heuristic","conf":0.85,"rt":"","m":"gemini-3.8-flash","why":"TerminateApplication behavior and application state","n":9,"x":"2 ISR/application specific error hook belongs. (This is an OS-Application level variant of the TerminateTask service) The Operating System provides the service TerminateApplication (see [SWS_Os_00258…","src":"manifest"}],"cited_in":[],"cited_total":0},"upstream_trace":{"source":"classic-upstream/v1","releases":{"R19-11":[],"R20-11":[],"R21-11":[],"R22-11":[{"id":"SRS_Os_11023","doc":"AUTOSAR_SRS_OS.pdf","doc_release":"R22-11","url":"https://www.autosar.org/fileadmin/standards/R22-11/CP/AUTOSAR_SRS_OS.pdf#nameddest=SRS_Os_11023"}],"R23-11":[{"id":"SRS_Os_11023","doc":"AUTOSAR_CP_SRS_OS.pdf","doc_release":"R23-11","url":"https://www.autosar.org/fileadmin/standards/R23-11/CP/AUTOSAR_CP_SRS_OS.pdf#nameddest=SRS_Os_11023"}],"R24-11":null,"R25-11":[{"id":"SRS_Os_11022","doc":"AUTOSAR_CP_RS_OS.pdf","doc_release":"R25-11","url":"https://www.autosar.org/fileadmin/standards/R25-11/CP/AUTOSAR_CP_RS_OS.pdf#nameddest=SRS_Os_11022"}]}}}