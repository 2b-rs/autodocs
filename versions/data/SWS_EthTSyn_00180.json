{"ok":true,"canonical_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180","versions":[{"version_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180@rel:R19-11#8ca5a689","canonical_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180","release":"R19-11","content":"On invocation of EthTSyn_RxIndication and if EthTSynHardwareTimestampSupport ( ECUC_EthTSyn_00018 : ) is set to FALSE the following sequence shall be applied: 1. Immediately establish a protection against interruptions and run the next step directly afterwards: 2. Retrieve the reference time T1 VLT for t he Sync message via StbM _GetCurrent VirtualLocal Time () f rom the StbM 3. The protection against interruptions may be removed now","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_TimeSyncOverEthernet.pdf"},"recorded_at":"2026-10-01T10:12:23+00:00","text_key":"b8142bf9a1aa"},{"version_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180@rel:R20-11#8ca5a689","canonical_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180","release":"R20-11","content":"On invocation of EthTSyn_RxIndication and if EthTSynHardwareTimestampSupport ( ECUC_EthTSyn_00018 : ) is set to FALSE the following sequence shall be applied: 1. Immediately establish a protection against interruptions and run the next step directly afterwards: 2. Retrieve the reference time T1 VLT for t he Sync message via StbM _GetCurrent VirtualLocal Time () f rom the StbM 3. The protection against interruptions may be removed now","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_TimeSyncOverEthernet.pdf"},"recorded_at":"2026-10-01T10:12:42+00:00","text_key":"b8142bf9a1aa"},{"version_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180@rel:R21-11#4251070d","canonical_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180","release":"R21-11","content":"On invocation of EthTSyn_RxIndication and if EthT- SynHardwareTimestampSupport is set to FALSE the following sequence shall be applied: • Immediately establish a protection against interruptions and run the next step directly afterwards: • Retrieve the reference time T1 V LT for the Sync message via StbM_GetCur- rentVirtualLocalTime from the StbM • The protection against interruptions may be removed now. The T2 V LT part of the Rx Time Tuple shall be set to the value of T1 V LT (i.e., T2 V LT = T1 V LT ). The Sync reception delay T SRD shall be set to 0.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_SWS_TimeSyncOverEthernet.pdf"},"recorded_at":"2026-10-01T10:13:08+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"4251070dc6c0603c947651f7ed9d34d81ac86c9767bd7f0335a8eab6ba46d7ab","removed":["27 of 87 Document ID 676: AUTOSAR_SWS_TimeSyncOverEthernet Specification of Time Synchronization over Ethernet AUTOSAR CP R21-11"]},"text_key":"6e292f830a4e"},{"canonical_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180","release":"R22-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180","release":"R23-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180","release":"R24-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}},{"canonical_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180","release":"R25-11","text_captured":false,"meta":{"trigger_kind":"pdf_presence","source":"classic_upstream"}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/SWS_EthTSyn_00180","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11","R20-11","R21-11"],"presence_only":["R22-11","R23-11","R24-11","R25-11"],"unchecked":["R18-10"]},"element":{"kind":"requirement","name":"","module":"EthTSyn","cluster":"","page":"","doc_type":"SWS","ai":false,"first":"R19-11","last"