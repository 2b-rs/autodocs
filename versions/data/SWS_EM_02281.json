{"ok":true,"canonical_id":"AUTOSAR/AP/record/SWS_EM_02281","versions":[{"version_id":"AUTOSAR/AP/record/SWS_EM_02281@rel:R25-11#24bf4c2a","canonical_id":"AUTOSAR/AP/record/SWS_EM_02281","release":"R25-11","content":"enumeration ExecErrc [SWS_EM_02281] Upstream: RS_AP_00130 , RS_AP_00122 , RS_AP_00127 , RS_AP_00154 , RS_AP_00125 , RS_AP_00142 , RS_AP_00129 , RS_AP_00149 enum class ExecErrc : ara::core::ErrorDomain::CodeType {...}; Defines an enumeration class for the Execution Management error codes. Header-Datei #include \"ara/exec/exec_error_domain.h\" class mono Forwarding-Header #include \"ara/exec/exec_fwd.h\" class mono Scope namespace ara::exec class mono Symbol ExecErrc class mono Basistyp ara::core::ErrorDomain::CodeType class mono Werte th Enumerator th Beschreibung td kNoCommunication td =3 Communication error occurred, e.g. request cannot be send or result cannot be retrieved td kInvalidMetaModelIdentifier td =4 Wrong meta model identifier passed to a function td kOperationCanceled td =5 Transition to the requested Function Group state was canceled by a newer request td kOperationFailed td =6 Requested operation could not be performed, e.g. Function Group state transition cannot be finished because kRunning was not reported on time td kInvalidTransition td =9 Invalid transition (e.g. Process attempted to report kRunning, when it was already in a Running Process State) td kIntegrityOrAuthenticityCheckFailed td = 14 Integrity or authenticity check for a Process to be spawned in the requested Function Group state failed td kUnexpectedTermination td = 15 Abnormal Termination during a Function Group State transition occurred td kInvalidArgument td = 16 Passed argument doesn’t appear to be valid. Hinweise: If a kNoCommunication occurs at Execution Management or State Management level (or communication between both), the system may need to enter an Unrecoverable State. The internal mechanisms can detect this issue in the moment that a communication attempt occurs. This is not the case for applications that are using the interface of the ara::exec :: ExecutionClient or ara::exec::StateClient - they eventually get a communication error in the moment of the API use, i.e. possibly after the actual error occurrence. However, this is not problematic as the recovery options are limited from a client side viewpoint.","meta":{"trigger_kind":"baseline_sync"},"recorded_at":"2026-09-30T16:43:34+00:00","text_key":"d84dd42f6ed4"}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/SWS_EM_02281","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"enumeration","name":"ExecErrc","module":"EM","cluster":"","page":"namespaces/ns_exec_ara_exec_a73810.html","doc_type":"SWS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"AP"},"evidence":{"figures":[],"snippets":[{"id":"SNIP_exec_AUTOSAR_AP_SWS_E_P195_492","doc":"AUTOSAR_AP_SWS_ExecutionManagement","p":195,"rel":[],"role":"constitutive","conf":1.0,"rt":"","m":"gemini-3.8-flash","why":"Definition of ExecErrc enum","n":1,"x":"Definition of API enum ara::exec::ExecErrc","src":"snippet"},{"id":"SNIP_exec_AUTOSAR_AP_SWS_E_P132_290","doc":"AUTOSAR_AP_SWS_ExecutionManagement","p":132,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"Defines ExecErrc enumeration including kMetaModelError","n":1,"x":"ara::exec::ExecErrc::k MetaModelError","src":"snippet"},{"id":"SNIP_exec_AUTOSAR_AP_SWS_E_P136_303","doc":"AUTOSAR_AP_SWS_ExecutionManagement","p":136,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"Defines ExecErrc enumeration including kMetaModelError","n":1,"x":"ara::exec::ExecErrc::k MetaModelError","src":"snippet"},{"id":"SNIP_e