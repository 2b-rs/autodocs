{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_DEXT_01052","versions":[{"version_id":"AUTOSAR/CP/record/TPS_DEXT_01052@rel:R19-11#b51f1b3d","canonical_id":"AUTOSAR/CP/record/TPS_DEXT_01052","release":"R19-11","content":"Existence of attribute DiagnosticServiceInstance . ac- cessPermission Regarding the existence of the attribute DiagnosticService- Instance . accessPermission the following rules apply: • If neither the attribute DiagnosticServiceInstance . accessPermission or DiagnosticServiceClass . accessPermission exist it is assumed that the configuration is incomplete as no access permission is defined. • If either the attribute DiagnosticServiceInstance . accessPermission or DiagnosticServiceClass . accessPermission exists but does not have fur- ther references to DiagnosticSession , DiagnosticEnvironmentalCon- dition , or DiagnosticSecurityLevel then this means that the affected di- agnostic services can be executed in any diagnostic session or security level. In other words, no restriction applies.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_DiagnosticExtractTemplate.pdf"},"recorded_at":"2026-10-01T10:12:24+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_DEXT_01052","is_dropped":true,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":["R20-11","R21-11"],"first_dropped_release":"R20-11","absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"DEXT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1},"evidence":{"figures":[{"id":"FIG-8eabae574863d69b","doc":"AUTOSAR_TPS_DiagnosticExtractTemplate","p":68,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"Diagnosti