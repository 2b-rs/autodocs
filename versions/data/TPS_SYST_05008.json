{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SYST_05008","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SYST_05008@rel:R19-11#59abd3e5","canonical_id":"AUTOSAR/CP/record/TPS_SYST_05008","release":"R19-11","content":"Semantics of a GlobalTimeGateway In order to achieve the flow of information between a GlobalTimeSlave of a given GlobalTimeDomain to the GlobalTimeMaster of another GlobalTimeDomain , it is necessary to establish the existence of a so-called GlobalTimeGateway . In terms of functionality, a GlobalTimeGateway complements the functionality of the underlying Gateway such that, on top of the mere routing from one Communication- Cluster to another, the time information is actively updated in the process of passing it from one GlobalTimeDomain to the other.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:27+00:00","text_key":"67702f28e442"},{"version_id":"AUTOSAR/CP/record/TPS_SYST_05008@rel:R20-11#59abd3e5","canonical_id":"AUTOSAR/CP/record/TPS_SYST_05008","release":"R20-11","content":"Semantics of a GlobalTimeGateway In order to achieve the flow of information between a GlobalTimeSlave of a given GlobalTimeDomain to the GlobalTimeMaster of another GlobalTimeDomain , it is necessary to establish the existence of a so-called GlobalTimeGateway . In terms of functionality, a GlobalTimeGateway complements the functionality of the underlying Gateway such that, on top of the mere routing from one Communication- Cluster to another, the time information is actively updated in the process of passing it from one GlobalTimeDomain to the other.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:48+00:00","text_key":"67702f28e442"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SYST_05008","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R20-11","dropped_in":[],"first_dropped_release":n