{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02309","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SYST_02309@rel:R20-11#414241b6","canonical_id":"AUTOSAR/CP/record/TPS_SYST_02309","release":"R20-11","content":"RTE fan-out support for a SystemSignalGroup The RTE fan-out (signal fan-out) from a SystemSignalGroup to multiple ISignalGroup s is enabled in the System Description if the following conditions apply: • several ISignalGroup s reference the SystemSignalGroup in the role sys- temSignalGroup and • a DataMapping references the SystemSignalGroup and • the DataMapping references an element in a PPortPrototype and • each of the contained ISignal s of the ISignalGroup refers to its correspond- ing SystemSignal which in turn is part of the SystemSignalGroup and • the ISignalGroup s are transmitted by the EcuInstance on which the RTE is running, i.e. an ISignalTriggering exists that references the ISig- nalGroup in the role iSignalGroup and references a ISignalPort of the EcuInstance with communicationDirection out .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:47+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02309","is_dropped":true,"first_active_release":"R20-11","last_active_release":"R20-11","dropped_in":["R21-11","R22-11","R25-11"],"first_dropped_release":"R21-11","absent_before":["R18-10","R19-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"SYST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R20-11","last":"R20-11","changed":[],"distinct":1},"evidence":{"figures":[{"id":"FIG-8e9769ed9cfc2867","doc":"AUTOSAR_TPS_SystemTemplate","p":204,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"RTE fan-out support for SystemSignalGroup","n":5,"cap":"Figure 6.5: ISignal example","sha":"8e9769ed9cfc28672