{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02309","versions":[{"version_id":"AUTOSAR/CP/record/TPS_SYST_02309@rel:R20-11#414241b6","canonical_id":"AUTOSAR/CP/record/TPS_SYST_02309","release":"R20-11","content":"RTE fan-out support for a SystemSignalGroup The RTE fan-out (signal fan-out) from a SystemSignalGroup to multiple ISignalGroup s is enabled in the System Description if the following conditions apply: • several ISignalGroup s reference the SystemSignalGroup in the role sys- temSignalGroup and • a DataMapping references the SystemSignalGroup and • the DataMapping references an element in a PPortPrototype and • each of the contained ISignal s of the ISignalGroup refers to its correspond- ing SystemSignal which in turn is part of the SystemSignalGroup and • the ISignalGroup s are transmitted by the EcuInstance on which the RTE is running, i.e. an ISignalTriggering exists that references the ISig- nalGroup in the role iSignalGroup and references a ISignalPort of the EcuInstance with communicationDirection out .","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_SystemTemplate.pdf"},"recorded_at":"2026-10-01T10:12:47+00:00","text_key":"3fc1276324f0","rejoin":{"rule":"text-rejoin@1","e":[[126,1,""],[223,1,""],[273,2,""],[442,1,""],[489,2,""],[577,1,""],[701,2,""]]}}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_SYST_02309","is_dropped":false,"first_active_release":"R20-11","last_active_release":"R20-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R20-11"],"presence_only":[],"unchecked":["R18-10","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"SYST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R20-11","last":"R20-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FI