{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00005","versions":[{"version_id":"AUTOSAR/CP/record/TPS_XMLSPR_00005@rel:R19-11#70552a86","canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00005","release":"R19-11","content":"XML Schema production rule: global xsd:element Applies to Class Precondition xml.globalElement=true Target pattern: <xsd:element name= \"<%=typeXmlName%>\" type= \"<% typeXmlNsPrefix%>:<%=typeXmlName%>\" /> Description: If the class is marked by the tagged value 'xml.globalElement=true' then a global xsd:element is created. The name of the xsd:element is defined by the XML-name of the class and the type is defined by the xsd:complexType which was defined by [TPS_XMLSPR_00003]. The namespace prefix is defined by the tagged value 'xml.nsPrefix'. UML example: See Figure 5.7. XML schema example: <xsd:element name= \"AUTOSAR\" type= \"AR:AUTOSAR\" /> 5 53 of 90  AUTOSAR CONFIDENTIAL  Document ID 122: AUTOSAR_TPS_XMLSchemaProductionRules AUTOSAR XML Schema Production Rules AUTOSAR CP R19-11 4 XML instance example: <AUTOSAR> ... </AUTOSAR>","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_XMLSchemaProductionRules.pdf"},"recorded_at":"2026-10-01T10:12:16+00:00"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00005","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"XMLSPR","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-22ac6b3d52397e0e","doc":"AUTOSAR_FO_TPS_XMLSchemaProductionRules","p":47,"rel":[],"role":"co