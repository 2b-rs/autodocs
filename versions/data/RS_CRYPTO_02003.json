{"ok":true,"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02003","versions":[{"version_id":"AUTOSAR/AP/record/RS_CRYPTO_02003@rel:R25-11#39002b89","canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02003","release":"R25-11","content":"The Crypto Stack shall support management of non- persistent session/ephemeral keys during their lifetime Status: DRAFT Description: Some cryptographic keys are only used for a single message or communication session. These keys are referred to as “session keys” (usually for short-term symmetric keys) or “ephemeral keys” (for ephemeral public/private keys in asymmetric key-agreement protocols). The Crypto Stack shall support secure handling of session/ephemeral keys during their lifetime. Rationale: The session/ephemeral keys are required for secure implementation of multiple cryptographic protocols. Session/ephemeral keys should not occupy persistent slots due to their transient nature. Dependencies: – Use Case: – Supporting Material: –","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_AP_RS_Cryptography.pdf"},"recorded_at":"2026-09-30T16:47:59+00:00","text_key":"e52fd8b4d749"}],"lifecycle":{"canonical_id":"AUTOSAR/AP/record/RS_CRYPTO_02003","is_dropped":false,"first_active_release":"R25-11","last_active_release":"R25-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11"],"platform_releases":["R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11"},"element":{"kind":"requirement","name":"","module":"CRYPTO","cluster":"","page":"","doc_type":"RS","ai":false,"first":"R25-11","last":"R25-11","changed":[],"distinct":1,"universe":"AP"},"evidence":{"figures":[{"id":"FIG-060529d09186b4b7","doc":"AUTOSAR_FO_RS_MACsec","p":12,"rel":[],"role":"heuristic","conf":0.7,"rt":"","m":"gemini-3.8-flash","why":"Session and ephemeral key lifetime management","n":3,"cap":"Figure 4.2: MACsec Key Agreement sequence with pre-shared key","sha"