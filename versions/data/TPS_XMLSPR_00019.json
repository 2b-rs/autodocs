{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00019","versions":[{"version_id":"AUTOSAR/CP/record/TPS_XMLSPR_00019@rel:R19-11#adde1e7d","canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00019","release":"R19-11","content":"XML Schema production rule: xsd:attribute Applies to: Property Precondition: xml.attribute=true upper multiplicity of property = 1 Target pattern: <xsd:attribute name= \"<%=xmlName%>\" type= \"<%=typeXmlNsPrefix %>:<%=typeXmlName%>\" <% if lowerMultiplicity > 0 { %> use=\"required\" <% } else { %> use=\"optional\" <% } %> /> Description: An xsd:attribute is created for each property with the tagged value ' xml.attribute=true '. The name of the xsd:attribute is defined by the XML name of the represented property. If the lower multiplicity of the property is bigger than 0 then the use of the attribute is required, otherwise it is optional. UML example: See Figure 5.11. XML schema example: <xsd:attribute name= \"UUID\" type= \"xsd:string\" use= \"optional\" /> XML instance example: <... UUID= \"12343-23342-12345-2333\" />","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_XMLSchemaProductionRules.pdf"},"recorded_at":"2026-10-01T10:12:16+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"adde1e7d560b4f8f55484950430271d2101b5ec55ebe855801064e4efd6f6d19","removed":["57 of 90  AUTOSAR CONFIDENTIAL  Document ID 122: AUTOSAR_TPS_XMLSchemaProductionRules AUTOSAR XML Schema Production Rules AUTOSAR CP R19-11"]},"text_key":"4a1628c9c03c"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00019","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirem