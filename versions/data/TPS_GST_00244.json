{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_GST_00244","versions":[{"version_id":"AUTOSAR/CP/record/TPS_GST_00244@rel:R19-11#55d4becd","canonical_id":"AUTOSAR/CP/record/TPS_GST_00244","release":"R19-11","content":"Viability Period of Life Cycle Info The viability of LifeCycle- Info can be restricted for a specific period of time by periodBegin respectively periodEnd . The following items apply: • If no periodBegin is provided then defaultPeriodBegin applies. • If no periodEnd is provided then defaultPeriodEnd applies. • If also no defaultPeriodBegin respectively defaultPeriodEnd is specified then the period is unlimited (e.g. from 2013-01-01 until forever). • Begin and End are considered to be included in the period. Thus at a given point in time t the definitions of LifeCycleInfo is viable if periodBegin < = t < = periodEnd","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_GenericStructureTemplate.pdf"},"recorded_at":"2026-10-01T10:12:15+00:00","text_key":"368dcd336aa1"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_GST_00244","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"GST","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-c818b756db3f0387","doc":"AUTOSAR_TPS_GenericStructureTemplate","p":357,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"LifeCyclePeriod periodBegin and periodEnd attributes","n":6,"cap":"Figure 11.1: Definition of Life Cycles","sha":"c818b756db3f03873d0de996c8d4dfd56d322c2