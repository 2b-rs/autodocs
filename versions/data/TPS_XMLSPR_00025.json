{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00025","versions":[{"version_id":"AUTOSAR/CP/record/TPS_XMLSPR_00025@rel:R19-11#07c76c8f","canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00025","release":"R19-11","content":"XML Schema production rule: enumeration of subtypes Applies to Class Precondition Class is referenced Target pattern: <xsd:simpleType name= \"<%=xmlName%>--SUBTYPES-ENUM\" > <xsd:restriction base= \"xsd:string\" > <% for type and all subtypes { %> <xsd:enumeration value= \"<%=typeXmlName%>\" /> <%} // for type and all subtypes %> </xsd:restriction> </xsd:simpleType> Description: Creates an enumeration which represents the XML names of the class and all its subtypes. This enumeration is required for describing potential destination types of references. UML example: See Figure 5.16. XML schema example: <xsd:element name= \"B--SUBTYPES-ENUM\" > <xsd:restriction base= \"xsd:string\" > <xsd:enumeration value= \"B-1\" /> <xsd:enumeration value= \"B-2\" /> </restriction> </xsd:element> XML instance example: <THE-B-REF DEST= \"B-1\" > /shortname </THE-B-REF>","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_XMLSchemaProductionRules.pdf"},"recorded_at":"2026-10-01T10:12:16+00:00","text_key":"af2b80a6356b"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_XMLSPR_00025","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"XMLSPR","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-22ac6b3d52397e0e","doc":"AUTOSAR_FO_TPS_XMLSchemaP