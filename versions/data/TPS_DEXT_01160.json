{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_DEXT_01160","versions":[{"version_id":"AUTOSAR/CP/record/TPS_DEXT_01160@rel:R21-11#16b688df","canonical_id":"AUTOSAR/CP/record/TPS_DEXT_01160","release":"R21-11","content":"⌊ DRAFT g Semantics of the reference DiagnosticMapping . providerSoftwareCluster In early stages of the design of a CP Software Clus- ter, it is possible to express the relevance of a given DiagnosticMapping for a spe- cific CpSoftwareCluster that is not yet on a level of detail such that the Diagnos- ticMapping would be able to refer to the final target of the mapping on the side of the application software. For this purpose, the reference in the role DiagnosticMapping . providerSoft- wareCluster can be used to refer to a CP Software Cluster in a providing role. Conversely, the reference in the role DiagnosticMapping . requesterSoft- wareCluster can be used to refer to a CP Software Cluster in a requesting role.","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_DiagnosticExtractTemplate.pdf"},"recorded_at":"2026-10-01T10:13:09+00:00","text_key":"3bcd67d1d751"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_DEXT_01160","is_dropped":false,"first_active_release":"R21-11","last_active_release":"R21-11","dropped_in":[],"first_dropped_release":null,"absent_before":["R19-11","R20-11"],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R21-11"],"presence_only":[],"unchecked":["R18-10","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"DEXT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R21-11","last":"R21-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-bf83090228e0d14e","doc":"AUTOSAR_TPS_DiagnosticExtractTemplate","p":241,"rel":[],"role":"heuristic","conf":0.9,"rt":"API_IMPLEMENTATION","m":"gemini-3.8-flash","why":"Reference DiagnosticMapping provi