{"ok":true,"canonical_id":"AUTOSAR/CP/record/TPS_FMDT_00005","versions":[{"version_id":"AUTOSAR/CP/record/TPS_FMDT_00005@rel:R19-11#e40c7188","canonical_id":"AUTOSAR/CP/record/TPS_FMDT_00005","release":"R19-11","content":"Definition of Product Model A Product Model describes a product. A Product Model does not contain varia- tion points anymore (except for PostBuild variation points). It is derived from the Product Line Model by “binding” the variation points. In AUTOSAR, a Product Model is a collection of M1 artifacts that describes a particular Product . Except for PostBuild variation points, The Product Model conforms to the Pure Metamodel as defined in the chapter on variant handling in the Generic Structure Template [1].","meta":{"trigger_kind":"multi_release_ingest","source_pdf":"AUTOSAR_TPS_FeatureModelExchangeFormat.pdf"},"recorded_at":"2026-10-01T10:12:12+00:00","cleaning":{"rule":"spec-text-clean@1","raw_sha256":"e40c7188c93e6b84b70f66471c55215f38f4a7052f833ca10bb0bbd2cc98c9ca","removed":[],"replaced":["U+0093→“","U+0094→”"]},"text_key":"b7fc7c7b5fd3"}],"lifecycle":{"canonical_id":"AUTOSAR/CP/record/TPS_FMDT_00005","is_dropped":false,"first_active_release":"R19-11","last_active_release":"R19-11","dropped_in":[],"first_dropped_release":null,"absent_before":[],"platform_releases":["R18-10","R19-11","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"],"latest_platform_release":"R25-11","text_releases":["R19-11"],"presence_only":[],"unchecked":["R18-10","R20-11","R21-11","R22-11","R23-11","R24-11","R25-11"]},"element":{"kind":"requirement","name":"","module":"FMDT","cluster":"","page":"","doc_type":"TPS","ai":false,"first":"R19-11","last":"R19-11","changed":[],"distinct":1,"universe":"CP"},"evidence":{"figures":[{"id":"FIG-28aea4b6b154e1d6","doc":"AUTOSAR_FO_TPS_FeatureModelExchangeFormat","p":16,"rel":[],"role":"constitutive","conf":0.95,"rt":"","m":"gemini-3.8-flash","why":"Definition of Product Model","n":11,"cap":"Figure 2.1: Overview of Feature Model Te