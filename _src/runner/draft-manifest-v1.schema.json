{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "draft-manifest@v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agent", "request_id", "created_at", "request"],
  "properties": {
    "schema": {"const": "draft-manifest@v1"},
    "agent": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "request_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "request": {
      "$comment": "Must independently validate against issues/_schema/runner-request-v1.schema.json; that frozen schema is not duplicated here.",
      "type": "object"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
