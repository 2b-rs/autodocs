{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-registry@v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "registry_version", "actions"],
  "properties": {
    "schema": {"const": "action-registry@v1"},
    "registry_version": {"type": "integer", "minimum": 1},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "envelope_action", "args", "authority"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*@v[0-9]+$"},
          "category": {"type": "string", "minLength": 1},
          "envelope_action": {"enum": ["read_only_discovery", "focused_validation", "generation", "external_service_configuration", "signing_verification", "path_limited_commit", "bookkeeping_commit"]},
          "args": {
            "type": "object",
            "required": ["required"],
            "properties": {
              "required": {"type": "array", "items": {"type": "string"}},
              "optional": {"type": "array", "items": {"type": "string"}}
            }
          },
          "authority": {
            "type": "object",
            "required": ["capability_class", "network", "credentials", "mutates"],
            "properties": {
              "capability_class": {"enum": ["any", "privileged"]},
              "network": {"type": "boolean"},
              "credentials": {"type": "boolean"},
              "mutates": {"type": "boolean"}
            }
          }
        }
      }
    },
    "preflight_checks": {"type": "array"},
    "forbidden": {"type": "array"}
  }
}
