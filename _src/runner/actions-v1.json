      "category": "validation",
      "manifest_primitive": "validation.handoff-manifest",
      "envelope_action": "focused_validation",
      "description": "Run _src/tools/legacy_handoff_manifest.py --check.",
      "args": {"required": [], "optional": []},
      "authority": {"capability_class": "any", "network": false, "credentials": false, "mutates": false}
    },
    {
      "id": "validate.run-profile@v1",
      "category": "validation",
      "manifest_primitive": "validation.task-validation",
      "envelope_action": "focused_validation",
      "description": "Run a declared task-validation-profile@v1 fixture/test profile.",
      "args": {"required": ["profile_path"], "optional": []},
      "authority": {"capability_class": "any", "network": false, "credentials": false, "mutates": false}
    },
    {
      "id": "validate.transaction-fixtures@v1",
      "category": "validation",
      "manifest_primitive": "validation.transaction-fixtures",
      "envelope_action": "focused_validation",
      "description": "Run docs/pipeline/fixtures/0038-19/validate_branch_merge_action_fixtures.py.",
      "args": {"required": [], "optional": []},
      "authority": {"capability_class": "any", "network": false, "credentials": false, "mutates": false}
    },
    {
      "id": "validate.workflow-lifecycle@v1",
      "category": "validation",
      "manifest_primitive": "validation.workflow-validator",
      "envelope_action": "focused_validation",
      "description": "Run the legacy agent-workflow.json lifecycle validator.",
      "args": {"required": [], "optional": []},
      "authority": {"capability_class": "any", "network": false, "credentials": false, "mutates": false}
    }
  ],
  "preflight_checks": [
    {"id": "scope.authority-boundary@v1", "manifest_primitive": "scope.forbidden-branch-writes", "description": "Reject any request whose write_scopes include a governance artifact path or refs/heads/main unless capability_class is privileged and the action is git.integrate-checkpoint@v1 with target_kind main."},
    {"id": "scope.preflight@v1", "manifest_primitive": "scope.planner.collision-preflight", "description": "Reject a request whose write_scopes intersect any other currently claimed (unresolved) request's write_scopes."},
    {"id": "scope.policy-provenance@v1", "manifest_primitive": "scope.policy-provenance", "description": "For a governance-artifact write, require first-parent-chain provenance evidence (see check_policy_provenance.py); reject an absorbed fast-forward per DEC-0044-007."},
    {"id": "scope.isolated-attempt-root@v1", "manifest_primitive": "scope.run-attempt-roots", "description": "Require every mutating action to execute inside a fresh isolated temporary root, never the shared root checkout."},
    {"id": "scope.claim-declaration@v1", "manifest_primitive": "scope.write-scope-declaration", "description": "Require read_scopes/write_scopes to be a declared, non-empty, non-wildcard, non-directory, non-pathspec-magic exact path list."}
  ],
  "forbidden": [
    {"pattern": "shell.*", "reason": "Generic/arbitrary shell execution is explicitly forbidden by Task 0037-46.01's acceptance criteria."},
    {"pattern": "exec.*", "reason": "No action may accept a free-form command line, executable path, or argv passthrough."}
  ]
}
