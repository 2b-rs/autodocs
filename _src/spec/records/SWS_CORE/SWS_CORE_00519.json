    },
    {
      "t": "html",
      "html": "<div class=\"desc\"><p>Throw this error as exception.</p><p>This function will determine the appropriate exception type for this ErrorCode and throw it. The thrown exception will contain this ErrorCode.</p></div>",
      "tail": "\n"
