   "html": "<h3 class=\"recname\"><span class=\"kind\">enumeration</span> FutureStatus <span class=\"sws\"><a href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_SWS_Core.pdf#nameddest=SWS_CORE_00361\" title=\"Spezifikations-PDF (AUTOSAR_AP_SWS_Core.pdf)\">[SWS_CORE_00361]</a></span> <span class=\"ups\">Upstream: <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_General.pdf#nameddest=RS_AP_00130\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_General.pdf)\">RS_AP_00130</a></span></h3>",
