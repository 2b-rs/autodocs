   "html": "<h3 class=\"recname\"><span class=\"kind\">function</span> ThrowAsException <span class=\"sws\"><a href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_SWS_Diagnostics.pdf#nameddest=SWS_DM_00535\" title=\"Spezifikations-PDF (AUTOSAR_AP_SWS_Diagnostics.pdf)\">[SWS_DM_00535]</a></span> <span class=\"ups\">Upstream: <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_General.pdf#nameddest=RS_AP_00119\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_General.pdf)\">RS_AP_00119</a></span></h3>",
