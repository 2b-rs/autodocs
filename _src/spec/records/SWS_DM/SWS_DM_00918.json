   "t": "html",
   "html": "<pre class=\"syntax\"><a class=\"vis-app\" href=\"cl_ara_core_Result_d51722.html\">ara::core::Result</a>&lt; void &gt; SetEventMemoryOverflowNotifier (EventMemory OverflowSetNotifier notifier) noexcept;</pre>",
