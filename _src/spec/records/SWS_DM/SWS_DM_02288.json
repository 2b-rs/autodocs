   "t": "html",
   "html": "<pre class=\"syntax\">auto Add (<a class=\"vis-app\" href=\"cl_ara_core_StringView_cfeb8f.html\">ara::core::StringView</a> key, <a class=\"cppref\" href=\"https://en.cppreference.com/w/cpp/types/integer\" title=\"cppreference.com (C++17)\">std::int64_t</a> content_element) noexcept -&gt; <a class=\"vis-app\" href=\"cl_ara_core_Result_d51722.html\">ara::core::Result</a>&lt; void &gt;;</pre>",
   "tail": "\n"
