  {
   "t": "html",
   "html": "<pre class=\"syntax\">virtual auto Read (<a class=\"vis-app\" href=\"cl_ara_core_Span_f16d72.html\">ara::core::Span</a>&lt; const <a class=\"vis-app\" href=\"../namespaces/ns_core_ara_core_e30e31.html#SWS_CORE_04200\">ara::core::Byte</a> &gt; response_ data, <a class=\"vis-app\" href=\"cl_ara_diag_MetaInfo_818707.html\">MetaInfo</a> const &amp;meta_info, <a class=\"vis-app\" href=\"cl_ara_diag_CancellationHandler_e2b2ab.html\">CancellationHandler</a> cancellation_ handler) noexcept -&gt; <a class=\"vis-app\" href=\"cl_ara_core_Future_420ba8.html\">ara::core::Future</a>&lt; <a class=\"cppref\" href=\"https://en.cppreference.com/w/cpp/types/integer\" title=\"cppreference.com (C++17)\">std::uint32_t</a> &gt;=0;</pre>",
   "tail": "\n"
