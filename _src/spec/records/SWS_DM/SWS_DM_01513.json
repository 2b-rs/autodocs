   "html": "<h3 class=\"recname\"><span class=\"kind\">function</span> Read <span class=\"sws\"><a href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_SWS_Diagnostics.pdf#nameddest=SWS_DM_01513\" title=\"Spezifikations-PDF (AUTOSAR_AP_SWS_Diagnostics.pdf)\">[SWS_DM_01513]</a></span> <span class=\"ups\">Upstream: <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/FO/AUTOSAR_FO_RS_Diagnostics.pdf#nameddest=RS_Diag_04135\" title=\"Spezifikations-PDF (AUTOSAR_FO_RS_Diagnostics.pdf)\">RS_Diag_04135</a></span></h3>",
