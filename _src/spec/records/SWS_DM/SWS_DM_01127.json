   "html": "<h3 class=\"recname\"><span class=\"kind\">function</span> VerifyCertificateBidirectional <span class=\"sws\"><a href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_SWS_Diagnostics.pdf#nameddest=SWS_DM_01127\" title=\"Spezifikations-PDF (AUTOSAR_AP_SWS_Diagnostics.pdf)\">[SWS_DM_01127]</a></span> <span class=\"ups\">Upstream: <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/FO/AUTOSAR_FO_RS_Diagnostics.pdf#nameddest=RS_Diag_04251\" title=\"Spezifikations-PDF (AUTOSAR_FO_RS_Diagnostics.pdf)\">RS_Diag_04251</a>, <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_General.pdf#nameddest=RS_AP_00128\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_General.pdf)\">RS_AP_00128</a></span></h3>",
