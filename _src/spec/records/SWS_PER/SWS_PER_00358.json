    {
      "t": "html",
      "html": "<pre class=\"syntax\"><a class=\"vis-app\" href=\"../classes/cl_ara_core_Result_d51722.html\">ara::core::Result</a>&lt; void &gt; ResetPersistency () noexcept;</pre>",
      "tail": "\n"
    },
    {
      "t": "html",
      "html": "<div class=\"desc\"><p>Resets all Key-Value Storages and File Storages by entirely removing their content. The Key-Value Storages and File Storages will be re-created when <a class=\"vis-app\" href=\"ns_per_ara_per_d9a3e9.html\">ara::per</a>:: OpenFileStorage or <a class=\"vis-app\" href=\"ns_per_ara_per_d9a3e9.html#SWS_PER_00052\">ara::per::OpenKeyValueStorage</a> is called next time.</p></div>",
      "tail": "\n"
    },
