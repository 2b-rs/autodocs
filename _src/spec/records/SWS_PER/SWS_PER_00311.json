   "html": "<pre class=\"syntax\">enum class PerErrc :            <a class=\"vis-app\" href=\"../classes/cl_ara_core_ErrorDomain_a538fe.html#SWS_CORE_00122\">ara::core::ErrorDomain::CodeType</a> {...};</pre>",
