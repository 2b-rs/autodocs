   "t": "html",
   "html": "<div class=\"desc\"><p>Returns the space in bytes currently occupied by the content of a file of this File Storage. The returned size might be inaccurate if any of the instances of a file is invalid or if another operation on the file takes place at the same time.</p></div>",
   "tail": "\n"
