  {
   "t": "html",
   "html": "<pre class=\"syntax\"><a class=\"vis-app\" href=\"cl_ara_core_Result_d51722.html\">ara::core::Result</a>&lt; <a class=\"vis-app\" href=\"cl_ara_per_UniqueHandle_94e9f0.html\">UniqueHandle</a>&lt; <a class=\"vis-app\" href=\"cl_ara_per_ReadWriteAccessor_30aeb5.html\">ReadWriteAccessor</a> &gt; &gt; OpenFileRead Write (<a class=\"vis-app\" href=\"cl_ara_core_StringView_cfeb8f.html\">ara::core::StringView</a> fileName) noexcept;</pre>",
   "tail": "\n"
