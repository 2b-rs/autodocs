    {
      "t": "html",
      "html": "<pre class=\"syntax\"><a class=\"vis-app\" href=\"../classes/cl_ara_core_Result_d51722.html\">ara::core::Result</a>&lt; void &gt; UpdatePersistency () noexcept;</pre>",
      "tail": "\n"
    },
    {
      "t": "html",
      "html": "<div class=\"desc\"><p>Updates all Persistency Key-Value Storages and File Storages after a new Target Configuration was installed. This method can be used to update the persistent data of the Adaptive Application during verification phase.</p></div>",
      "tail": "\n"
