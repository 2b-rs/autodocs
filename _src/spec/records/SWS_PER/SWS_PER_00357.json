                  "class",
                  "mono"
                ]
              ],
              "html": "kOutOfStorageSpace"
            },
            {
              "tag": "td",
              "attrs": [],
              "html": "no_rollback_semantics Returned if the available physical storage space is insufficient for the update."
            }
          ]
        },
        {
          "cells": [
            {
              "tag": "td",
              "attrs": [
                [
                  "class",
                  "mono"
                ]
              ],
              "html": "kTooManyFiles"
