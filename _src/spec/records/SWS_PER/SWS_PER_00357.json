              "html": "kPhysicalStorage-Failure"
            },
            {
              "tag": "td",
              "attrs": [],
              "html": "no_rollback_semantics Returned if access to the physical storage fails during the update operation."
            }
          ]
        },
        {
          "cells": [
            {
              "tag": "td",
              "attrs": [
                [
                  "class",
                  "mono"
                ]
              ],
              "html": "kIntegrityCor-rupted"
            },
            {
              "tag": "td",
              "attrs": [],
              "html": "rollback_semantics Returned if stored data cannot be read because the structural integrity is corrupted."
            }
          ]
        },
        {
          "cells": [
            {
              "tag": "td",
              "attrs": [
                [
                  "class",
                  "mono"
                ]
              ],
              "html": "kValidationFailed"
            },
            {
              "tag": "td",
              "attrs": [],
              "html": "rollback_semantics Returned if the validity of stored data cannot be ensured."
            }
          ]
        },
        {
          "cells": [
            {
              "tag": "td",
              "attrs": [
                [
                  "class",
                  "mono"
                ]
              ],
              "html": "kEncryptionFailed"
            },
            {
              "tag": "td",
              "attrs": [],
              "html": "rollback_semantics Returned if the encryption or decryption of stored data fails during the update operation."
            }
          ]
        },
        {
          "cells": [
            {
              "tag": "td",
              "attrs": [
                [
                  "class",
                  "mono"
                ]
              ],
              "html": "kResourceBusy"
            },
            {
              "tag": "td",
              "attrs": [],
              "html": "rollback_semantics Returned if <a class=\"vis-app\" href=\"ns_per_ara_per_d9a3e9.html#SWS_PER_00567\">ara::per::CleanUpPersistency</a> or <a class=\"vis-app\" href=\"ns_per_ara_per_d9a3e9.html\">ara::per</a>:: ResetPersistency is currently being executed, or if ara:: per::RecoverKeyValueStorage or <a class=\"vis-app\" href=\"ns_per_ara_per_d9a3e9.html\">ara::per</a>:: ResetKeyValueStorage is currently being executed for any Key-Value Storage, or if <a class=\"vis-app\" href=\"ns_per_ara_per_d9a3e9.html#SWS_PER_00335\">ara::per::RecoverAllFiles</a> or <a class=\"vis-app\" href=\"ns_per_ara_per_d9a3e9.html#SWS_PER_00336\">ara::per::ResetAllFiles</a> is currently being executed for any File Storage, or a <a class=\"vis-app\" href=\"../classes/cl_ara_per_SharedHandle_a773d0.html\">ara::per::SharedHandle</a> of a Key- Value Storage or a File Storage is currently in use."
            }
          ]
