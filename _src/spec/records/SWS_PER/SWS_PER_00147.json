       ],
       "html": "kAtTheBeginning"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "= 1 &lt;&lt; 0 Sets the seek position to the beginning of the file when the file is opened. This mode cannot be combined with kAtTheEnd."
      }
     ]
    },
    {
     "cells": [
      {
       "tag": "td",
       "attrs": [
        [
         "class",
         "mono"
        ]
       ],
       "html": "kAtTheEnd"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "= 1 &lt;&lt; 1 Sets the seek position to the end of the file when the file is opened. This mode cannot be combined with kAtTheBeginning or kTruncate."
      }
     ]
    },
    {
     "cells": [
      {
       "tag": "td",
       "attrs": [
        [
         "class",
         "mono"
        ]
       ],
       "html": "kTruncate"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "= 1 &lt;&lt; 2 Removes existing content when the file is opened. This mode cannot be combined with kAtTheEnd."
      }
     ]
    },
    {
     "cells": [
      {
       "tag": "td",
       "attrs": [
        [
         "class",
         "mono"
        ]
       ],
       "html": "kAppend"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "= 1 &lt;&lt; 3 Append to the end. Always seeks to the end of the file before writing."
      }
     ]
    }
