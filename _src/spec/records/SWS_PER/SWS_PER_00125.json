  {
   "t": "html",
   "html": "<pre class=\"syntax\"><a class=\"vis-app\" href=\"cl_ara_per_WriteAccessor_a926f9.html\">WriteAccessor</a> &amp; operator&lt;&lt; (<a class=\"vis-app\" href=\"cl_ara_core_StringView_cfeb8f.html\">ara::core::StringView</a> s) noexcept;</pre>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<div class=\"desc\"><p>Writes the content of a StringView to the file. This operator is just a comfort feature for non-safety critical Persistency users. If an error occurs during this operation, it is silently ignored.</p></div>",
   "tail": "\n\n"
