  {
   "t": "html",
   "html": "<pre class=\"syntax\">explicit operator bool () const noexcept;</pre>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<div class=\"desc\"><p>Handle state. True if the handle represents a valid object of the templated class, False if the handle is empty (e.g. after a move operation). Using other operators than bool() of an empty handle will result in undefined behavior.</p></div>",
   "tail": "\n\n"
