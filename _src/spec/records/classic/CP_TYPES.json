  {
   "t": "html",
   "html": "<h3 class=\"recname\" id=\"SWS_Platform_00041\"><span class=\"kind\">type</span> float32 <span class=\"sws\">[SWS_Platform_00041]</span></h3>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<pre class=\"syntax\">typedef float <a class=\"vis-app\" href=\"#SWS_Platform_00041\">float32</a>;</pre>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<div class=\"desc\"><p>This standard AUTOSAR type shall follow the 32-bit binary interchange format according to IEEE 754-2008 with encoding parameters specified in chapter 3.6, table 3.5, column \"binary32\".</p></div>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<h3 class=\"recname\" id=\"SWS_Platform_00042\"><span class=\"kind\">type</span> float64 <span class=\"sws\">[SWS_Platform_00042]</span></h3>",
