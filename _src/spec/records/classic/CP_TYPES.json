   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<div class=\"desc\"><p>-</p></div>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<h3 class=\"recname\" id=\"SWS_Std_00024\"><span class=\"kind\">type</span> Std_TransformerClass <span class=\"sws\">[SWS_Std_00024]</span></h3>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<pre class=\"syntax\">typedef <a class=\"vis-app\" href=\"platform.html#SWS_Platform_00013\">uint8</a> <a class=\"vis-app\" href=\"#SWS_Std_00024\">Std_TransformerClass</a>;</pre>",
   "tail": "\n"
  },
  {
   "t": "html",
