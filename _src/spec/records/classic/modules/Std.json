  },
  {
   "t": "html",
   "html": "<div class=\"desc\"><p>-</p></div>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<h3 class=\"recname\" id=\"SWS_Std_00024\"><span class=\"kind\">type</span> Std_TransformerClass <span class=\"sws\"><a href=\"../../versions.html?id=SWS_Std_00024\" title=\"Requirement im Versions- &amp; Revisions-Explorer anzeigen\">[SWS_Std_00024]</a></span> <a href=\"https://www.autosar.org/fileadmin/standards/R20-11/CP/AUTOSAR_SWS_StandardTypes.pdf#nameddest=SWS_Std_00024\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"sws-pdf-link\" title=\"Spezifikations-PDF im Original öffnen: AUTOSAR_SWS_StandardTypes.pdf (Anker: #SWS_Std_00024, S. 20)\">📄 PDF</a></h3>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<pre class=\"syntax\">typedef <a class=\"vis-app\" href=\"platform.html#SWS_Platform_00013\">uint8</a> <a class=\"vis-app\" href=\"#SWS_Std_00024\">Std_TransformerClass</a>;</pre>",
   "tail": "\n"
