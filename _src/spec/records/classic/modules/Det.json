   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<pre class=\"syntax\"><a class=\"vis-app\" href=\"std.html#SWS_Std_00005\">Std_ReturnType</a> Det_Report RuntimeError(<a class=\"vis-app\" href=\"platform.html#SWS_Platform_00014\">uint16</a> ModuleId, <a class=\"vis-app\" href=\"platform.html#SWS_Platform_00013\">uint8</a> InstanceId, <a class=\"vis-app\" href=\"platform.html#SWS_Platform_00013\">uint8</a> ApiId, AUTOSAR CP R20 - of Document ID : AUTOSAR_SWS_De faul tErrorTracer <a class=\"vis-app\" href=\"platform.html#SWS_Platform_00013\">uint8</a> ErrorId);</pre>",
