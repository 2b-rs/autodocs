  },
  {
   "t": "html",
   "html": "<h3 class=\"recname\" id=\"SWS_FrTp_00162\"><span class=\"kind\">function</span> FrTp_MainFunction <span class=\"sws\"><a href=\"../../versions.html?id=SWS_FrTp_00162\" title=\"Requirement im Versions- &amp; Revisions-Explorer anzeigen\">[SWS_FrTp_00162]</a></span> <a href=\"https://www.autosar.org/fileadmin/standards/R20-11/CP/AUTOSAR_SWS_FlexRayISOTransportLayer.pdf#nameddest=SWS_FrTp_00162\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"sws-pdf-link\" title=\"Spezifikations-PDF im Original öffnen: AUTOSAR_SWS_FlexRayISOTransportLayer.pdf (Anker: #SWS_FrTp_00162, S. 86)\">📄 PDF</a></h3>",
