  {
   "t": "html",
   "html": "<div class=\"desc\"><p>This is the base type for the configuration of the Flex Ray Transport Protocol A pointer to an instance of this structure will be used in the initialization of the Flex Ray Transport Protocol. The outline of the structure is defined in chapter 10 Configura tion Specification</p></div>",
   "tail": "\n"
  }
 ]
