   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<div class=\"desc\"><p>Sets the channel state to LIN_ CH_ OPERATIONAL without generating a wake up pulse.</p></div>",
   "tail": "\n"
  },
  {
