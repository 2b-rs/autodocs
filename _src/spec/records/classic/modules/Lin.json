   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<div class=\"desc\"><p>Generates a wake up pulse and sets the channel state to LIN_ CH_ OPERATIONAL.</p></div>",
   "tail": "\n"
  },
  {
   "t": "html",
