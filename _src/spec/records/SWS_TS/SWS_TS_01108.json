    {
      "t": "html",
      "html": "<pre class=\"syntax\"><a class=\"vis-app\" href=\"cl_ara_core_Result_d51722.html\">ara::core::Result</a>&lt; void &gt; UpdateTime (<a class=\"vis-app\" href=\"../namespaces/ns_tsync_ara_tsync_6055e5.html#SWS_TS_01251\">ara::tsync::Timestamp</a> timePoint, const <a class=\"vis-app\" href=\"cl_ara_tsync_UserData_a97d99.html\">UserData</a> &amp;userData) noexcept;</pre>",
      "tail": "\n"
