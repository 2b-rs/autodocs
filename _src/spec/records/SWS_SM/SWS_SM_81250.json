   "t": "html",
   "html": "<pre class=\"syntax\">void ThrowAsException (const <a class=\"vis-app\" href=\"cl_ara_core_ErrorCode_538b08.html\">ara::core::ErrorCode</a> &amp;errorCode) const override;</pre>",
   "tail": "\n"
