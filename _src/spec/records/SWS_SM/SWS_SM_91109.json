  {
   "t": "html",
   "html": "<pre class=\"syntax\"><a class=\"vis-priv\" href=\"sv_sm_StateMachineNotification_5aed9a.html#SWS_SM_91109\">CurrentState</a> : StateMachineStateNameType  // Field (Getter, Notifier)</pre>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<div class=\"desc\"><p>This field represents the current state of StateMachine. If StateMachine is currently in transition between two different states, then the value of this field is set to \"InTransition\". Adaptive Applications can use this field for notifications if they are interested in state changes of a particular StateMachine.</p></div>",
   "tail": "\n\n"
