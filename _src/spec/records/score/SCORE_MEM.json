 "blocks": [
  {
   "t": "html",
   "html": "<h3 class=\"recname\"><span class=\"kind\">component</span> Persistence & Memory</h3>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<div class=\"desc\"><p>The S-Core Persistence &amp; Memory component provides resilient non-volatile data storage, POSIX key-value storage databases, block storage interfaces, atomic file update mechanisms, and flash wear-leveling management.</p></div>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<h2>Persistence Architecture &amp; Key Requirements</h2><table class=\"props\"><thead><tr><th>Requirement ID</th><th>Category</th><th>Safety / Security</th><th>Description</th></tr></thead><tbody><tr><td><code>feat_req__mem__key_value_store</code></td><td>Storage Engine</td><td>Safety: QM</td><td>Implements atomic key-value database storage with transaction support and automatic recovery from ungraceful power loss.</td></tr><tr><td><code>feat_req__mem__block_storage</code></td><td>Block I/O</td><td>Safety: QM</td><td>Provides raw sector block access abstraction for mass storage partitions and high-frequency time-series logging.</td></tr><tr><td><code>feat_req__mem__integrity_check</code></td><td>Data Integrity</td><td>ASIL B</td><td>Applies checksums (CRC-32 / SHA-256) to all persisted storage records and reports unrecoverable bit flips to health management.</td></tr></tbody></table><p class=\"note\">Extrahierte Anforderungen im <a href=\"../eclipse-score-v0.6.0-curation-review/de/index.html\">S-Core Curation Review Portal</a>.</p>",
   "tail": "\n\n"
  }
 ]
}