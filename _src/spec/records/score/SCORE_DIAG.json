 "blocks": [
  {
   "t": "html",
   "html": "<h3 class=\"recname\"><span class=\"kind\">component</span> Diagnostic Adapter</h3>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<div class=\"desc\"><p>The S-Core Diagnostic Adapter bridges AUTOSAR Classic and ISO 14229 UDS diagnostic services to Eclipse S-Core services, handling ODX configuration, DTC translation, fault databases, and SOVD telematics.</p></div>",
   "tail": "\n"
  },
  {
   "t": "html",
   "html": "<h2>Diagnostic Architecture &amp; Key Requirements</h2><p class=\"lead\">The following diagnostic requirements have been extracted from release pin v0.6.0:</p><table class=\"props\"><thead><tr><th>Requirement ID</th><th>Category</th><th>Safety / Security</th><th>Description</th></tr></thead><tbody><tr><td><a href=\"../eclipse-score-v0.6.0-curation-review/records/47695c010f92685f62dedebd.html\">feat_req__diagnostics__classic_adapter</a></td><td>Diagnostics</td><td>Safety: QM</td><td>Implements a Classic Diagnostic Adapter translating classic AUTOSAR DEM/DCM requests into unified S-Core events.</td></tr><tr><td><a href=\"../eclipse-score-v0.6.0-curation-review/records/2c7f43c9f643081284b46522.html\">feat_req__diagnostics__classic_adapter_odx</a></td><td>ODX / Config</td><td>Security: YES</td><td>Requires diagnostic command mapping and ECU behavior to be configurable via standard ODX container files.</td></tr><tr><td><a href=\"../eclipse-score-v0.6.0-curation-review/records/5415f9136a84aa96cdd1994f.html\">feat_req__diagnostics__db</a></td><td>Persistence / Faults</td><td>Safety: QM</td><td>Defines the central diagnostic database schema for logging DTC occurrences, freeze frames, and extended records.</td></tr><tr><td><a href=\"../eclipse-score-v0.6.0-curation-review/records/ba8138363e066f862bc17c6f.html\">feat_req__diagnostics__db_persistence</a></td><td>Storage</td><td>Safety: QM</td><td>Guarantees non-volatile persistent storage of fault memories across ECU power cycles.</td></tr></tbody></table><p class=\"note\">Insgesamt 36 extrahierte Diagnose-Anforderungen im <a href=\"../eclipse-score-v0.6.0-curation-review/de/index.html\">S-Core Curation Review Portal</a>.</p>",
   "tail": "\n\n"
  }
 ]
}