   "t": "html",
   "html": "<pre class=\"syntax\">virtual <a class=\"vis-app\" href=\"cl_ara_core_Result_d51722.html\">ara::core::Result</a>&lt; void &gt; ExportContextState (ReadWriteMem Region contextState) const noexcept=0;</pre>",
   "tail": "\n"
