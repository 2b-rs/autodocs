   "html": "<h3 class=\"recname\"><span class=\"kind\">function</span> GetIntermediateDigest <span class=\"sws\"><a href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_SWS_Cryptography.pdf#nameddest=SWS_CRYPT_50059\" title=\"Spezifikations-PDF (AUTOSAR_AP_SWS_Cryptography.pdf)\">[SWS_CRYPT_50059]</a></span> <span class=\"ups\">Upstream: <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_Cryptography.pdf#nameddest=RS_CRYPTO_02205\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_Cryptography.pdf)\">RS_CRYPTO_02205</a></span></h3>",
