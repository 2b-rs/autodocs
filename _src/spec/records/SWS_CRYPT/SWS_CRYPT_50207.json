      "html": "<h3 class=\"recname\"><span class=\"kind\">function</span> Import <span class=\"sws\"><a href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_SWS_Cryptography.pdf#nameddest=SWS_CRYPT_50207\" title=\"Spezifikations-PDF (AUTOSAR_AP_SWS_Cryptography.pdf)\">[SWS_CRYPT_50207]</a></span> <span class=\"ups\">Upstream: <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_Cryptography.pdf#nameddest=RS_CRYPTO_02105\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_Cryptography.pdf)\">RS_CRYPTO_02105</a></span></h3>",
