    {
     "cells": [
      {
       "tag": "td",
       "attrs": [
        [
         "class",
         "mono"
        ]
       ],
       "html": "kValid"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "=0 The certificate path validation succeeded."
      }
     ]
    },
    {
     "cells": [
      {
       "tag": "td",
       "attrs": [
        [
         "class",
         "mono"
        ]
       ],
       "html": "kInvalidSignature"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "=1 The certificate path validation failed because a signature of a certificate in the path could not be verified."
      }
     ]
    },
    {
     "cells": [
      {
       "tag": "td",
       "attrs": [
        [
         "class",
         "mono"
        ]
       ],
       "html": "kNoPathToTrustedCertificate"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "=3 The certificate path validation failed because no path to a trusted certificate could be found."
      }
     ]
    },
    {
     "cells": [
      {
       "tag": "td",
       "attrs": [
        [
         "class",
         "mono"
        ]
       ],
       "html": "kExpired"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "=4 The certificate path validation failed because a certificate is expired according to the notAfter field."
      }
     ]
    },
    {
     "cells": [
      {
       "tag": "td",
       "attrs": [
        [
         "class",
         "mono"
        ]
       ],
       "html": "kFuture"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "=5 The certificate path validation failed because a certificate is not valid yet according to the notBefore field."
      }
     ]
    },
    {
     "cells": [
      {
       "tag": "td",
       "attrs": [
        [
         "class",
         "mono"
        ]
       ],
       "html": "kRevoked"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "=6 The certificate path validation failed because a certificate has been revoked through a previously imported CRL or through an OCSP response (if OCSP is enabled through kOcspResponseComplete Chain or kOcspResponseTargetOnly)"
      }
     ]
    },
    {
     "cells": [
      {
       "tag": "td",
       "attrs": [
        [
         "class",
         "mono"
        ]
       ],
       "html": "kUnknownOcspStatus"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "=7 The certificate path validation failed because a certificate state is ’unknown’ according to an OCSP response (if OCSP is enabled through kOcspResponseCompleteChain or kOcspResponseTarget Only)."
      }
     ]
    },
    {
     "cells": [
      {
       "tag": "td",
       "attrs": [
        [
         "class",
         "mono"
        ]
       ],
       "html": "kUnknownCriticalExtension"
      },
      {
       "tag": "td",
       "attrs": [],
       "html": "=8 The certificate path validation failed because a certificate contains an unknown critical extension that has not been excluded from validation using the kIgnoreUnknownCriticalExtensions flag or the IgnoreCriticalExtension() function"
      }
     ]
    }
   ],
