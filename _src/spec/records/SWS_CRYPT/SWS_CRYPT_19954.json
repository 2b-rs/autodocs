   "html": "<pre class=\"syntax\">[[noreturn]] void ThrowAsException (const <a class=\"vis-app\" href=\"cl_ara_core_ErrorCode_538b08.html\">ara::core::ErrorCode</a> &amp;error Code) const override;</pre>",
