      "html": "<pre class=\"syntax\"><a class=\"vis-app\" href=\"cl_ara_core_Future_420ba8.html\">ara::core::Future</a>&lt; void &gt; GetInitialMachineStateTransitionResult () const noexcept;</pre>",
      "tail": "\n"
