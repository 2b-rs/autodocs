   "html": "<h3 class=\"recname\"><span class=\"kind\">enumeration</span> SMState <span class=\"sws\"><a href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_SWS_CommunicationManagement.pdf#nameddest=SWS_CM_90422\" title=\"Spezifikations-PDF (AUTOSAR_AP_SWS_CommunicationManagement.pdf)\">[SWS_CM_90422]</a></span> <span class=\"ups\">Upstream: <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/FO/AUTOSAR_FO_RS_E2E.pdf#nameddest=RS_E2E_08534\" title=\"Spezifikations-PDF (AUTOSAR_FO_RS_E2E.pdf)\">RS_E2E_08534</a>, <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_General.pdf#nameddest=RS_AP_00114\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_General.pdf)\">RS_AP_00114</a>, <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_General.pdf#nameddest=RS_AP_00115\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_General.pdf)\">RS_AP_00115</a>, <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_General.pdf#nameddest=RS_AP_00119\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_General.pdf)\">RS_AP_00119</a></span></h3>",
   "tail": "\n"
