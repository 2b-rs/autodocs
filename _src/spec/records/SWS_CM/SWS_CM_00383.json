   "html": "<h3 class=\"recname\"><span class=\"kind\">type alias</span> FindServiceHandler <span class=\"sws\"><a href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_SWS_CommunicationManagement.pdf#nameddest=SWS_CM_00383\" title=\"Spezifikations-PDF (AUTOSAR_AP_SWS_CommunicationManagement.pdf)\">[SWS_CM_00383]</a></span> <span class=\"ups\">Upstream: <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_CommunicationManagement.pdf#nameddest=RS_CM_00102\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_CommunicationManagement.pdf)\">RS_CM_00102</a></span></h3>",
