   "t": "html",
   "html": "<p class=\"meta\"><span class=\"sws\"><a href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_SWS_LogAndTrace.pdf#nameddest=SWS_LOG_00207\" title=\"Spezifikations-PDF (AUTOSAR_AP_SWS_LogAndTrace.pdf)\">[SWS_LOG_00207]</a></span> <span class=\"ups\">Upstream: <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/FO/AUTOSAR_FO_RS_LogAndTrace.pdf#nameddest=RS_LT_00046\" title=\"Spezifikations-PDF (AUTOSAR_FO_RS_LogAndTrace.pdf)\">RS_LT_00046</a></span></p>",
