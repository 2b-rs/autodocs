   "html": "<pre class=\"syntax\">class WriteAccessor final :              public virtual <a class=\"vis-app\" href=\"cl_ara_per_FileAccessor_efe7d0.html\">FileAccessor</a> {...};</pre>",
   "tail": "\n"
