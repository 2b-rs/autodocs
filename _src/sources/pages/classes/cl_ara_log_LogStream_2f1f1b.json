     "t": "html",
     "html": "<ul class=\"mlist\"><li><code class=\"sig\">void <a class=\"fn\" href=\"#SWS_LOG_00039\">Flush</a> () noexcept;</code> <span class=\"dim\">Sends out the current log buffer and initiates a new message stream</span></li><li><code class=\"sig\"><a class=\"fn\" href=\"#SWS_LOG_00174\">LogStream</a> (const <a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html\">LogStream</a> &amp;)=delete;</code> <span class=\"dim\">The copy constructor is deleted.</span></li><li><code class=\"sig\"><a class=\"fn\" href=\"#SWS_LOG_00176\">LogStream</a> (<a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html\">LogStream</a> &amp;&amp;) noexcept; DIRECTION NOT <a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html\">LogStream</a> &amp;&amp; -- DEFINED</code> <span class=\"dim\">The move constructor is treated in a way that allows returning an instance from a function</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00129\">WithLocation</a> (core::<a class=\"vis-app\" href=\"cl_ara_core_StringView_cfeb8f.html\">StringView</a> file, int line) noexcept;</code> <span class=\"dim\">Add source file location into the message.</span></li><li><code class=\"sig\">template &lt;typename T&gt; <a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00258\">WithPrivacy</a> (T value) noexcept;</code> <span class=\"dim\">Set the message’s privacy level</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00132\">WithTag</a> (core::<a class=\"vis-app\" href=\"cl_ara_core_StringView_cfeb8f.html\">StringView</a> tag) noexcept;</code> <span class=\"dim\">Add the given single tag to the current message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00041\">operator&lt;&lt;</a> (<a class=\"cppref\" href=\"https://en.cppreference.com/w/cpp/types/integer\" title=\"cppreference.com (C++17)\">std::uint8_t</a> value) noexcept;</code> <span class=\"dim\">Writes unsigned int 8 bit parameter into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00042\">operator&lt;&lt;</a> (<a class=\"cppref\" href=\"https://en.cppreference.com/w/cpp/types/integer\" title=\"cppreference.com (C++17)\">std::uint16_t</a> value) noexcept;</code> <span class=\"dim\">Writes unsigned int 16 bit parameter into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00043\">operator&lt;&lt;</a> (<a class=\"cppref\" href=\"https://en.cppreference.com/w/cpp/types/integer\" title=\"cppreference.com (C++17)\">std::uint32_t</a> value) noexcept;</code> <span class=\"dim\">Writes unsigned int 32 bit parameter into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00044\">operator&lt;&lt;</a> (<a class=\"cppref\" href=\"https://en.cppreference.com/w/cpp/types/integer\" title=\"cppreference.com (C++17)\">std::uint64_t</a> value) noexcept;</code> <span class=\"dim\">Writes unsigned int 64 bit parameter into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00045\">operator&lt;&lt;</a> (<a class=\"cppref\" href=\"https://en.cppreference.com/w/cpp/types/integer\" title=\"cppreference.com (C++17)\">std::int8_t</a> value) noexcept;</code> <span class=\"dim\">Writes signed int 8 bit parameter into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00040\">operator&lt;&lt;</a> (bool value) noexcept;</code> <span class=\"dim\">Appends given value to the internal message buffer.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00048\">operator&lt;&lt;</a> (<a class=\"cppref\" href=\"https://en.cppreference.com/w/cpp/types/integer\" title=\"cppreference.com (C++17)\">std::int64_t</a> value) noexcept;</code> <span class=\"dim\">Writes signed int 64 bit parameter into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00047\">operator&lt;&lt;</a> (<a class=\"cppref\" href=\"https://en.cppreference.com/w/cpp/types/integer\" title=\"cppreference.com (C++17)\">std::int32_t</a> value) noexcept;</code> <span class=\"dim\">Writes signed int 32 bit parameter into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00046\">operator&lt;&lt;</a> (<a class=\"cppref\" href=\"https://en.cppreference.com/w/cpp/types/integer\" title=\"cppreference.com (C++17)\">std::int16_t</a> value) noexcept;</code> <span class=\"dim\">Writes signed int 16 bit parameter into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00049\">operator&lt;&lt;</a> (float value) noexcept;</code> <span class=\"dim\">Writes float 32 bit parameter into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00050\">operator&lt;&lt;</a> (double value) noexcept;</code> <span class=\"dim\">Writes float 64 bit parameter into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00062\">operator&lt;&lt;</a> (const <a class=\"vis-app\" href=\"cl_ara_core_StringView_cfeb8f.html\">ara::core::StringView</a> value) noexcept;</code> <span class=\"dim\">Writes ara::core::StringView into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00051\">operator&lt;&lt;</a> (const char *const value) noexcept;</code> <span class=\"dim\">Writes null terminated UTF8 string into message.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00128\">operator&lt;&lt;</a> (core::<a class=\"vis-app\" href=\"cl_ara_core_Span_f16d72.html\">Span</a>&lt; const core::Byte &gt; data) noexcept;</code> <span class=\"dim\">Write a byte sequence into message</span></li><li><code class=\"sig\">template &lt;typename T&gt; <a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00203\">operator&lt;&lt;</a> (const <a class=\"vis-app\" href=\"cl_ara_log_Argument_2cabba.html\">Argument</a>&lt; T &gt; &amp;arg) noexcept;</code> <span class=\"dim\">Log an argument with attributes</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00175\">operator=</a> (const <a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp;)=delete;</code> <span class=\"dim\">The copy assignment operator is deleted.</span></li><li><code class=\"sig\"><a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp; <a class=\"fn\" href=\"#SWS_LOG_00177\">operator=</a> (<a class=\"vis-app\" href=\"cl_ara_log_LogStream_2f1f1b.html#SWS_LOG_00174\">LogStream</a> &amp;&amp;)=delete;</code> <span class=\"dim\">The move assignment operator is deleted.</span></li><li><code class=\"sig\"><a class=\"fn\" href=\"#SWS_LOG_00262\">~LogStream</a> () noexcept;</code> <span class=\"dim\">Destructor.</span></li></ul>",
