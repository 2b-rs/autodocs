   "t": "html",
   "html": "<p class=\"meta\"><span class=\"sws\"><a href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_SWS_CommunicationManagement.pdf#nameddest=SWS_CM_00302\" title=\"Spezifikations-PDF (AUTOSAR_AP_SWS_CommunicationManagement.pdf)\">[SWS_CM_00302]</a></span> <span class=\"ups\">Upstream: <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_CommunicationManagement.pdf#nameddest=RS_CM_00101\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_CommunicationManagement.pdf)\">RS_CM_00101</a>, <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_CommunicationManagement.pdf#nameddest=RS_CM_00102\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_CommunicationManagement.pdf)\">RS_CM_00102</a>, <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_General.pdf#nameddest=RS_AP_00114\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_General.pdf)\">RS_AP_00114</a>, <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_General.pdf#nameddest=RS_AP_00127\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_General.pdf)\">RS_AP_00127</a></span></p>",
