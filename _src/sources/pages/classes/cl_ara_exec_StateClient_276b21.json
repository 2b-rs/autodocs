   "html": "<p class=\"meta\"><span class=\"sws\"><a href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_SWS_ExecutionManagement.pdf#nameddest=SWS_EM_02275\" title=\"Spezifikations-PDF (AUTOSAR_AP_SWS_ExecutionManagement.pdf)\">[SWS_EM_02275]</a></span> <span class=\"ups\">Upstream: <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_ExecutionManagement.pdf#nameddest=RS_EM_00101\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_ExecutionManagement.pdf)\">RS_EM_00101</a>, <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_General.pdf#nameddest=RS_AP_00154\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_General.pdf)\">RS_AP_00154</a>, <a class=\"swsref\" href=\"https://www.autosar.org/fileadmin/standards/R25-11/AP/AUTOSAR_AP_RS_General.pdf#nameddest=RS_AP_00150\" title=\"Spezifikations-PDF (AUTOSAR_AP_RS_General.pdf)\">RS_AP_00150</a></span></p>",
