  "i" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "no" [shape=box, label="NO_COM /\nBus-Sleep", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="../classes/cl_ara_nm_NetworkHandle_4a11c2.html", tooltip="NO_COM / Bus-Sleep", target="_top", class="vis-internal"]
  "i" -> "no" [penwidth=1.1]
  "repeat" [shape=box, label="Repeat Message", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "no" -> "repeat" [label="kFullCom / Wake-up", fontsize=10, penwidth=1.1]
  "normal" [shape=box, label="Normal Operation", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "repeat" -> "normal" [label="weiter angefordert", fontsize=10, penwidth=1.1]
  "ready" [shape=box, label="Ready Sleep", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "repeat" -> "ready" [label="freigegeben", fontsize=10, penwidth=1.1]
  "normal" -> "ready" [label="freigegeben", fontsize=10, penwidth=1.1]
  "ready" -> "normal" [label="kFullCom", fontsize=10, penwidth=1.1]
  "prepare" [shape=box, label="Prepare Bus-Sleep", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "ready" -> "prepare" [label="NM-Timeout", fontsize=10, penwidth=1.1]
  "prepare" -> "no" [label="Wartezeit abgelaufen", fontsize=10, penwidth=1.1]
