  "findings": [
    {
      "id": "RRB-PROC-001",
      "summary": "The process contract omitted exhaustive eligibility/exclusions and abuse policy and conflicted on routing, rejection, authority, privacy, and retention.",
      "historical_tasks": ["0021-01", "0021-08"],
      "forward_tasks": ["0033-02", "0033-04.01", "0033-07.04"]
    },
    {
      "id": "RRB-SCHEMA-001",
      "summary": "The package validator accepts malformed types, unknown fields, and caller-authored reserved trust/server metadata.",
      "historical_tasks": ["0021-02"],
      "forward_tasks": ["0033-03", "0033-05", "0033-08"]
    },
    {
      "id": "RRB-SCHEMA-002",
      "summary": "A non-string request_id raises an uncaught TypeError instead of returning diagnostics.",
      "historical_tasks": ["0021-02"],
      "forward_tasks": ["0033-05", "0033-08"]
    },
    {
      "id": "RRB-IDENT-001",
      "summary": "Request identity, canonical bytes, duplicate semantics, retry behavior, and stale handling were incomplete or mutually inconsistent.",
      "historical_tasks": ["0021-02", "0021-04", "0021-05"],
      "forward_tasks": ["0033-03", "0033-04", "0033-10", "0033-11"]
    },
    {
      "id": "RRB-INGEST-001",
      "summary": "apply=True can enqueue while authoritative current hash/version values are omitted, so live-target verification is bypassable.",
      "historical_tasks": ["0021-03"],
      "forward_tasks": ["0033-06", "0033-08", "0033-14"]
    },
    {
      "id": "RRB-TRUST-001",
      "summary": "A bare caller-supplied actor string substitutes for a verified transport envelope; no authenticated GitHub adapter binds repository, issue body, or replay identity.",
      "historical_tasks": ["0021-03"],
      "forward_tasks": ["0033-03", "0033-06", "0033-08", "0033-14"]
    },
    {
      "id": "RRB-QUEUE-001",
      "summary": "Ingestion normalizes the request ID as canonical target, origin as curator, status as proposed, and an unsupported review-request item kind, yielding a nonconformant item.",
      "historical_tasks": ["0021-03", "0021-06"],
      "forward_tasks": ["0033-07", "0033-08", "0033-09", "0033-14"]
    },
    {
      "id": "RRB-QUEUE-002",
      "summary": "Queue creation performs a second non-atomic item_kind rewrite and does not provide claimed-state, collision, or concurrent duplicate guarantees.",
      "historical_tasks": ["0021-03", "0021-06"],
      "forward_tasks": ["0033-07", "0033-08"]
    },
    {
      "id": "RRB-UX-001",
      "summary": "The UX contract remained drafted and promised transport, failure, focus, mobile, and state behavior that the implementation and tests did not establish.",
      "historical_tasks": ["0021-04", "0021-05"],
      "forward_tasks": ["0033-04", "0033-10", "0033-11", "0033-12"]
    },
    {
      "id": "RRB-META-001",
      "summary": "A real generated production record emits a bare canonical ID, null version/hash, and empty source URL, so its browser package cannot meet ingestion identity requirements.",
      "historical_tasks": ["0021-05"],
      "forward_tasks": ["0033-09", "0033-10", "0033-13"]
    },
    {
      "id": "RRB-NOJS-001",
      "summary": "The real page exposes only a JavaScript-dependent button and contains no noscript or non-JavaScript intake link.",
      "historical_tasks": ["0021-04", "0021-05"],
      "forward_tasks": ["0033-04", "0033-12", "0033-13"]
    },
    {
      "id": "RRB-BROWSER-001",
      "summary": "Browser coverage is one synthetic 390x844 WebKit export path that pre-seeds identity and inspects server payload rather than downloaded/submitted bytes.",
      "historical_tasks": ["0021-05", "0021-07"],
      "forward_tasks": ["0033-10", "0033-11", "0033-12", "0033-13"]
    },
    {
      "id": "RRB-TRACE-001",
      "summary": "History/report rendering lacks a durable public queue link and transport receipt and uses synthetic terminal-state coverage rather than governed lifecycle evidence.",
      "historical_tasks": ["0021-06"],
      "forward_tasks": ["0033-07", "0033-11", "0033-14"]
    },
    {
      "id": "RRB-AUTH-001",
      "summary": "No authenticated role boundary enforces claim/propose/accept/reject/apply/close, and completed rejected items normalize as applied.",
      "historical_tasks": ["0021-01", "0021-06", "0021-07"],
      "forward_tasks": ["0033-02", "0033-07.01", "0033-08", "0033-14"]
    },
    {
      "id": "RRB-PRIV-001",
      "summary": "Documented actor deletion and retention claims contradict indefinite full-payload storage and omit policy enforcement across reports, logs, and external GitHub data.",
      "historical_tasks": ["0021-02", "0021-08"],
      "forward_tasks": ["0033-02", "0033-03", "0033-07.02", "0033-07.03", "0033-15.01"]
    },
    {
      "id": "RRB-OPS-001",
      "summary": "Operator guidance names a review_request_ingest.py CLI and GitHub-Issue intake that do not exist in the historical implementation.",
      "historical_tasks": ["0021-08"],
      "forward_tasks": ["0033-15.01"]
    },
    {
      "id": "RRB-VALID-001",
      "summary": "Twenty-five green focused tests do not cover production metadata, trusted transport, full lifecycle, no-JS, cross-browser, receipts, or negative side effects.",
      "historical_tasks": ["0021-05", "0021-07"],
      "forward_tasks": ["0033-08", "0033-13", "0033-15", "0033-16"]
    },
    {
      "id": "RRB-REGEN-001",
      "summary": "The 0021-05 commit regenerated 4503 files without a clean all-language review boundary; later green claims cannot isolate feature output from stale generated history.",
      "historical_tasks": ["0021-05", "0021-07"],
      "forward_tasks": ["0033-13", "0033-15", "0033-16"]
    },
    {
      "id": "RRB-PROV-001",
      "summary": "The 0021-06 through 0021-08 local labels resolve to no Git object; mixed unreachable checkpoints provide context but no portable task-specific completion evidence.",
      "historical_tasks": ["0021-06", "0021-07", "0021-08"],
      "forward_tasks": ["0033-15", "0033-15.02", "0033-16", "0033-16.01"]
    },
    {
      "id": "RRB-RELEASE-001",
      "summary": "The ship-as-is/no-blocker release statement conflicts with visible contract, security, production, accessibility, and operability failures and has no authorized evidence.",
      "historical_tasks": ["0021-08"],
