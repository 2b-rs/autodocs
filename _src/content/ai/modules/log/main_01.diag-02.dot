digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Modellierte und nicht modellierte Nachricht", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "s" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "d" [shape=diamond, label="Nachrichtenmodell vorhanden?", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "s" -> "d" [penwidth=1.1]
  "v" [shape=box, label="Nicht modelliert / verbose", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "v" [label="nein", fontsize=10, penwidth=1.1]
  "n" [shape=box, label="Modelliert / non-verbose", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "n" [label="ja", fontsize=10, penwidth=1.1]
  "a" [shape=box, label="alle Argumente übertragen", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "v" -> "a" [penwidth=1.1]
  "b" [shape=box, label="dynamische Werte übertragen", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "n" -> "b" [penwidth=1.1]
  "e" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "a" -> "e" [penwidth=1.1]
  "b" -> "e" [penwidth=1.1]
}
