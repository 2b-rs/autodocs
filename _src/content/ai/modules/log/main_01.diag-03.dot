digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Nachrichten bei nicht verfügbarem Logging", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "start" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "call" [shape=box, label="Log-Aufruf", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "start" -> "call" [penwidth=1.1]
  "ready" [shape=box, label="Framework kann\nverarbeiten?", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "call" -> "ready" [penwidth=1.1]
  "ende" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "sinks" [shape=box, label="konfigurierte\nLog-Senken", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "ready" -> "sinks" [label="ja", fontsize=10, penwidth=1.1]
  "queue" [shape=box, label="Queue\n(logSink.queueSize)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "ready" -> "queue" [label="nein: z. B.\nDaemon nicht verbunden", fontsize=10, penwidth=1.1]
  "sinks" -> "ende" [penwidth=1.1]
  "full" [shape=box, label="Queue-Größe\nüberschritten?", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "queue" -> "full" [penwidth=1.1]
  "deinit" [shape=box, label="Deinitialize():\nalle Queue-Einträge\nan Senken geben", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "queue" -> "deinit" [label="Deinitialize()", fontsize=10, penwidth=1.1]
  "full" -> "queue" [label="nein", fontsize=10, penwidth=1.1]
  "discard" [shape=box, label="älteste Einträge\nverwerfen", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "full" -> "discard" [label="ja", fontsize=10, penwidth=1.1]
  "deinit" -> "sinks" [penwidth=1.1]
  "discard" -> "ende" [penwidth=1.1]
}
