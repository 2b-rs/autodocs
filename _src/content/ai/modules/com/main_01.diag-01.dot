digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Event-Abonnement: Zustände bei Ausfall und Wiederherstellung", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "start" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "notsub" [shape=box, label="kNotSubscribed", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "start" -> "notsub" [penwidth=1.1]
  "pending" [shape=box, label="kSubscriptionPending", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "notsub" -> "pending" [label="Subscribe()", fontsize=10, penwidth=1.1]
  "pending" -> "notsub" [label="Unsubscribe()", fontsize=10, penwidth=1.1]
  "sub" [shape=box, label="kSubscribed", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "pending" -> "sub" [label="Abonnement aktiv", fontsize=10, penwidth=1.1]
  "pending" -> "sub" [label="CM stellt Abonnement\nerneut her", fontsize=10, penwidth=1.1]
  "sub" -> "notsub" [label="Unsubscribe()", fontsize=10, penwidth=1.1]
  "sub" -> "pending" [label="Dienst temporär\nnicht verfügbar", fontsize=10, penwidth=1.1]
}
