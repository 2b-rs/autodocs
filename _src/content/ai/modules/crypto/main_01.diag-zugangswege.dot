  "app" -> "entry" [label="1: modellierten Zugriff laden", fontsize=10, penwidth=1.1]
  "slot" [shape=box, label="KeySlot", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="../classes/cl_ara_crypto_cryp_KeySlot_ded1fc.html", tooltip="KeySlot", target="_top", class="vis-app"]
  "entry" -> "slot" [label="2a: KeySlot über InstanceSpecifier", fontsize=10, penwidth=1.1]
  "cp" [shape=box, label="CryptoProvider", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="../classes/cl_ara_crypto_cryp_CryptoProvider_4d0caf.html", tooltip="CryptoProvider", target="_top", class="vis-app"]
  "entry" -> "cp" [label="2b: Provider für session-/schlüssellose Operationen", fontsize=10, penwidth=1.1]
  "xp" [shape=box, label="X509Provider", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="../classes/cl_ara_crypto_x509_X509Provider_b14d9a.html", tooltip="X509Provider", target="_top", class="vis-app"]
