digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Beispiel: Fehlerpfad eines EncryptorPublicCtx", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "start" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "setkey" [shape=box, label="SetKey(PublicKey)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "start" -> "setkey" [penwidth=1.1]
  "updateerr" [shape=box, label="Result-Fehler:\nkProcessingNotStarted", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "start" -> "updateerr" [label="Update() vor Start()", fontsize=10, penwidth=1.1]
  "startop" [shape=box, label="Start()", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "setkey" -> "startop" [label="erfolgreich", fontsize=10, penwidth=1.1]
  "seterr" [shape=box, label="Result-Fehler:\nkIncompatibleObject\nkUnsupported\nkUsageViolation", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "setkey" -> "seterr" [label="Konfiguration\nabgelehnt", fontsize=10, penwidth=1.1]
  "ende" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "updateerr" -> "ende" [penwidth=1.1]
  "update" [shape=box, label="Update()\n(0..n-mal)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "startop" -> "update" [label="erfolgreich", fontsize=10, penwidth=1.1]
  "starterr" [shape=box, label="Result-Fehler:\nkUninitializedContext\nkBusyResource\nkEmptyKeySlot\nkUsageViolation\nkIncompatibleObject\nkUnsupported", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "startop" -> "starterr" [label="Initialisierung\nabgelehnt", fontsize=10, penwidth=1.1]
  "seterr" -> "ende" [penwidth=1.1]
  "finish" [shape=box, label="Finish()", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "update" -> "finish" [penwidth=1.1]
  "starterr" -> "ende" [penwidth=1.1]
  "finish" -> "ende" [penwidth=1.1]
}
