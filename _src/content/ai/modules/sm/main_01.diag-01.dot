  "sm" [shape=box, label="StateMachine", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="../services/sv_sm_StateMachineService_b68b0b.html", tooltip="StateMachine", target="_top", class="vis-priv"]
  "tin" -> "sm" [label="2: Übergang auslösen", fontsize=10, penwidth=1.1]
  "tout" [shape=box, label="TriggerOut", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "sm" -> "tout" [label="3: Ausgangssignal aktualisieren", fontsize=10, penwidth=1.1]
  "client" [shape=box, label="beobachtende Anwendung", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="../services/sv_sm_StateMachineNotification_5aed9a.html", tooltip="beobachtende Anwendung", target="_top", class="vis-priv"]
  "sm" -> "client" [label="4: CurrentState melden", fontsize=10, penwidth=1.1]
}
