  "ctl" [shape=box, label="SMControlApplication", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "tin" [shape=box, label="TriggerIn", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
