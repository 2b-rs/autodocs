  "ende" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "tabelle" [shape=box, label="ErrorRecoveryTable\nnext State bestimmen", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "zuordnung" -> "tabelle" [penwidth=1.1]
  "ziel" [shape=box, label="Ziel-StateMachine-State\nund ActionList", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="../services/sv_sm_StateMachineService_b68b0b.html", tooltip="Ziel-StateMachine-State\\nund ActionList", target="_top", class="vis-priv"]
  "tabelle" -> "ziel" [label="konfigurierter nextState", fontsize=10, penwidth=1.1]
  "ziel" -> "ende" [penwidth=1.1]
}
