  "start" -> "eingang" [penwidth=1.1]
  "zuordnung" [shape=box, label="SM: ErrorCode\nzuordnen", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="../modules/sm.html", tooltip="SM: ErrorCode\\nzuordnen", target="_top", class="vis-priv"]
