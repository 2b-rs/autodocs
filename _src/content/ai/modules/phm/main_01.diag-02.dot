digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="GlobalSupervisionStatus – verdichtete Worst-of-Sicht", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "i" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "d" [shape=box, label="kDEACTIVATED", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "i" -> "d" [penwidth=1.1]
  "o" [shape=box, label="kOK", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "o" [label="mindestens ein Elementarstatus OK", fontsize=10, penwidth=1.1]
  "o" -> "d" [label="alle deactivated", fontsize=10, penwidth=1.1]
  "f" [shape=box, label="kFAILED", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "o" -> "f" [label="temporärer Alive-Fehler", fontsize=10, penwidth=1.1]
  "e" [shape=box, label="kEXPIRED", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "o" -> "e" [label="abgelaufene Supervision", fontsize=10, penwidth=1.1]
  "f" -> "d" [label="alle deactivated", fontsize=10, penwidth=1.1]
  "f" -> "o" [label="wieder korrekt", fontsize=10, penwidth=1.1]
  "f" -> "e" [label="abgelaufene Supervision", fontsize=10, penwidth=1.1]
  "e" -> "d" [label="alle deactivated", fontsize=10, penwidth=1.1]
  "s" [shape=box, label="kSTOPPED", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "e" -> "s" [label="kritisch + Toleranz abgelaufen", fontsize=10, penwidth=1.1]
  "z" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "s" -> "z" [label="Watchdog-Pfad", fontsize=10, penwidth=1.1]
}
