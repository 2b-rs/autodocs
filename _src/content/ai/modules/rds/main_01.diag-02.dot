digraph G {
  graph [rankdir=TB, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Zustandsmodell einer IP-basierten Stream-Verbindung", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "ini" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "created" [shape=box, label="created", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "ini" -> "created" [penwidth=1.1]
  "connecting" [shape=box, label="connecting", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="../classes/cl_ara_rds_RawDataStreamClient_10481.html#SWS_RDS_10484", tooltip="connecting", target="_top", class="vis-app"]
  "created" -> "connecting" [label="Connect()", fontsize=10, penwidth=1.1]
  "connected" [shape=box, label="connected / transfer", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "connecting" -> "connected" [label="success", fontsize=10, penwidth=1.1]
  "shutdown" [shape=box, label="shutdown", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "connected" -> "shutdown" [label="Shutdown()", fontsize=10, penwidth=1.1]
  "end" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "shutdown" -> "end" [penwidth=1.1]
}
