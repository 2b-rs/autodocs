digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="PackageManagement: vereinfachter Paket- und Updatezustand", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "ini" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "transfer" [shape=box, label="kTransferring", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="../services/sv_ucm_PackageManagement_3e8fec.html#SWS_UCM_00345", tooltip="kTransferring", target="_top", class="vis-priv"]
  "ini" -> "transfer" [label="TransferStart", fontsize=10, penwidth=1.1]
  "transfer" -> "transfer" [label="TransferData", fontsize=10, penwidth=1.1]
  "process" [shape=box, label="kProcessing", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "transfer" -> "process" [label="TransferExit / ProcessSwPackage", fontsize=10, penwidth=1.1]
  "prepare" [shape=box, label="kPreparing", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "process" -> "prepare" [label="verarbeitet", fontsize=10, penwidth=1.1]
  "active" [shape=box, label="kActivating", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "prepare" -> "active" [label="Activate", fontsize=10, penwidth=1.1]
  "verify" [shape=box, label="kVerifying", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "active" -> "verify" [label="aktiviert", fontsize=10, penwidth=1.1]
  "rollback" [shape=box, label="kRollingBack", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="../services/sv_ucm_PackageManagement_3e8fec.html#SWS_UCM_00353", tooltip="kRollingBack", target="_top", class="vis-priv"]
  "verify" -> "rollback" [label="Prüfung fehlgeschlagen", fontsize=10, penwidth=1.1]
  "done" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "verify" -> "done" [label="erfolgreich / Finish", fontsize=10, penwidth=1.1]
  "rollback" -> "done" [label="erfolgreich", fontsize=10, penwidth=1.1]
  "failed" [shape=box, label="kRollingBackFailed", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "rollback" -> "failed" [label="fehlgeschlagen", fontsize=10, penwidth=1.1]
  "failed" -> "rollback" [label="erneut Rollback", fontsize=10, penwidth=1.1]
}
