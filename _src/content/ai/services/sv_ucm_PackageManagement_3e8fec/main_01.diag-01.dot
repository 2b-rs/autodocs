digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Paketannahme bis Aktivierung", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "a" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "ts" [shape=box, label="TransferStart", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_UCM_00345", tooltip="TransferStart", target="_top"]
  "a" -> "ts" [penwidth=1.1]
  "td" [shape=box, label="TransferData (Blöcke)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_UCM_00346", tooltip="TransferData (Blöcke)", target="_top"]
  "ts" -> "td" [penwidth=1.1]
  "td" -> "td" [label="nächster Block", fontsize=10, penwidth=1.1]
  "te" [shape=box, label="TransferExit", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_UCM_00347", tooltip="TransferExit", target="_top"]
  "td" -> "te" [penwidth=1.1]
  "pr" [shape=box, label="ProcessSwPackage", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_UCM_00349", tooltip="ProcessSwPackage", target="_top"]
  "te" -> "pr" [penwidth=1.1]
  "ac" [shape=box, label="Activate", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_UCM_00352", tooltip="Activate", target="_top"]
  "pr" -> "ac" [penwidth=1.1]
  "rb" [shape=box, label="Rollback", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_UCM_00353", tooltip="Rollback", target="_top"]
  "ac" -> "rb" [label="Wiederherstellung erforderlich", fontsize=10, penwidth=1.1]
  "z" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "ac" -> "z" [label="verifiziert", fontsize=10, penwidth=1.1]
  "rb" -> "z" [penwidth=1.1]
}
