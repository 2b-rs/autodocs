digraph G {
  graph [rankdir=TB, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="UpdateRequest als kontrollierte Zustandsfolge", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "a" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "sess" [shape=box, label="Session anfordern", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_SM_91102", tooltip="Session anfordern", target="_top"]
  "a" -> "sess" [penwidth=1.1]
  "ok" [shape=diamond, label="zugelassen?", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "sess" -> "ok" [penwidth=1.1]
  "prep" [shape=box, label="PrepareUpdate", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_SM_91103", tooltip="PrepareUpdate", target="_top"]
  "ok" -> "prep" [label="ja", fontsize=10, penwidth=1.1]
  "no" [shape=box, label="kein Update", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "ok" -> "no" [label="nein", fontsize=10, penwidth=1.1]
  "verify" [shape=box, label="VerifyUpdate", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_SM_91104", tooltip="VerifyUpdate", target="_top"]
  "prep" -> "verify" [penwidth=1.1]
  "end" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "no" -> "end" [penwidth=1.1]
  "stop" [shape=box, label="Session beenden", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_SM_91101", tooltip="Session beenden", target="_top"]
  "verify" -> "stop" [penwidth=1.1]
  "stop" -> "end" [penwidth=1.1]
}
