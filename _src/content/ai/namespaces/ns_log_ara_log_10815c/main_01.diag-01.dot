digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="ara::log: Kontext registrieren und Nachricht erzeugen", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "s" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "c" [shape=box, label="CreateLogger(context)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "s" -> "c" [penwidth=1.1]
  "l" [shape=box, label="Logger", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "c" -> "l" [penwidth=1.1]
  "d" [shape=diamond, label="modellierte Nachricht?", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "l" -> "d" [penwidth=1.1]
  "m" [shape=box, label="Log(message id, args)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "m" [label="ja", fontsize=10, penwidth=1.1]
  "v" [shape=box, label="WithLevel(level) + LogStream", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "v" [label="nein", fontsize=10, penwidth=1.1]
  "e" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "m" -> "e" [penwidth=1.1]
  "v" -> "e" [penwidth=1.1]
}
