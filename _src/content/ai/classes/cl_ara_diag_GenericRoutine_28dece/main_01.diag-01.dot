digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "s" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "v" [shape=box, label="DM: Routine / Berechtigung / Subfunktion prüfen", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "s" -> "v" [penwidth=1.1]
  "d" [shape=diamond, label="Subfunktion?", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "v" -> "d" [penwidth=1.1]
  "a" [shape=box, label="Start(routineId, data)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_DM_00554", tooltip="Start(routineId, data)", target="_top"]
  "d" -> "a" [label="start 0x01", fontsize=10, penwidth=1.1]
  "b" [shape=box, label="Stop(routineId, data)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_DM_00555", tooltip="Stop(routineId, data)", target="_top"]
  "d" -> "b" [label="stop 0x02", fontsize=10, penwidth=1.1]
  "c" [shape=box, label="RequestResults(routineId, data)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="#SWS_DM_00556", tooltip="RequestResults(routineId, data)", target="_top"]
  "d" -> "c" [label="results 0x03", fontsize=10, penwidth=1.1]
  "n" [shape=box, label="NRC 0x12 / 0x33", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "n" [label="nicht unterstützt / nicht erlaubt", fontsize=10, penwidth=1.1]
  "f" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "a" -> "f" [penwidth=1.1]
  "b" -> "f" [penwidth=1.1]
  "c" -> "f" [penwidth=1.1]
  "n" -> "f" [penwidth=1.1]
}
