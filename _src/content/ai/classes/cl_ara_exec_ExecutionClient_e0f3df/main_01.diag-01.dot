digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Von Execution Management nachverfolgter Prozess-Lifecycle", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "i" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "idle" [shape=box, label="Idle", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "i" -> "idle" [penwidth=1.1]
  "starting" [shape=box, label="Starting", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "idle" -> "starting" [label="Prozess erzeugt / Ressourcen zugeteilt", fontsize=10, penwidth=1.1]
  "running" [shape=box, label="Running", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "starting" -> "running" [label="Reporting: kRunning; nicht meldend: implizit", fontsize=10, penwidth=1.1]
  "term" [shape=box, label="Terminating", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "running" -> "term" [label="SIGTERM durch EM", fontsize=10, penwidth=1.1]
  "done" [shape=box, label="Terminated", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "term" -> "done" [label="Prozessende / Ressourcen frei", fontsize=10, penwidth=1.1]
  "f" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "done" -> "f" [penwidth=1.1]
}
