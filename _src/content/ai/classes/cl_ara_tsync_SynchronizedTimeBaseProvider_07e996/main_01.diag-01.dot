digraph G {
  graph [rankdir=TB, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Provider: Zeit setzen und Rate korrigieren", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "s" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "i" [shape=box, label="SetTime / UpdateTime", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "s" -> "i" [penwidth=1.1]
  "d" [shape=diamond, label="Ratekorrektur zulässig und im Bereich?", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "i" -> "d" [penwidth=1.1]
  "r" [shape=box, label="SetRateCorrection", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "r" [label="ja", fontsize=10, penwidth=1.1]
  "u" [shape=box, label="Time Base aktualisieren", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "u" [label="nein / nicht angefordert", fontsize=10, penwidth=1.1]
  "r" -> "u" [penwidth=1.1]
  "e" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "u" -> "e" [penwidth=1.1]
}
