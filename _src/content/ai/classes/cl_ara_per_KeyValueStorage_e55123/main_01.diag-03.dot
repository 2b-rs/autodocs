digraph G {
  graph [rankdir=TB, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Fehlerausgänge bei Lesen und Persistieren", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "start" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "get" [shape=box, label="GetValue(key)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "start" -> "get" [penwidth=1.1]
  "key" [shape=box, label="Key / Typ /\nIntegrität gültig?", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "get" -> "key" [penwidth=1.1]
  "ende" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "readerr" [shape=box, label="Result-Fehler:\nkKeyNotFound, kDataTypeMismatch,\nkIntegrityCorrupted, kValidationFailed", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "key" -> "readerr" [label="nein", fontsize=10, penwidth=1.1]
  "set" [shape=box, label="SetValue(...)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "key" -> "set" [label="ja", fontsize=10, penwidth=1.1]
  "readerr" -> "ende" [penwidth=1.1]
  "sync" [shape=box, label="SyncToStorage()", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "set" -> "sync" [penwidth=1.1]
  "write" [shape=box, label="Schreiben und\nKapazität möglich?", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "sync" -> "write" [penwidth=1.1]
  "writeerr" [shape=box, label="Result-Fehler:\nkIllegalWriteAccess, kQuotaExceeded,\nkOutOfStorageSpace", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "write" -> "writeerr" [label="nein", fontsize=10, penwidth=1.1]
  "ok" [shape=box, label="Wert lesen / Änderungen\npersistieren", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "write" -> "ok" [label="ja", fontsize=10, penwidth=1.1]
  "writeerr" -> "ende" [penwidth=1.1]
  "ok" -> "ende" [penwidth=1.1]
}
