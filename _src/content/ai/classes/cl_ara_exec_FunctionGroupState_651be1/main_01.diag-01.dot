digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Beispiel eines Function-Group-Zustandswechsels", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "i" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "off" [shape=box, label="Off", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "i" -> "off" [label="initial", fontsize=10, penwidth=1.1]
  "active" [shape=box, label="projektspezifischer aktiver Zustand", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "off" -> "active" [label="StateClient::SetState", fontsize=10, penwidth=1.1]
  "f" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "off" -> "f" [penwidth=1.1]
  "active" -> "off" [label="neuer Request / Abschalten", fontsize=10, penwidth=1.1]
}
