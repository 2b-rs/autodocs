digraph G {
  graph [rankdir=TB, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Recovery-Entscheidung bei einer abgelaufenen Global Supervision", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "a" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "b" [shape=box, label="GlobalSupervisionStatus kEXPIRED", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "a" -> "b" [penwidth=1.1]
  "c" [shape=box, label="RecoveryHandler benachrichtigen", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "b" -> "c" [penwidth=1.1]
  "d" [shape=diamond, label="Antwort innerhalb Timeout?", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "c" -> "d" [penwidth=1.1]
  "e" [shape=box, label="State Management koordiniert Recovery", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "e" [label="ja", fontsize=10, penwidth=1.1]
  "f" [shape=box, label="AliveNotification stoppen und Watchdog-Reaktion auslösen", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "f" [label="nein / nicht behandelbar", fontsize=10, penwidth=1.1]
  "g" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "e" -> "g" [penwidth=1.1]
  "f" -> "g" [penwidth=1.1]
}
