digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Logger: Filter vor aufwendiger Nutzlast", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "s" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "q" [shape=box, label="IsEnabled(level)", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "s" -> "q" [penwidth=1.1]
  "d" [shape=diamond, label="Schwellwert erfüllt?", fillcolor="#ffffff", style="filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "q" -> "d" [penwidth=1.1]
  "p" [shape=box, label="Nutzlast aufbauen und LogStream verwenden", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "p" [label="ja", fontsize=10, penwidth=1.1]
  "x" [shape=box, label="teure Vorbereitung überspringen", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "d" -> "x" [label="nein", fontsize=10, penwidth=1.1]
  "e" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "p" -> "e" [penwidth=1.1]
  "x" -> "e" [penwidth=1.1]
}
