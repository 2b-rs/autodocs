digraph G {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica,sans-Serif", label="Lebenszyklus eines Streaming-Kontexts", labelloc=t, fontsize=13, fontcolor="#28251d"]
  node [fontname="Helvetica,sans-Serif", fontsize=12, color="#01696f", fontcolor="#28251d"]
  edge [fontname="Helvetica,sans-Serif", fontsize=11, color="#28251d", fontcolor="#28251d", penwidth=1.1]

  "i" [shape=point, fillcolor="#28251d", style="filled", color="#28251d", penwidth=1.2, width=0.16]
  "key" [shape=box, label="Schlüssel konfiguriert", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "i" -> "key" [label="SetKey", fontsize=10, penwidth=1.1]
  "active" [shape=box, label="Streaming aktiv", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "key" -> "active" [label="Start", fontsize=10, penwidth=1.1]
  "active" -> "active" [label="Update", fontsize=10, penwidth=1.1]
  "done" [shape=box, label="Beendet / zurückgesetzt", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2]
  "active" -> "done" [label="Finish oder Cancel", fontsize=10, penwidth=1.1]
  "done" -> "key" [label="erneut konfigurieren", fontsize=10, penwidth=1.1]
  "f" [shape=doublecircle, label="", fillcolor="#28251d", style="filled", color="#28251d", width=0.13]
  "done" -> "f" [label="freigeben", fontsize=10, penwidth=1.1]
}
