  "execute" [shape=box, label="Operation ausführen", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="cl_ara_diag_GenericDiagnosticSovdOperation_fbec16.html", tooltip="Operation ausführen", target="_top", class="vis-app"]
