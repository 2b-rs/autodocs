  "challenge" [shape=box, label="SovdProximityChallenge\nführt Challenge-Verfahren aus", fillcolor="#ffffff", style="rounded,filled", color="#01696f", fontcolor="#01696f", fontsize=11, penwidth=1.2, URL="cl_ara_diag_SovdProximityChallenge_2669f4.html", tooltip="SovdProximityChallenge führt Challenge-Verfahren aus", target="_top", class="vis-app"]
